<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================ -->
    <!-- 피플카 ERP 스타일 컴포넌트                     -->
    <!-- 둥근 모서리, Drop Shadow, 깔끔한 카드 레이아웃 -->
    <!-- ============================================ -->

    <!-- ============================================ -->
    <!-- Badge Styles (for Border elements)           -->
    <!-- 피플카 스타일: 둥근 필 형태, 톤 조정           -->
    <!-- ============================================ -->

    <!-- Base Badge -->
    <Style x:Key="Tran.Badge" TargetType="Border">
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="12,4"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="Tran.Badge.Draft" TargetType="Border" BasedOn="{StaticResource Tran.Badge}">
        <Setter Property="Background" Value="{StaticResource Tran.State.Draft.Bg}"/>
    </Style>

    <Style x:Key="Tran.Badge.Sent" TargetType="Border" BasedOn="{StaticResource Tran.Badge}">
        <Setter Property="Background" Value="{StaticResource Tran.State.Sent.Bg}"/>
    </Style>

    <Style x:Key="Tran.Badge.Confirmed" TargetType="Border" BasedOn="{StaticResource Tran.Badge}">
        <Setter Property="Background" Value="{StaticResource Tran.State.Confirmed.Bg}"/>
    </Style>

    <Style x:Key="Tran.Badge.RevisionRequested" TargetType="Border" BasedOn="{StaticResource Tran.Badge}">
        <Setter Property="Background" Value="{StaticResource Tran.State.RevisionRequested.Bg}"/>
    </Style>

    <Style x:Key="Tran.Badge.Cancelled" TargetType="Border" BasedOn="{StaticResource Tran.Badge}">
        <Setter Property="Background" Value="{StaticResource Tran.State.Cancelled.Bg}"/>
    </Style>

    <Style x:Key="Tran.Badge.Active" TargetType="Border" BasedOn="{StaticResource Tran.Badge}">
        <Setter Property="Background" Value="{StaticResource Tran.Badge.Active.Bg}"/>
    </Style>

    <Style x:Key="Tran.Badge.Inactive" TargetType="Border" BasedOn="{StaticResource Tran.Badge}">
        <Setter Property="Background" Value="{StaticResource Tran.Badge.Inactive.Bg}"/>
    </Style>

    <!-- ============================================ -->
    <!-- Card Style                                   -->
    <!-- 피플카 스타일: 둥근 모서리 + Drop Shadow       -->
    <!-- ============================================ -->
    <Style x:Key="Tran.Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Tran.Surface.Card}"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="BorderBrush" Value="{StaticResource Tran.Border.Light}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="16" ShadowDepth="2"
                                  Color="{StaticResource Tran.Shadow.Color}" Opacity="0.06" Direction="270"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Dashboard Summary Card (대시보드 요약 카드) -->
    <Style x:Key="Tran.DashboardCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Tran.Surface.Card}"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="24,20"/>
        <Setter Property="BorderBrush" Value="{StaticResource Tran.Border.Light}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2"
                                  Color="{StaticResource Tran.Shadow.Color}" Opacity="0.05" Direction="270"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================ -->
    <!-- Chip Style (pill shape)                      -->
    <!-- 피플카 스타일: 거래처 탭 칩                    -->
    <!-- ============================================ -->
    <Style x:Key="Tran.Chip" TargetType="Border">
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="Padding" Value="14,6"/>
        <Setter Property="Background" Value="{StaticResource Tran.Neutral.100}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Tran.Border.Light}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- Active Chip (선택된 거래처 탭) -->
    <Style x:Key="Tran.Chip.Active" TargetType="Border">
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="Padding" Value="14,6"/>
        <Setter Property="Background" Value="{StaticResource Tran.Accent.Blue.Light}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Tran.Accent.Blue}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- ============================================ -->
    <!-- Section Header                               -->
    <!-- ============================================ -->
    <Style x:Key="Tran.SectionHeader" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Tran.Neutral.50}"/>
        <Setter Property="Padding" Value="20,14"/>
        <Setter Property="CornerRadius" Value="8,8,0,0"/>
        <Setter Property="BorderBrush" Value="{StaticResource Tran.Border.Light}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>

    <!-- ============================================ -->
    <!-- Summary Card (for inventory/dashboard)       -->
    <!-- ============================================ -->
    <Style x:Key="Tran.SummaryCard" TargetType="Border">
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource Tran.Border.Light}"/>
        <Setter Property="Background" Value="{StaticResource Tran.Surface.Card}"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="8" ShadowDepth="1"
                                  Color="{StaticResource Tran.Shadow.Color}" Opacity="0.04" Direction="270"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================ -->
    <!-- Accent Bar (3px top border for tabs)         -->
    <!-- ============================================ -->
    <Style x:Key="Tran.AccentBar" TargetType="Border">
        <Setter Property="Height" Value="3"/>
        <Setter Property="CornerRadius" Value="2"/>
    </Style>

    <!-- ============================================ -->
    <!-- Search Box Container                         -->
    <!-- 피플카 스타일: 둥근 모서리, 연한 배경          -->
    <!-- ============================================ -->
    <Style x:Key="Tran.SearchBox" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource Tran.Border.Light}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Background" Value="{StaticResource Tran.Surface.Card}"/>
        <Setter Property="Padding" Value="4"/>
    </Style>

    <!-- ============================================ -->
    <!-- Sidebar Section Divider                      -->
    <!-- ============================================ -->
    <Style x:Key="Tran.Sidebar.Divider" TargetType="Border">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{StaticResource Tran.Sidebar.Divider}"/>
        <Setter Property="Margin" Value="16,8"/>
    </Style>

    <!-- ============================================ -->
    <!-- User Profile Card (사이드바 하단 사용자 정보)  -->
    <!-- ============================================ -->
    <Style x:Key="Tran.UserProfile" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Tran.Sidebar.Hover}"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="Margin" Value="12,0"/>
    </Style>

</ResourceDictionary>
