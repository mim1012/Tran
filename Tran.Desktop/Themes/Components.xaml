<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================ -->
    <!-- Badge Styles (for Border elements)           -->
    <!-- ============================================ -->

    <!-- Base Badge (use as BasedOn) -->
    <Style x:Key="Tran.Badge" TargetType="Border">
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="Tran.Badge.Draft" TargetType="Border" BasedOn="{StaticResource Tran.Badge}">
        <Setter Property="Background" Value="{StaticResource Tran.State.Draft.Bg}"/>
    </Style>

    <Style x:Key="Tran.Badge.Sent" TargetType="Border" BasedOn="{StaticResource Tran.Badge}">
        <Setter Property="Background" Value="{StaticResource Tran.State.Sent.Bg}"/>
    </Style>

    <Style x:Key="Tran.Badge.Confirmed" TargetType="Border" BasedOn="{StaticResource Tran.Badge}">
        <Setter Property="Background" Value="{StaticResource Tran.State.Confirmed.Bg}"/>
    </Style>

    <Style x:Key="Tran.Badge.RevisionRequested" TargetType="Border" BasedOn="{StaticResource Tran.Badge}">
        <Setter Property="Background" Value="{StaticResource Tran.State.RevisionRequested.Bg}"/>
    </Style>

    <Style x:Key="Tran.Badge.Cancelled" TargetType="Border" BasedOn="{StaticResource Tran.Badge}">
        <Setter Property="Background" Value="{StaticResource Tran.State.Cancelled.Bg}"/>
    </Style>

    <Style x:Key="Tran.Badge.Active" TargetType="Border" BasedOn="{StaticResource Tran.Badge}">
        <Setter Property="Background" Value="{StaticResource Tran.Badge.Active.Bg}"/>
    </Style>

    <Style x:Key="Tran.Badge.Inactive" TargetType="Border" BasedOn="{StaticResource Tran.Badge}">
        <Setter Property="Background" Value="{StaticResource Tran.Badge.Inactive.Bg}"/>
    </Style>

    <!-- ============================================ -->
    <!-- Card Style                                   -->
    <!-- ============================================ -->
    <Style x:Key="Tran.Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Tran.Surface.Card}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="BorderBrush" Value="{StaticResource Tran.Neutral.200}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2"
                                  Color="#000000" Opacity="0.06" Direction="270"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================ -->
    <!-- Chip Style (pill shape)                      -->
    <!-- ============================================ -->
    <Style x:Key="Tran.Chip" TargetType="Border">
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Background" Value="{StaticResource Tran.Primary.50}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Tran.Primary.200}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- ============================================ -->
    <!-- Section Header                               -->
    <!-- ============================================ -->
    <Style x:Key="Tran.SectionHeader" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Tran.Neutral.50}"/>
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="BorderBrush" Value="{StaticResource Tran.Neutral.200}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>

    <!-- ============================================ -->
    <!-- Summary Card (for inventory/dashboard)       -->
    <!-- ============================================ -->
    <Style x:Key="Tran.SummaryCard" TargetType="Border">
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- ============================================ -->
    <!-- Accent Bar (3px top border for tabs)         -->
    <!-- ============================================ -->
    <Style x:Key="Tran.AccentBar" TargetType="Border">
        <Setter Property="Height" Value="3"/>
    </Style>

    <!-- ============================================ -->
    <!-- Search Box Container                         -->
    <!-- ============================================ -->
    <Style x:Key="Tran.SearchBox" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource Tran.Neutral.300}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Background" Value="White"/>
    </Style>

</ResourceDictionary>
