<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================ -->
    <!-- Modern Palette: Slate (Neutrals) & Indigo (Primary) -->
    <!-- Brand Identity: Professional, Trustworthy, Clean -->
    <!-- ============================================ -->

    <!-- Primary Brand Colors (Indigo/Blurple) -->
    <SolidColorBrush x:Key="Tran.Primary.50"  Color="#EEF2FF"/>
    <SolidColorBrush x:Key="Tran.Primary.100" Color="#E0E7FF"/>
    <SolidColorBrush x:Key="Tran.Primary.200" Color="#C7D2FE"/>
    <SolidColorBrush x:Key="Tran.Primary.300" Color="#A5B4FC"/>
    <SolidColorBrush x:Key="Tran.Primary.400" Color="#818CF8"/>
    <SolidColorBrush x:Key="Tran.Primary.500" Color="#6366F1"/>
    <SolidColorBrush x:Key="Tran.Primary.600" Color="#4F46E5"/>
    <SolidColorBrush x:Key="Tran.Primary.700" Color="#4338CA"/>
    <SolidColorBrush x:Key="Tran.Primary.800" Color="#3730A3"/>
    <SolidColorBrush x:Key="Tran.Primary.900" Color="#312E81"/>

    <!-- Neutral Colors (Slate - Cool Grey) -->
    <SolidColorBrush x:Key="Tran.Neutral.50"  Color="#F8FAFC"/>
    <SolidColorBrush x:Key="Tran.Neutral.100" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="Tran.Neutral.200" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="Tran.Neutral.300" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="Tran.Neutral.400" Color="#94A3B8"/>
    <SolidColorBrush x:Key="Tran.Neutral.500" Color="#64748B"/>
    <SolidColorBrush x:Key="Tran.Neutral.600" Color="#475569"/>
    <SolidColorBrush x:Key="Tran.Neutral.700" Color="#334155"/>
    <SolidColorBrush x:Key="Tran.Neutral.800" Color="#1E293B"/>
    <SolidColorBrush x:Key="Tran.Neutral.900" Color="#0F172A"/>

    <!-- Functional Colors -->
    <!-- Success: Emerald -->
    <SolidColorBrush x:Key="Tran.Success"       Color="#10B981"/>
    <SolidColorBrush x:Key="Tran.Success.Light" Color="#D1FAE5"/>
    <SolidColorBrush x:Key="Tran.Success.Dark"  Color="#047857"/>
    
    <!-- Danger: Rose -->
    <SolidColorBrush x:Key="Tran.Danger"        Color="#F43F5E"/>
    <SolidColorBrush x:Key="Tran.Danger.Light"  Color="#FFE4E6"/>
    <SolidColorBrush x:Key="Tran.Danger.Dark"   Color="#BE123C"/>
    
    <!-- Warning: Amber -->
    <SolidColorBrush x:Key="Tran.Warning"       Color="#F59E0B"/>
    <SolidColorBrush x:Key="Tran.Warning.Light" Color="#FEF3C7"/>
    <SolidColorBrush x:Key="Tran.Warning.Dark"  Color="#B45309"/>
    
    <!-- Info: Sky -->
    <SolidColorBrush x:Key="Tran.Info"          Color="#0EA5E9"/>
    <SolidColorBrush x:Key="Tran.Info.Light"    Color="#E0F2FE"/>
    <SolidColorBrush x:Key="Tran.Info.Dark"     Color="#0369A1"/>

    <!-- Document State Colors -->
    <SolidColorBrush x:Key="Tran.State.Draft.Bg"              Color="#F1F5F9"/>
    <SolidColorBrush x:Key="Tran.State.Draft.Fg"              Color="#64748B"/>
    <SolidColorBrush x:Key="Tran.State.Sent.Bg"               Color="#EEF2FF"/>
    <SolidColorBrush x:Key="Tran.State.Sent.Fg"               Color="#4F46E5"/>
    <SolidColorBrush x:Key="Tran.State.Confirmed.Bg"          Color="#ECFDF5"/>
    <SolidColorBrush x:Key="Tran.State.Confirmed.Fg"          Color="#059669"/>
    <SolidColorBrush x:Key="Tran.State.RevisionRequested.Bg"  Color="#FFFBEB"/>
    <SolidColorBrush x:Key="Tran.State.RevisionRequested.Fg"  Color="#D97706"/>
    <SolidColorBrush x:Key="Tran.State.Cancelled.Bg"          Color="#FEF2F2"/>
    <SolidColorBrush x:Key="Tran.State.Cancelled.Fg"          Color="#DC2626"/>

    <!-- Surface & Background Colors -->
    <!-- Main App Background (Off-white/Light Slate) -->
    <SolidColorBrush x:Key="Tran.Surface.Background" Color="#F8FAFC"/>
    
    <!-- Content Cards (Pure White) -->
    <SolidColorBrush x:Key="Tran.Surface.Card"       Color="#FFFFFF"/>
    
    <!-- Sidebar/Header (Dark Slate or White depending on theme preference, keeping dark for contrast) -->
    <SolidColorBrush x:Key="Tran.Surface.Sidebar"    Color="#FFFFFF"/> 
    <SolidColorBrush x:Key="Tran.Surface.Header"     Color="#FFFFFF"/>
    
    <!-- Footer -->
    <SolidColorBrush x:Key="Tran.Surface.Footer"     Color="#F1F5F9"/>

    <!-- Section Background (DataGrid alternating rows) -->
    <SolidColorBrush x:Key="Tran.Surface.Section"    Color="#F8FAFC"/>

    <!-- Dividers/Borders -->
    <SolidColorBrush x:Key="Tran.Border.Light"       Color="#E2E8F0"/>
    <SolidColorBrush x:Key="Tran.Border.Medium"      Color="#CBD5E1"/>

    <!-- Badge Colors -->
    <SolidColorBrush x:Key="Tran.Badge.Active.Bg"    Color="#ECFDF5"/>
    <SolidColorBrush x:Key="Tran.Badge.Active.Fg"    Color="#059669"/>
    <SolidColorBrush x:Key="Tran.Badge.Inactive.Bg"  Color="#F1F5F9"/>
    <SolidColorBrush x:Key="Tran.Badge.Inactive.Fg"  Color="#64748B"/>

    <!-- Text Colors -->
    <SolidColorBrush x:Key="Tran.Text.Primary"       Color="#1E293B"/> <!-- High Contrast -->
    <SolidColorBrush x:Key="Tran.Text.Secondary"     Color="#64748B"/> <!-- Medium Contrast -->
    <SolidColorBrush x:Key="Tran.Text.Disabled"      Color="#94A3B8"/> <!-- Low Contrast -->
    <SolidColorBrush x:Key="Tran.Text.Inverse"       Color="#FFFFFF"/> <!-- On Dark Bg -->

    <!-- Shadows (Simulated with colors for now, actual shadows use DropShadowEffect) -->
    <Color x:Key="Tran.Shadow.Color">#0F172A</Color>

    <!-- Tab Accent Colors -->
    <SolidColorBrush x:Key="Tran.Accent.Order"     Color="#4F46E5"/>
    <SolidColorBrush x:Key="Tran.Accent.Sale"      Color="#10B981"/>
    <SolidColorBrush x:Key="Tran.Accent.Purchase"  Color="#8B5CF6"/>
    <SolidColorBrush x:Key="Tran.Accent.Inventory" Color="#F59E0B"/>

</ResourceDictionary>
