<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================ -->
    <!-- Primary Blue Scale                           -->
    <!-- ============================================ -->
    <SolidColorBrush x:Key="Tran.Primary.50"  Color="#EFF6FF"/>
    <SolidColorBrush x:Key="Tran.Primary.100" Color="#DBEAFE"/>
    <SolidColorBrush x:Key="Tran.Primary.200" Color="#BFDBFE"/>
    <SolidColorBrush x:Key="Tran.Primary.300" Color="#93C5FD"/>
    <SolidColorBrush x:Key="Tran.Primary.400" Color="#60A5FA"/>
    <SolidColorBrush x:Key="Tran.Primary.500" Color="#3B82F6"/>
    <SolidColorBrush x:Key="Tran.Primary.600" Color="#2563EB"/>
    <SolidColorBrush x:Key="Tran.Primary.700" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="Tran.Primary.800" Color="#1E40AF"/>
    <SolidColorBrush x:Key="Tran.Primary.900" Color="#1E3A8A"/>

    <!-- ============================================ -->
    <!-- Neutral Scale                                -->
    <!-- ============================================ -->
    <SolidColorBrush x:Key="Tran.Neutral.50"  Color="#F9FAFB"/>
    <SolidColorBrush x:Key="Tran.Neutral.100" Color="#F3F4F6"/>
    <SolidColorBrush x:Key="Tran.Neutral.200" Color="#E5E7EB"/>
    <SolidColorBrush x:Key="Tran.Neutral.300" Color="#D1D5DB"/>
    <SolidColorBrush x:Key="Tran.Neutral.400" Color="#9CA3AF"/>
    <SolidColorBrush x:Key="Tran.Neutral.500" Color="#6B7280"/>
    <SolidColorBrush x:Key="Tran.Neutral.600" Color="#4B5563"/>
    <SolidColorBrush x:Key="Tran.Neutral.700" Color="#374151"/>
    <SolidColorBrush x:Key="Tran.Neutral.800" Color="#1F2937"/>
    <SolidColorBrush x:Key="Tran.Neutral.900" Color="#111827"/>

    <!-- ============================================ -->
    <!-- Semantic Colors                              -->
    <!-- ============================================ -->
    <SolidColorBrush x:Key="Tran.Success"       Color="#16A34A"/>
    <SolidColorBrush x:Key="Tran.Success.Light"  Color="#DCFCE7"/>
    <SolidColorBrush x:Key="Tran.Success.Dark"   Color="#15803D"/>
    <SolidColorBrush x:Key="Tran.Danger"         Color="#DC2626"/>
    <SolidColorBrush x:Key="Tran.Danger.Light"   Color="#FEE2E2"/>
    <SolidColorBrush x:Key="Tran.Danger.Dark"    Color="#B91C1C"/>
    <SolidColorBrush x:Key="Tran.Warning"        Color="#D97706"/>
    <SolidColorBrush x:Key="Tran.Warning.Light"  Color="#FEF3C7"/>
    <SolidColorBrush x:Key="Tran.Warning.Dark"   Color="#B45309"/>

    <!-- ============================================ -->
    <!-- Document State Colors (CLAUDE.md compliant)  -->
    <!-- ============================================ -->
    <SolidColorBrush x:Key="Tran.State.Draft.Bg"              Color="#F0F0F0"/>
    <SolidColorBrush x:Key="Tran.State.Draft.Fg"              Color="#555555"/>
    <SolidColorBrush x:Key="Tran.State.Sent.Bg"               Color="#E8F1FF"/>
    <SolidColorBrush x:Key="Tran.State.Sent.Fg"               Color="#1E5EFF"/>
    <SolidColorBrush x:Key="Tran.State.Confirmed.Bg"          Color="#E6F4EA"/>
    <SolidColorBrush x:Key="Tran.State.Confirmed.Fg"          Color="#1E7F34"/>
    <SolidColorBrush x:Key="Tran.State.RevisionRequested.Bg"  Color="#FFF4E5"/>
    <SolidColorBrush x:Key="Tran.State.RevisionRequested.Fg"  Color="#E67700"/>
    <SolidColorBrush x:Key="Tran.State.Cancelled.Bg"          Color="#FFE5E5"/>
    <SolidColorBrush x:Key="Tran.State.Cancelled.Fg"          Color="#C92A2A"/>

    <!-- ============================================ -->
    <!-- Surface Colors                               -->
    <!-- ============================================ -->
    <SolidColorBrush x:Key="Tran.Surface.Header"    Color="#1F2937"/>
    <SolidColorBrush x:Key="Tran.Surface.Footer"    Color="#F3F4F6"/>
    <SolidColorBrush x:Key="Tran.Surface.Background" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Tran.Surface.Card"      Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Tran.Surface.Section"   Color="#F9FAFB"/>

    <!-- ============================================ -->
    <!-- Tab Accent Colors                            -->
    <!-- ============================================ -->
    <SolidColorBrush x:Key="Tran.Accent.Order"     Color="#2563EB"/>
    <SolidColorBrush x:Key="Tran.Accent.Sale"      Color="#16A34A"/>
    <SolidColorBrush x:Key="Tran.Accent.Purchase"  Color="#7C3AED"/>
    <SolidColorBrush x:Key="Tran.Accent.Inventory" Color="#D97706"/>

    <!-- Active/Inactive badge -->
    <SolidColorBrush x:Key="Tran.Badge.Active.Bg"   Color="#E6F4EA"/>
    <SolidColorBrush x:Key="Tran.Badge.Active.Fg"   Color="#1E7F34"/>
    <SolidColorBrush x:Key="Tran.Badge.Inactive.Bg" Color="#F3F4F6"/>
    <SolidColorBrush x:Key="Tran.Badge.Inactive.Fg" Color="#6B7280"/>

</ResourceDictionary>
