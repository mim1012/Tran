<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================ -->
    <!-- Premium Hospital ERP Color System            -->
    <!-- Business Blue + Navy-tinted Neutrals          -->
    <!-- ============================================ -->

    <!-- Primary Brand Colors (Business Blue) -->
    <SolidColorBrush x:Key="Tran.Primary.50"  Color="#EBF2FF"/>
    <SolidColorBrush x:Key="Tran.Primary.100" Color="#D6E4FF"/>
    <SolidColorBrush x:Key="Tran.Primary.200" Color="#ADC8FF"/>
    <SolidColorBrush x:Key="Tran.Primary.300" Color="#84ADFF"/>
    <SolidColorBrush x:Key="Tran.Primary.400" Color="#5B91F5"/>
    <SolidColorBrush x:Key="Tran.Primary.500" Color="#2563EB"/>
    <SolidColorBrush x:Key="Tran.Primary.600" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="Tran.Primary.700" Color="#1E40AF"/>
    <SolidColorBrush x:Key="Tran.Primary.800" Color="#1E3A8A"/>
    <SolidColorBrush x:Key="Tran.Primary.900" Color="#172554"/>

    <!-- Neutral Colors (Navy-tinted Grey) -->
    <SolidColorBrush x:Key="Tran.Neutral.50"  Color="#F7F8FA"/>
    <SolidColorBrush x:Key="Tran.Neutral.100" Color="#EEF0F4"/>
    <SolidColorBrush x:Key="Tran.Neutral.200" Color="#DEE2E9"/>
    <SolidColorBrush x:Key="Tran.Neutral.300" Color="#C1C7D0"/>
    <SolidColorBrush x:Key="Tran.Neutral.400" Color="#8993A4"/>
    <SolidColorBrush x:Key="Tran.Neutral.500" Color="#5E6C84"/>
    <SolidColorBrush x:Key="Tran.Neutral.600" Color="#42526E"/>
    <SolidColorBrush x:Key="Tran.Neutral.700" Color="#253858"/>
    <SolidColorBrush x:Key="Tran.Neutral.800" Color="#172B4D"/>
    <SolidColorBrush x:Key="Tran.Neutral.900" Color="#091E42"/>

    <!-- Functional Colors -->
    <!-- Success -->
    <SolidColorBrush x:Key="Tran.Success"       Color="#0B8A5E"/>
    <SolidColorBrush x:Key="Tran.Success.Light" Color="#E6F4EA"/>
    <SolidColorBrush x:Key="Tran.Success.Dark"  Color="#066042"/>

    <!-- Danger -->
    <SolidColorBrush x:Key="Tran.Danger"        Color="#DE350B"/>
    <SolidColorBrush x:Key="Tran.Danger.Light"  Color="#FFEBE6"/>
    <SolidColorBrush x:Key="Tran.Danger.Dark"   Color="#BF2600"/>

    <!-- Warning -->
    <SolidColorBrush x:Key="Tran.Warning"       Color="#FF991F"/>
    <SolidColorBrush x:Key="Tran.Warning.Light" Color="#FFF4E5"/>
    <SolidColorBrush x:Key="Tran.Warning.Dark"  Color="#E67700"/>

    <!-- Info -->
    <SolidColorBrush x:Key="Tran.Info"          Color="#0065FF"/>
    <SolidColorBrush x:Key="Tran.Info.Light"    Color="#DEEBFF"/>
    <SolidColorBrush x:Key="Tran.Info.Dark"     Color="#0747A6"/>

    <!-- Document State Colors -->
    <SolidColorBrush x:Key="Tran.State.Draft.Bg"              Color="#F0F0F0"/>
    <SolidColorBrush x:Key="Tran.State.Draft.Fg"              Color="#555555"/>
    <SolidColorBrush x:Key="Tran.State.Sent.Bg"               Color="#E8F1FF"/>
    <SolidColorBrush x:Key="Tran.State.Sent.Fg"               Color="#1E5EFF"/>
    <SolidColorBrush x:Key="Tran.State.Confirmed.Bg"          Color="#E6F4EA"/>
    <SolidColorBrush x:Key="Tran.State.Confirmed.Fg"          Color="#1E7F34"/>
    <SolidColorBrush x:Key="Tran.State.RevisionRequested.Bg"  Color="#FFF4E5"/>
    <SolidColorBrush x:Key="Tran.State.RevisionRequested.Fg"  Color="#E67700"/>
    <SolidColorBrush x:Key="Tran.State.Cancelled.Bg"          Color="#FFEBE6"/>
    <SolidColorBrush x:Key="Tran.State.Cancelled.Fg"          Color="#DE350B"/>

    <!-- Surface & Background Colors -->
    <SolidColorBrush x:Key="Tran.Surface.Background" Color="#F7F8FA"/>
    <SolidColorBrush x:Key="Tran.Surface.Card"       Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Tran.Surface.Sidebar"    Color="#0F1B2D"/>
    <SolidColorBrush x:Key="Tran.Surface.Header"     Color="#152238"/>
    <SolidColorBrush x:Key="Tran.Surface.Footer"     Color="#F4F5F7"/>
    <SolidColorBrush x:Key="Tran.Surface.Section"    Color="#F7F8FA"/>

    <!-- Sidebar Colors -->
    <SolidColorBrush x:Key="Tran.Sidebar.Background" Color="#0F1B2D"/>
    <SolidColorBrush x:Key="Tran.Sidebar.ItemHover"  Color="#1A2942"/>
    <SolidColorBrush x:Key="Tran.Sidebar.ItemActive"  Color="#1D4ED8"/>
    <SolidColorBrush x:Key="Tran.Sidebar.Text"        Color="#8899B4"/>
    <SolidColorBrush x:Key="Tran.Sidebar.TextActive"   Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Tran.Sidebar.Divider"     Color="#1E3050"/>

    <!-- Dividers/Borders -->
    <SolidColorBrush x:Key="Tran.Border.Light"       Color="#DEE2E9"/>
    <SolidColorBrush x:Key="Tran.Border.Medium"      Color="#C1C7D0"/>

    <!-- Badge Colors -->
    <SolidColorBrush x:Key="Tran.Badge.Active.Bg"    Color="#E6F4EA"/>
    <SolidColorBrush x:Key="Tran.Badge.Active.Fg"    Color="#0B8A5E"/>
    <SolidColorBrush x:Key="Tran.Badge.Inactive.Bg"  Color="#F0F0F0"/>
    <SolidColorBrush x:Key="Tran.Badge.Inactive.Fg"  Color="#555555"/>

    <!-- Text Colors -->
    <SolidColorBrush x:Key="Tran.Text.Primary"       Color="#172B4D"/>
    <SolidColorBrush x:Key="Tran.Text.Secondary"     Color="#5E6C84"/>
    <SolidColorBrush x:Key="Tran.Text.Disabled"      Color="#8993A4"/>
    <SolidColorBrush x:Key="Tran.Text.Inverse"       Color="#FFFFFF"/>

    <!-- Shadows -->
    <Color x:Key="Tran.Shadow.Color">#091E42</Color>

    <!-- Tab Accent Colors -->
    <SolidColorBrush x:Key="Tran.Accent.Order"     Color="#2563EB"/>
    <SolidColorBrush x:Key="Tran.Accent.Sale"      Color="#0B8A5E"/>
    <SolidColorBrush x:Key="Tran.Accent.Purchase"  Color="#5243AA"/>
    <SolidColorBrush x:Key="Tran.Accent.Inventory" Color="#FF991F"/>

    <!-- Purchase Accent Light -->
    <SolidColorBrush x:Key="Tran.Accent.Purchase.Light" Color="#EAE6FF"/>

</ResourceDictionary>
