<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================ -->
    <!-- 피플카 ERP 스타일 컨트롤                       -->
    <!-- 플랫 디자인, 둥근 모서리, 상태별 명도 변화     -->
    <!-- ============================================ -->

    <!-- ============================================ -->
    <!-- SHADOWS & EFFECTS                            -->
    <!-- ============================================ -->
    <DropShadowEffect x:Key="Tran.Effect.Shadow.Sm" BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.08" Color="{StaticResource Tran.Shadow.Color}"/>
    <DropShadowEffect x:Key="Tran.Effect.Shadow.Md" BlurRadius="8" ShadowDepth="2" Direction="270" Opacity="0.08" Color="{StaticResource Tran.Shadow.Color}"/>
    <DropShadowEffect x:Key="Tran.Effect.Shadow.Lg" BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.10" Color="{StaticResource Tran.Shadow.Color}"/>

    <!-- ============================================ -->
    <!-- BUTTONS                                      -->
    <!-- 피플카 스타일: 둥근 모서리, 플랫 디자인        -->
    <!-- ============================================ -->
    
    <!-- Base Button Style -->
    <Style x:Key="Tran.ButtonStyle.Base" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource Tran.FontFamily}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="20,0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            SnapsToDevicePixels="True">
                        <ContentPresenter x:Name="contentPresenter"
                                          Focusable="False"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          Margin="{TemplateBinding Padding}"
                                          RecognizesAccessKey="True"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Primary Button (Accent Blue - 피플카 핵심 버튼) -->
    <Style x:Key="Tran.PrimaryButton" TargetType="Button" BasedOn="{StaticResource Tran.ButtonStyle.Base}">
        <Setter Property="Background" Value="{StaticResource Tran.Accent.Blue}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Tran.Accent.Blue}"/>
        <Setter Property="Foreground" Value="White"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Tran.Accent.Blue.Dark}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Tran.Accent.Blue.Dark}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource Tran.Accent.Blue.Darker}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Navy Primary Button (다크 네이비 배경 버튼) -->
    <Style x:Key="Tran.NavyButton" TargetType="Button" BasedOn="{StaticResource Tran.ButtonStyle.Base}">
        <Setter Property="Background" Value="{StaticResource Tran.Primary.900}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Tran.Primary.900}"/>
        <Setter Property="Foreground" Value="White"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Tran.Primary.800}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Tran.Primary.800}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Secondary Button (White with border) -->
    <Style x:Key="Tran.SecondaryButton" TargetType="Button" BasedOn="{StaticResource Tran.ButtonStyle.Base}">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource Tran.Border.Medium}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource Tran.Text.Primary}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Tran.Neutral.50}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Tran.Neutral.400}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Destructive Button (Red) -->
    <Style x:Key="Tran.DestructiveButton" TargetType="Button" BasedOn="{StaticResource Tran.ButtonStyle.Base}">
        <Setter Property="Background" Value="{StaticResource Tran.Danger}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Tran.Danger}"/>
        <Setter Property="Foreground" Value="White"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Tran.Danger.Dark}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Tran.Danger.Dark}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Success Button (Green) -->
    <Style x:Key="Tran.SuccessButton" TargetType="Button" BasedOn="{StaticResource Tran.ButtonStyle.Base}">
        <Setter Property="Background" Value="{StaticResource Tran.Success}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Tran.Success}"/>
        <Setter Property="Foreground" Value="White"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Tran.Success.Dark}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Tran.Success.Dark}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Warning Button (Amber) -->
    <Style x:Key="Tran.WarningButton" TargetType="Button" BasedOn="{StaticResource Tran.ButtonStyle.Base}">
        <Setter Property="Background" Value="{StaticResource Tran.Warning}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Tran.Warning}"/>
        <Setter Property="Foreground" Value="White"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Tran.Warning.Dark}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Tran.Warning.Dark}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Ghost Button (Transparent) -->
    <Style x:Key="Tran.GhostButton" TargetType="Button" BasedOn="{StaticResource Tran.ButtonStyle.Base}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource Tran.Text.Secondary}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Tran.Neutral.100}"/>
                <Setter Property="Foreground" Value="{StaticResource Tran.Text.Primary}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Sidebar Ghost Button (다크 네이비 배경 위 투명 버튼) -->
    <Style x:Key="Tran.SidebarButton" TargetType="Button" BasedOn="{StaticResource Tran.ButtonStyle.Base}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource Tran.Sidebar.Text.Secondary}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Tran.Sidebar.Hover}"/>
                <Setter Property="Foreground" Value="{StaticResource Tran.Sidebar.Text}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Sidebar Active Button (활성 메뉴 아이템) -->
    <Style x:Key="Tran.SidebarButton.Active" TargetType="Button" BasedOn="{StaticResource Tran.ButtonStyle.Base}">
        <Setter Property="Background" Value="{StaticResource Tran.Sidebar.ActiveBg}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- Purchase Button (Purple/Accent) -->
    <Style x:Key="Tran.PurchaseButton" TargetType="Button" BasedOn="{StaticResource Tran.ButtonStyle.Base}">
        <Setter Property="Background" Value="{StaticResource Tran.Accent.Purchase}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Tran.Accent.Purchase}"/>
        <Setter Property="Foreground" Value="White"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#7C3AED"/>
                <Setter Property="BorderBrush" Value="#7C3AED"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Icon Button (Round) -->
    <Style x:Key="Tran.IconButton" TargetType="Button">
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="18"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource Tran.Neutral.100}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Icon Button Danger (Round, Red) -->
    <Style x:Key="Tran.IconButton.Danger" TargetType="Button">
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource Tran.Danger}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="18"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource Tran.Danger.Light}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================ -->
    <!-- INPUTS (TextBox, ComboBox)                   -->
    <!-- 피플카 스타일: 연한 회색 테두리, 충분한 패딩   -->
    <!-- ============================================ -->
    
    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource Tran.FontFamily}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Height" Value="42"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="{StaticResource Tran.Surface.Card}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Tran.Border.Light}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource Tran.Text.Primary}"/>
        <Setter Property="CaretBrush" Value="{StaticResource Tran.Accent.Blue}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Tran.Neutral.400}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Tran.Accent.Blue}"/>
                            <Setter TargetName="border" Property="BorderThickness" Value="1.5"/>
                            <Setter TargetName="border" Property="Background" Value="White"/>
                        </Trigger>
                         <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.6"/>
                            <Setter TargetName="border" Property="Background" Value="{StaticResource Tran.Neutral.50}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource Tran.FontFamily}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Height" Value="42"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="{StaticResource Tran.Surface.Card}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Tran.Border.Light}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource Tran.Text.Primary}"/>
    </Style>

    <!-- DatePicker Style -->
    <Style TargetType="DatePicker">
        <Setter Property="FontFamily" Value="{StaticResource Tran.FontFamily}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Height" Value="42"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="{StaticResource Tran.Surface.Card}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Tran.Border.Light}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource Tran.Text.Primary}"/>
    </Style>

    <!-- ============================================ -->
    <!-- DATAGRID                                     -->
    <!-- 피플카 스타일: Zebra Striping, 얇은 회색 구분선 -->
    <!-- ============================================ -->
    
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="RowHeight" Value="52"/>
        <Setter Property="ColumnHeaderHeight" Value="48"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Tran.Border.Light}"/>
        <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>
        <Setter Property="AlternatingRowBackground" Value="{StaticResource Tran.Surface.Section}"/>
        <Setter Property="RowBackground" Value="White"/>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource Tran.Neutral.50}"/>
        <Setter Property="Foreground" Value="{StaticResource Tran.Text.Secondary}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="Height" Value="48"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="BorderBrush" Value="{StaticResource Tran.Border.Medium}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="14"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Tran.Accent.Blue.Light}"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource Tran.Accent.Blue.Light}"/>
                <Setter Property="Foreground" Value="{StaticResource Tran.Accent.Blue.Dark}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="Transparent" BorderThickness="0">
                        <ContentPresenter VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================ -->
    <!-- TAB CONTROL                                  -->
    <!-- 피플카 스타일: 하단 액센트 바, 블루 강조       -->
    <!-- ============================================ -->

    <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="FontFamily" Value="{StaticResource Tran.FontFamily}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource Tran.Text.Secondary}"/>
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="Margin" Value="0,0,0,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid>
                        <Border x:Name="Border"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,0,3"
                                Margin="0,0,0,-1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="ContentSite"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center"
                                              ContentSource="Header"
                                              RecognizesAccessKey="True"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource Tran.Accent.Blue}"/>
                            <Setter Property="Foreground" Value="{StaticResource Tran.Accent.Blue}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{StaticResource Tran.Neutral.50}"/>
                            <Setter Property="Foreground" Value="{StaticResource Tran.Text.Primary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================ -->
    <!-- SCROLLBAR (피플카 스타일: 얇은 미니멀 스크롤바) -->
    <!-- ============================================ -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="6"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>

</ResourceDictionary>
