<mah:MetroWindow x:Class="Tran.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Tran.Desktop"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        mc:Ignorable="d"
        Title="Tran - 거래명세표 관리" Height="768" Width="1280"
        WindowStartupLocation="CenterScreen"
        TitleCharacterCasing="Normal"
        GlowBrush="{StaticResource Tran.Primary.500}"
        BorderThickness="1"
        WindowTransitionsEnabled="False"
        FontFamily="{StaticResource Tran.FontFamily}"
        Background="{StaticResource Tran.Surface.Background}">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/> <!-- Modern Wide Sidebar -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============================================ -->
        <!-- SIDEBAR                                      -->
        <!-- ============================================ -->
        <Border Grid.Column="0" Background="{StaticResource Tran.Surface.Sidebar}" BorderBrush="{StaticResource Tran.Border.Light}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Brand -->
                    <RowDefinition Height="*"/>    <!-- Menu -->
                    <RowDefinition Height="Auto"/> <!-- Footer -->
                </Grid.RowDefinitions>

                <!-- Brand Area -->
                <StackPanel Grid.Row="0" Margin="24,32,24,40">
                    <TextBlock Text="Tran" Style="{StaticResource Tran.Typography.H1}" Foreground="{StaticResource Tran.Primary.700}"/>
                    <TextBlock Text="ERP System" Style="{StaticResource Tran.Typography.Caption}" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Navigation Menu -->
                <StackPanel Grid.Row="1" Margin="12,0">
                    <!-- Dashboard / Home (Active State Example) -->
                    <Button Content="거래명세표"
                            Height="48"
                            HorizontalContentAlignment="Left"
                            Padding="16,0"
                            Margin="0,0,0,4"
                            Style="{StaticResource Tran.GhostButton}"
                            Background="{StaticResource Tran.Primary.50}"
                            Foreground="{StaticResource Tran.Primary.700}"
                            FontWeight="SemiBold"/>
                    
                    <Button Content="거래처 관리"
                            Height="48"
                            HorizontalContentAlignment="Left"
                            Padding="16,0"
                            Margin="0,0,0,4"
                            Style="{StaticResource Tran.GhostButton}"
                            Click="PartnerManagement_Click"/>
                            
                    <Button Content="정산 관리"
                            Height="48"
                            HorizontalContentAlignment="Left"
                            Padding="16,0"
                            Margin="0,0,0,4"
                            Style="{StaticResource Tran.GhostButton}"
                            Click="SettlementManagement_Click"/>
                            
                    <Button Content="양식 관리"
                            Height="48"
                            HorizontalContentAlignment="Left"
                            Padding="16,0"
                            Margin="0,0,0,4"
                            Style="{StaticResource Tran.GhostButton}"
                            Click="TemplateManagement_Click"/>
                            
                    <Button Content="로그 및 이력"
                            Height="48"
                            HorizontalContentAlignment="Left"
                            Padding="16,0"
                            Margin="0,0,0,4"
                            Style="{StaticResource Tran.GhostButton}"/>
                </StackPanel>

                <!-- Bottom Settings -->
                <StackPanel Grid.Row="2" Margin="12,24">
                     <Button Content="설정"
                            Height="48"
                            HorizontalContentAlignment="Left"
                            Padding="16,0"
                            Style="{StaticResource Tran.GhostButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================ -->
        <!-- MAIN CONTENT AREA                            -->
        <!-- ============================================ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/> <!-- Header -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Header -->
            <Border Grid.Row="0" Background="{StaticResource Tran.Surface.Header}" BorderBrush="{StaticResource Tran.Border.Light}" BorderThickness="0,0,0,1" Padding="32,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Page Title -->
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="거래명세표 관리" Style="{StaticResource Tran.Typography.H2}"/>
                    </StackPanel>

                    <!-- Header Actions / User Profile -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource Tran.Success.Light}" CornerRadius="16" Padding="12,6" Margin="0,0,16,0">
                             <StackPanel Orientation="Horizontal">
                                 <Ellipse Width="8" Height="8" Fill="{StaticResource Tran.Success}" Margin="0,0,8,0"/>
                                 <TextBlock Text="연결됨" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Tran.Success.Dark}"/>
                             </StackPanel>
                        </Border>
                        
                        <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                            <TextBlock Text="관리자" Style="{StaticResource Tran.Typography.Body2}" FontWeight="Bold" HorizontalAlignment="Right"/>
                             <TextBlock Text="Admin User" Style="{StaticResource Tran.Typography.Caption}" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Dashboard Content -->
            <Grid Grid.Row="1" Margin="32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Filters -->
                    <RowDefinition Height="*"/>    <!-- Data Card -->
                </Grid.RowDefinitions>

                <!-- Filters & Actions Bar -->
                <Grid Grid.Row="0" Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- Search -->
                         <ColumnDefinition Width="Auto"/> <!-- Spacer -->
                        <ColumnDefinition Width="Auto"/> <!-- Status Filter -->
                         <ColumnDefinition Width="*"/>    <!-- Spacer -->
                        <ColumnDefinition Width="Auto"/> <!-- Right Actions -->
                    </Grid.ColumnDefinitions>

                    <!-- Search Box -->
                    <Grid Grid.Column="0">
                        <Grid.ColumnDefinitions>
                             <ColumnDefinition Width="Auto"/>
                             <ColumnDefinition Width="300"/>
                             <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="문서번호" VerticalAlignment="Center" Margin="0,0,12,0" Style="{StaticResource Tran.Typography.Body2}"/>
                        <TextBox Grid.Column="1" Name="SearchBox" Padding="10" VerticalContentAlignment="Center"/>
                        <Button Grid.Column="2" Content="검색" Margin="8,0,0,0" Style="{StaticResource Tran.PrimaryButton}" Width="80"/>
                    </Grid>

                    <!-- Status Filter -->
                     <Grid Grid.Column="2" Margin="32,0,0,0">
                        <Grid.ColumnDefinitions>
                             <ColumnDefinition Width="Auto"/>
                             <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="상태" VerticalAlignment="Center" Margin="0,0,12,0" Style="{StaticResource Tran.Typography.Body2}"/>
                        <ComboBox Grid.Column="1" Name="StateFilterComboBox" VerticalContentAlignment="Center" SelectedIndex="0">
                            <ComboBoxItem Content="전체"/>
                            <ComboBoxItem Content="작성중"/>
                            <ComboBoxItem Content="전송됨"/>
                            <ComboBoxItem Content="수신됨"/>
                            <ComboBoxItem Content="확정됨"/>
                        </ComboBox>
                    </Grid>

                    <!-- Right Actions -->
                    <StackPanel Grid.Column="4" Orientation="Horizontal">
                        <Button Content="+ 신규 작성" Style="{StaticResource Tran.PrimaryButton}" Click="CreateDocumentButton_Click"/>
                        <Button Content="새로고침" Style="{StaticResource Tran.SecondaryButton}" Margin="8,0,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Data Card -->
                <Border Grid.Row="1" Background="{StaticResource Tran.Surface.Card}" CornerRadius="12" BorderBrush="{StaticResource Tran.Border.Light}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DataGrid Grid.Row="0" Name="DocumentsDataGrid"
                                  BorderThickness="0"
                                  Margin="2"
                                  ColumnHeaderHeight="50"
                                  RowHeight="52"
                                  MouseDoubleClick="DocumentsDataGrid_MouseDoubleClick">
                            <!-- Custom Row Style for Hover/Selection -->
                             <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="FontSize" Value="14"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource Tran.Neutral.50}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                             <Setter Property="Background" Value="{StaticResource Tran.Primary.50}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>

                            <DataGrid.Columns>
                                <!-- Status Column with Pills -->
                                <DataGridTemplateColumn Header="상태" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding StatePillBackground}"
                                                    CornerRadius="16"
                                                    Padding="12,4"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StateDisplayText}"
                                                          Foreground="{Binding StatePillForeground}"
                                                          FontSize="12"
                                                          FontWeight="SemiBold"
                                                          HorizontalAlignment="Center"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                
                                <DataGridTextColumn Header="문서번호" Binding="{Binding DocumentId}" Width="160"/>
                                <DataGridTextColumn Header="거래처" Binding="{Binding FromCompanyId}" Width="200"/>
                                <DataGridTextColumn Header="총금액" Binding="{Binding TotalAmount, StringFormat=\{0:N0\}원}" Width="140">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="Padding" Value="0,0,24,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="거래일" Binding="{Binding TransactionDate, StringFormat=yyyy-MM-dd}" Width="140"/>
                                <DataGridTextColumn Header="버전" Binding="{Binding VersionNumber}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Pagination / Footer Actions -->
                        <Border Grid.Row="1" BorderBrush="{StaticResource Tran.Border.Light}" BorderThickness="0,1,0,0" Padding="16">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <Button Content="선택 항목 열기" Style="{StaticResource Tran.SecondaryButton}" Margin="0,0,8,0"/>
                                <Button Content="삭제" Style="{StaticResource Tran.DestructiveButton}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</mah:MetroWindow>
