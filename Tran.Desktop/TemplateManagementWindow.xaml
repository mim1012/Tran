<mah:MetroWindow x:Class="Tran.Desktop.TemplateManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        mc:Ignorable="d"
        Title="양식 관리 (읽기 전용)" Height="700" Width="1200"
        WindowStartupLocation="CenterScreen"
        TitleCharacterCasing="Normal"
        GlowBrush="{StaticResource Tran.Primary.500}"
        BorderThickness="1"
        WindowTransitionsEnabled="False"
        Background="{StaticResource Tran.Neutral.50}"
        FontFamily="{StaticResource Tran.FontFamily}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 상단 헤더 -->
        <Border Grid.Row="0" Background="{StaticResource Tran.Neutral.500}" Padding="20,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="양식 관리" FontSize="20" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="템플릿 조회 전용 화면 (편집 불가)" FontSize="12" Foreground="{StaticResource Tran.Neutral.200}" Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="읽기 전용 모드" FontSize="13" Foreground="{StaticResource Tran.Neutral.200}"
                              Background="{StaticResource Tran.Neutral.600}" Padding="10,5" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 메인 콘텐츠 -->
        <Grid Grid.Row="1" Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="400"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="3*" MinWidth="500"/>
            </Grid.ColumnDefinitions>

            <!-- 좌측: 템플릿 목록 -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 필터 영역 -->
                <Border Grid.Row="0" Background="White" Padding="15" Margin="10,10,5,0"
                       BorderBrush="{StaticResource Tran.Neutral.200}" BorderThickness="1" CornerRadius="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="거래처:" VerticalAlignment="Center"
                                      FontSize="13" Foreground="{StaticResource Tran.Neutral.600}" Margin="0,0,10,0"/>
                            <ComboBox Grid.Column="1" Name="CompanyFilterComboBox"
                                     ItemsSource="{Binding Companies}"
                                     DisplayMemberPath="CompanyName"
                                     SelectedValuePath="CompanyId"
                                     SelectedValue="{Binding SelectedCompanyId, Mode=TwoWay}"
                                     Padding="8,5" FontSize="13" VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="3" Text="상태:" VerticalAlignment="Center"
                                      FontSize="13" Foreground="{StaticResource Tran.Neutral.600}" Margin="0,0,10,0"/>
                            <ComboBox Grid.Column="4" Name="ActiveFilterComboBox"
                                     SelectedIndex="0" Padding="8,5" FontSize="13" VerticalAlignment="Center"
                                     SelectionChanged="ActiveFilterComboBox_SelectionChanged">
                                <ComboBoxItem Content="활성만"/>
                                <ComboBoxItem Content="전체"/>
                            </ComboBox>
                        </Grid>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Tran.Neutral.500}">
                                <Run Text="총"/>
                                <Run Text="{Binding Templates.Count, Mode=OneWay}" FontWeight="Bold"/>
                                <Run Text="개 템플릿"/>
                            </TextBlock>

                            <Button Grid.Column="1" Content="새로고침" Padding="12,6"
                                   Style="{StaticResource Tran.SecondaryButton}"
                                   FontSize="12" Click="RefreshButton_Click"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 템플릿 목록 DataGrid -->
                <DataGrid Grid.Row="1" Name="TemplatesDataGrid"
                         ItemsSource="{Binding Templates}"
                         SelectedItem="{Binding SelectedTemplate, Mode=TwoWay}"
                         AutoGenerateColumns="False"
                         IsReadOnly="True"
                         SelectionMode="Single"
                         GridLinesVisibility="None"
                         HeadersVisibility="Column"
                         Background="White"
                         RowHeight="50"
                         Margin="10,10,5,10"
                         BorderBrush="{StaticResource Tran.Neutral.200}"
                         BorderThickness="1">

                    <DataGrid.Columns>
                        <!-- 활성 상태 -->
                        <DataGridTemplateColumn Header="상태" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding StatusBackground}"
                                           CornerRadius="6"
                                           Padding="8,4"
                                           HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding ActiveStatusDisplay}"
                                                 Foreground="{Binding StatusForeground}"
                                                 HorizontalAlignment="Center"
                                                 FontSize="12"
                                                 FontWeight="SemiBold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 양식명 -->
                        <DataGridTextColumn Header="양식명" Binding="{Binding TemplateName}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="13"/>
                                    <Setter Property="Foreground" Value="{StaticResource Tran.Neutral.900}"/>
                                    <Setter Property="Padding" Value="5,0"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- 거래처 -->
                        <DataGridTextColumn Header="거래처" Binding="{Binding CompanyName}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Foreground" Value="{StaticResource Tran.Neutral.600}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- 양식 타입 -->
                        <DataGridTextColumn Header="타입" Binding="{Binding TemplateTypeDisplay}" Width="90">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Foreground" Value="{StaticResource Tran.Neutral.500}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- 생성일 -->
                        <DataGridTextColumn Header="생성일" Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd}" Width="95">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Foreground" Value="{StaticResource Tran.Neutral.400}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- 구분선 -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                         Background="{StaticResource Tran.Neutral.200}" ResizeBehavior="PreviousAndNext"/>

            <!-- 우측: 양식 상세 정보 -->
            <Border Grid.Column="2" Background="White" Margin="5,10,10,10"
                   BorderBrush="{StaticResource Tran.Neutral.200}" BorderThickness="1" CornerRadius="4">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0">
                        <!-- 헤더 -->
                        <Border Background="{StaticResource Tran.Neutral.50}" Padding="20,15" BorderBrush="{StaticResource Tran.Neutral.200}" BorderThickness="0,0,0,1">
                            <StackPanel>
                                <TextBlock Text="양식 상세 정보" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Tran.Neutral.900}"/>
                                <TextBlock Text="선택한 양식의 상세 내역을 확인할 수 있습니다"
                                         FontSize="12" Foreground="{StaticResource Tran.Neutral.500}" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- 템플릿 선택 안내 (템플릿 미선택 시) -->
                        <Border x:Name="NoSelectionPanel" Background="{StaticResource Tran.Neutral.50}" Margin="20" Padding="40,60"
                               CornerRadius="8" BorderBrush="{StaticResource Tran.Neutral.200}" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedTemplate}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#x1F4CB;" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                                <TextBlock Text="양식을 선택해주세요" FontSize="16" FontWeight="SemiBold"
                                         Foreground="{StaticResource Tran.Neutral.500}" HorizontalAlignment="Center"/>
                                <TextBlock Text="왼쪽 목록에서 양식을 클릭하면 상세 정보가 표시됩니다"
                                         FontSize="13" Foreground="{StaticResource Tran.Neutral.400}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- 상세 정보 패널 (템플릿 선택 시) -->
                        <StackPanel x:Name="DetailPanel" Margin="20">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedTemplate}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <!-- 기본 정보 섹션 -->
                            <TextBlock Text="기본 정보" FontSize="15" FontWeight="Bold" Foreground="{StaticResource Tran.Neutral.900}" Margin="0,0,0,15"/>

                            <Grid Margin="0,0,0,25">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="15"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="15"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="15"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="15"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="양식명" FontWeight="SemiBold" Foreground="{StaticResource Tran.Neutral.600}" VerticalAlignment="Top"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedTemplate.TemplateName}"
                                         FontSize="14" Foreground="{StaticResource Tran.Neutral.900}" TextWrapping="Wrap"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="거래처" FontWeight="SemiBold" Foreground="{StaticResource Tran.Neutral.600}"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedTemplate.CompanyName}"
                                         FontSize="14" Foreground="{StaticResource Tran.Neutral.900}"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="양식 타입" FontWeight="SemiBold" Foreground="{StaticResource Tran.Neutral.600}"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedTemplate.TemplateTypeDisplay}"
                                         FontSize="14" Foreground="{StaticResource Tran.Neutral.900}"/>

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="상태" FontWeight="SemiBold" Foreground="{StaticResource Tran.Neutral.600}"/>
                                <Border Grid.Row="6" Grid.Column="1" Background="{Binding SelectedTemplate.StatusBackground}"
                                       CornerRadius="6" Padding="10,5" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding SelectedTemplate.ActiveStatusDisplay}"
                                             Foreground="{Binding SelectedTemplate.StatusForeground}"
                                             FontSize="13" FontWeight="SemiBold"/>
                                </Border>

                                <TextBlock Grid.Row="8" Grid.Column="0" Text="생성일" FontWeight="SemiBold" Foreground="{StaticResource Tran.Neutral.600}"/>
                                <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding SelectedTemplate.CreatedAt, StringFormat=yyyy년 MM월 dd일}"
                                         FontSize="14" Foreground="{StaticResource Tran.Neutral.900}"/>
                            </Grid>

                            <!-- 구분선 -->
                            <Border Height="1" Background="{StaticResource Tran.Neutral.200}" Margin="0,0,0,25"/>

                            <!-- 추가 정보 섹션 -->
                            <TextBlock Text="추가 정보" FontSize="15" FontWeight="Bold" Foreground="{StaticResource Tran.Neutral.900}" Margin="0,0,0,15"/>

                            <Border Background="{StaticResource Tran.Neutral.50}" Padding="15" CornerRadius="6" Margin="0,0,0,20">
                                <StackPanel>
                                    <TextBlock FontSize="13" Foreground="{StaticResource Tran.Neutral.600}" TextWrapping="Wrap">
                                        <Run Text="&#x2022; 이 양식은 거래명세표 작성 시 사용할 수 있는 템플릿입니다"/>
                                    </TextBlock>
                                    <TextBlock FontSize="13" Foreground="{StaticResource Tran.Neutral.600}" TextWrapping="Wrap" Margin="0,8,0,0">
                                        <Run Text="&#x2022; 양식 편집 기능은 시스템 관리자만 사용할 수 있습니다"/>
                                    </TextBlock>
                                    <TextBlock FontSize="13" Foreground="{StaticResource Tran.Neutral.600}" TextWrapping="Wrap" Margin="0,8,0,0">
                                        <Run Text="&#x2022; 비활성 상태의 양식은 새 문서 작성 시 선택할 수 없습니다"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 하단 버튼 영역 -->
        <Border Grid.Row="2" Background="{StaticResource Tran.Neutral.50}" Padding="20,15"
               BorderBrush="{StaticResource Tran.Neutral.200}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Tran.Neutral.500}">
                    <Run Text="이 화면은 조회 전용입니다."/>
                    <Run Text="편집/저장 기능은 제공하지 않습니다." FontWeight="SemiBold"/>
                </TextBlock>

                <Button Grid.Column="1" Content="닫기" Padding="20,8"
                       Style="{StaticResource Tran.SecondaryButton}"
                       FontSize="13"
                       Click="CloseButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</mah:MetroWindow>
