<Window x:Class="Tran.Desktop.SpecEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="규격 입력" Height="550" Width="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource Tran.Surface.Background}"
        FontFamily="{StaticResource Tran.FontFamily}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 헤더 영역 -->
        <Border Grid.Row="0" Background="{StaticResource Tran.Accent.Purchase}" Padding="20">
            <StackPanel>
                <TextBlock Text="규격 입력" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,0,0,5"/>
                <TextBlock Text="품목의 세부 규격을 Key-Value 형태로 입력하세요 (예: 두께: 1.2T, 사이즈: 4 x 8)"
                         Foreground="White" FontSize="13" Opacity="0.9"/>
            </StackPanel>
        </Border>

        <!-- 규격 목록 -->
        <Border Grid.Row="1" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 추가 버튼 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                    <TextBlock Text="규격 항목" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Button Content="+ 항목 추가"
                           Command="{Binding AddSpecCommand}"
                           Style="{StaticResource Tran.SuccessButton}"
                           Padding="15,8" Margin="20,0,0,0"/>
                </StackPanel>

                <!-- 규격 DataGrid -->
                <DataGrid Grid.Row="1"
                         ItemsSource="{Binding Specs}"
                         AutoGenerateColumns="False"
                         CanUserAddRows="False"
                         CanUserDeleteRows="False"
                         RowHeaderWidth="0"
                         GridLinesVisibility="Horizontal"
                         BorderBrush="{StaticResource Tran.Neutral.200}"
                         BorderThickness="1"
                         HeadersVisibility="Column"
                         Background="White">

                    <DataGrid.Columns>
                        <!-- 규격명 (Key) -->
                        <DataGridTextColumn Header="규격명" Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Width="2*" IsReadOnly="False">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- 규격 값 (Value) -->
                        <DataGridTextColumn Header="규격 값" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="3*" IsReadOnly="False">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- 삭제 버튼 -->
                        <DataGridTemplateColumn Header="" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="삭제"
                                           Command="{Binding DataContext.RemoveSpecCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                           CommandParameter="{Binding}"
                                           Style="{StaticResource Tran.DestructiveButton}"
                                           Padding="10,5"
                                           FontSize="12"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- 하단 버튼 영역 -->
        <Border Grid.Row="2" Background="{StaticResource Tran.Neutral.50}" Padding="20" BorderBrush="{StaticResource Tran.Neutral.200}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <!-- 확인 버튼 -->
                <Button Content="확인"
                       Command="{Binding OkCommand}"
                       Style="{StaticResource Tran.PurchaseButton}"
                       Padding="30,12" Margin="0,0,10,0"
                       FontSize="14"/>

                <!-- 취소 버튼 -->
                <Button Content="취소"
                       Command="{Binding CancelCommand}"
                       Style="{StaticResource Tran.SecondaryButton}"
                       Padding="30,12"
                       FontSize="14"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
