<Window x:Class="Tran.Desktop.DataImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Tran.Desktop.ViewModels"
        Title="데이터 가져오기"
        Width="1000" Height="700"
        WindowStartupLocation="CenterOwner"
        Background="White"
        ResizeMode="CanResize"
        FontFamily="{StaticResource Tran.FontFamily}">

    <Window.DataContext>
        <vm:DataImportViewModel/>
    </Window.DataContext>

    <DockPanel Margin="20">

        <!-- Header -->
        <TextBlock DockPanel.Dock="Top"
                   Text="데이터 가져오기"
                   FontSize="22" FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <!-- Step 1: Import Type Selection -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource Tran.Neutral.50}"
                CornerRadius="8" Padding="15,12"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="1단계: 가져올 유형 선택" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="RadioCompany" Content="거래처" IsChecked="True"
                                 Checked="ImportType_Checked" Tag="Company"
                                 Margin="0,0,20,0" FontSize="14" VerticalContentAlignment="Center"/>
                    <RadioButton x:Name="RadioProduct" Content="품목"
                                 Checked="ImportType_Checked" Tag="Product"
                                 Margin="0,0,20,0" FontSize="14" VerticalContentAlignment="Center"/>
                    <RadioButton x:Name="RadioSale" Content="매출"
                                 Checked="ImportType_Checked" Tag="Sale"
                                 Margin="0,0,20,0" FontSize="14" VerticalContentAlignment="Center"/>
                    <RadioButton x:Name="RadioPurchase" Content="매입"
                                 Checked="ImportType_Checked" Tag="Purchase"
                                 FontSize="14" VerticalContentAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Step 2: File Selection -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource Tran.Neutral.50}"
                CornerRadius="8" Padding="15,12"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="2단계: Excel 파일 선택" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Text="{Binding SelectedFilePath, Mode=OneWay}"
                             IsReadOnly="True"
                             VerticalContentAlignment="Center"
                             Height="36" FontSize="13"
                             Padding="10,0"
                             Margin="0,0,10,0"/>
                    <Button Grid.Column="1"
                            Content="파일 선택"
                            Command="{Binding SelectFileCommand}"
                            Style="{StaticResource Tran.SecondaryButton}"
                            Height="36" Padding="20,0"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Statistics Bar -->
        <Border DockPanel.Dock="Top"
                Background="White"
                BorderBrush="{StaticResource Tran.Neutral.200}"
                BorderThickness="0,0,0,1"
                Padding="0,8,0,12"
                Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,20,0">
                    <TextBlock Text="총 " FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalRows}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="건" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,20,0">
                    <Border Background="#E6F4EA" CornerRadius="3" Padding="8,3">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="유효 " FontSize="12" Foreground="#1E7F34"/>
                            <TextBlock Text="{Binding ValidRows}" FontSize="12" FontWeight="Bold" Foreground="#1E7F34"/>
                            <TextBlock Text="건" FontSize="12" Foreground="#1E7F34"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,20,0">
                    <Border Background="#FFEBEE" CornerRadius="3" Padding="8,3">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="오류 " FontSize="12" Foreground="#D32F2F"/>
                            <TextBlock Text="{Binding InvalidRows}" FontSize="12" FontWeight="Bold" Foreground="#D32F2F"/>
                            <TextBlock Text="건" FontSize="12" Foreground="#D32F2F"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="0,0,20,0">
                    <Border Background="#FFF4E5" CornerRadius="3" Padding="8,3">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="건너뜀 " FontSize="12" Foreground="#E67700"/>
                            <TextBlock Text="{Binding SkippedRows}" FontSize="12" FontWeight="Bold" Foreground="#E67700"/>
                            <TextBlock Text="건" FontSize="12" Foreground="#E67700"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <CheckBox Grid.Column="5"
                          Content="오류행만 표시"
                          IsChecked="{Binding ShowErrorsOnly}"
                          VerticalAlignment="Center"
                          FontSize="12"/>
            </Grid>
        </Border>

        <!-- Bottom Bar: Status + Buttons -->
        <Border DockPanel.Dock="Bottom" Padding="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           FontSize="12"
                           Foreground="{StaticResource Tran.Neutral.600}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>

                <Button Grid.Column="1"
                        Content="가져오기"
                        Command="{Binding ImportCommand}"
                        Style="{StaticResource Tran.SuccessButton}"
                        Height="36" Padding="25,0"
                        Margin="0,0,10,0"/>

                <Button Grid.Column="2"
                        Content="닫기"
                        Click="Close_Click"
                        Style="{StaticResource Tran.SecondaryButton}"
                        Height="36" Padding="25,0"/>
            </Grid>
        </Border>

        <!-- Preview DataGrid -->
        <DataGrid ItemsSource="{Binding PreviewRows}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  BorderThickness="1"
                  BorderBrush="{StaticResource Tran.Neutral.200}"
                  RowHeaderWidth="0"
                  FontSize="13"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="행" Binding="{Binding RowNumber}" Width="50">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Foreground" Value="{StaticResource Tran.Neutral.500}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTemplateColumn Header="상태" Width="50">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StatusIcon}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="16" FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#1E7F34"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="Invalid">
                                                <Setter Property="Foreground" Value="#D32F2F"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Skipped">
                                                <Setter Property="Foreground" Value="#E67700"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="데이터" Binding="{Binding DataSummary}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="5,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="오류 메시지" Binding="{Binding ErrorMessage}" Width="200">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Foreground" Value="#D32F2F"/>
                            <Setter Property="Padding" Value="5,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
