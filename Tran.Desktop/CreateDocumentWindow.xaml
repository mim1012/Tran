<Window x:Class="Tran.Desktop.CreateDocumentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="거래명세표 작성" Height="700" Width="1000"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Tran.Surface.Background}"
        FontFamily="{StaticResource Tran.FontFamily}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 헤더 영역 -->
        <Border Grid.Row="0" Background="{StaticResource Tran.Neutral.50}" Padding="20" BorderBrush="{StaticResource Tran.Neutral.200}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="새 거래명세표 작성" FontSize="20" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBlock Text="거래명세표를 작성하고 임시 저장하거나 즉시 전송할 수 있습니다"
                         Foreground="{StaticResource Tran.Neutral.500}" FontSize="13"/>
            </StackPanel>
        </Border>

        <!-- 문서 기본 정보 -->
        <Border Grid.Row="1" Padding="20" Background="{StaticResource Tran.Surface.Background}" BorderBrush="{StaticResource Tran.Neutral.200}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 발신 거래처 -->
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,15,0">
                    <TextBlock Text="발신 거래처" FontWeight="Bold" Foreground="{StaticResource Tran.Neutral.500}" Margin="0,0,0,8"/>
                    <ComboBox ItemsSource="{Binding AvailableFromCompanies}"
                            SelectedItem="{Binding SelectedFromCompany}"
                            DisplayMemberPath="CompanyName"
                            Height="36"
                            Padding="10,8"
                            FontSize="14"/>
                </StackPanel>

                <!-- 수신 거래처 -->
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,15,0">
                    <TextBlock Text="수신 거래처 *" FontWeight="Bold" Foreground="{StaticResource Tran.Neutral.500}" Margin="0,0,0,8"/>
                    <ComboBox ItemsSource="{Binding AvailableToCompanies}"
                            SelectedItem="{Binding SelectedToCompany}"
                            DisplayMemberPath="CompanyName"
                            Height="36"
                            Padding="10,8"
                            FontSize="14"/>
                </StackPanel>

                <!-- 거래일자 -->
                <StackPanel Grid.Row="0" Grid.Column="2">
                    <TextBlock Text="거래일자 *" FontWeight="Bold" Foreground="{StaticResource Tran.Neutral.500}" Margin="0,0,0,8"/>
                    <DatePicker SelectedDate="{Binding TransactionDate}"
                              Height="36"
                              Padding="10,8"
                              FontSize="14"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 품목 목록 -->
        <Border Grid.Row="2" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 품목 헤더 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                    <TextBlock Text="품목 내역" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Button Content="+ 품목 추가"
                           Command="{Binding AddItemCommand}"
                           Style="{StaticResource Tran.PrimaryButton}"
                           Padding="15,8" Margin="20,0,0,0"/>
                </StackPanel>

                <!-- 품목 DataGrid -->
                <DataGrid Grid.Row="1"
                         ItemsSource="{Binding Items}"
                         AutoGenerateColumns="False"
                         CanUserAddRows="False"
                         CanUserDeleteRows="False"
                         RowHeaderWidth="0"
                         GridLinesVisibility="Horizontal"
                         BorderBrush="{StaticResource Tran.Neutral.200}"
                         BorderThickness="1"
                         HeadersVisibility="Column"
                         Background="White">

                    <DataGrid.Columns>
                        <!-- 품명 -->
                        <DataGridTextColumn Header="품명" Binding="{Binding ItemName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="2*" IsReadOnly="False"/>

                        <!-- 옵션/비고 -->
                        <DataGridTextColumn Header="옵션/비고" Binding="{Binding OptionText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="1.5*" IsReadOnly="False"/>

                        <!-- 수량 -->
                        <DataGridTextColumn Header="수량" Binding="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="*" IsReadOnly="False">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Right"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- 단가 -->
                        <DataGridTextColumn Header="단가" Binding="{Binding UnitPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N0}}" Width="1.2*" IsReadOnly="False">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Right"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- 금액 (계산됨) -->
                        <DataGridTextColumn Header="금액" Binding="{Binding LineAmount, StringFormat={}{0:N0}, Mode=OneWay}" Width="1.5*" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Right"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="{StaticResource Tran.State.Sent.Fg}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- 규격 입력 버튼 -->
                        <DataGridTemplateColumn Header="규격" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding SpecSummary}"
                                           ToolTip="{Binding SpecTooltip}"
                                           Command="{Binding DataContext.EditSpecCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                           CommandParameter="{Binding}"
                                           Style="{StaticResource Tran.PurchaseButton}"
                                           Padding="10,5"
                                           FontSize="12"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 삭제 버튼 -->
                        <DataGridTemplateColumn Header="" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="삭제"
                                           Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                           CommandParameter="{Binding}"
                                           Style="{StaticResource Tran.DestructiveButton}"
                                           Padding="10,5"
                                           FontSize="12"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- 합계 금액 -->
        <Border Grid.Row="3" Background="{StaticResource Tran.Neutral.100}" Padding="20" BorderBrush="{StaticResource Tran.Neutral.200}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="총 금액"
                         FontSize="18" FontWeight="Bold"
                         VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                         FontSize="24" FontWeight="Bold" Foreground="{StaticResource Tran.State.Sent.Fg}">
                    <Run Text="{Binding TotalAmount, StringFormat={}{0:N0}, Mode=OneWay}"/>
                    <Run Text="원"/>
                </TextBlock>
            </Grid>
        </Border>

        <!-- 하단 버튼 영역 -->
        <Border Grid.Row="4" Background="{StaticResource Tran.Neutral.50}" Padding="20" BorderBrush="{StaticResource Tran.Neutral.200}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <!-- 임시 저장 버튼 (Draft) -->
                <Button Content="임시 저장"
                       Command="{Binding SaveDraftCommand}"
                       Style="{StaticResource Tran.SecondaryButton}"
                       Padding="25,12" Margin="0,0,10,0"
                       FontSize="14"/>

                <!-- 저장 후 전송 버튼 (Draft → Sent) -->
                <Button Content="저장 후 전송"
                       Command="{Binding SaveAndSendCommand}"
                       Style="{StaticResource Tran.PrimaryButton}"
                       Padding="25,12" Margin="0,0,10,0"
                       FontSize="14"/>

                <!-- 취소 버튼 -->
                <Button Content="취소"
                       Command="{Binding CancelCommand}"
                       CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                       Style="{StaticResource Tran.GhostButton}"
                       Padding="25,12"
                       FontSize="14"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
