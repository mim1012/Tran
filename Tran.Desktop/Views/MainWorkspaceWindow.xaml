<Window x:Class="Tran.Desktop.Views.MainWorkspaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Tran.Desktop.Views"
        mc:Ignorable="d"
        Title="{Binding WindowTitle, FallbackValue='Tran - 작업 화면'}"
        Width="1400" Height="900"
        WindowStartupLocation="CenterScreen"
        Background="White">

    <DockPanel LastChildFill="True">

        <!-- 상단 바: 거래처 정보 + 거래처 변경 -->
        <Border DockPanel.Dock="Top" Background="#2C3E50" Padding="15,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 거래처명 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CompanyName, FallbackValue='거래처명'}"
                               FontSize="18" FontWeight="Bold"
                               Foreground="White"
                               VerticalAlignment="Center"/>
                    <Border Background="#3498DB" CornerRadius="4"
                            Padding="8,3" Margin="12,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding CompanyType, FallbackValue='고객사'}"
                                   Foreground="White" FontSize="11"/>
                    </Border>
                </StackPanel>

                <!-- 오늘 처리 건수 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="오늘: " Foreground="#BDC3C7" FontSize="13"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TodayDocumentCount, FallbackValue='0'}"
                               Foreground="White" FontSize="13" FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="건" Foreground="#BDC3C7" FontSize="13"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 구분선 -->
                <Border Grid.Column="3" Width="1" Background="#4A6072"
                        Margin="0,3,15,3"/>

                <!-- 거래처 변경 버튼 -->
                <Button Grid.Column="4"
                        Content="거래처 변경"
                        Click="ChangeCompany_Click"
                        Height="32" Padding="15,0"
                        FontSize="13" Foreground="White"
                        Background="#95A5A6"
                        BorderThickness="0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="4"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- 하단 상태바 -->
        <Border DockPanel.Dock="Bottom" Background="#ECF0F1" Padding="15,8"
                BorderBrush="#BDC3C7" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage, FallbackValue='준비'}"
                           FontSize="12" Foreground="#666"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1"
                           Text="연결 상태: 정상" Foreground="#27AE60"
                           FontSize="12" VerticalAlignment="Center"
                           Margin="0,0,20,0"/>

                <TextBlock Grid.Column="2" FontSize="12" Foreground="#95A5A6"
                           VerticalAlignment="Center">
                    <Run Text="Tran v1.0"/>
                </TextBlock>
            </Grid>
        </Border>

        <!-- 탭 컨트롤 (메인 작업 영역) -->
        <TabControl Name="MainTabControl"
                    SelectedIndex="{Binding SelectedTabIndex}"
                    Padding="0" BorderThickness="0"
                    Background="White">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Padding" Value="15,10"/>
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Foreground" Value="#666"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="TabBorder"
                                        Padding="{TemplateBinding Padding}"
                                        Background="Transparent"
                                        BorderThickness="0,0,0,3"
                                        BorderBrush="Transparent">
                                    <ContentPresenter ContentSource="Header"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="TabBorder" Property="Background" Value="#F0F7FF"/>
                                        <Setter Property="Foreground" Value="#1E90FF"/>
                                        <Setter TargetName="TabBorder" Property="BorderBrush" Value="#1E90FF"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="TabBorder" Property="Background" Value="#F8F9FA"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- Tab 0: 발주 -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x1F4E5;" Margin="0,0,5,0"/>
                        <TextBlock Text="발주"/>
                    </StackPanel>
                </TabItem.Header>
                <local:OrderView DataContext="{Binding OrderVM}"/>
            </TabItem>

            <!-- Tab 1: 견적 -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x1F4CB;" Margin="0,0,5,0"/>
                        <TextBlock Text="견적"/>
                    </StackPanel>
                </TabItem.Header>
                <local:QuotationView DataContext="{Binding QuotationVM}"/>
            </TabItem>

            <!-- Tab 2: 구매 -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x1F4E6;" Margin="0,0,5,0"/>
                        <TextBlock Text="구매"/>
                    </StackPanel>
                </TabItem.Header>
                <local:PurchaseView DataContext="{Binding PurchaseVM}"/>
            </TabItem>

            <!-- Tab 3: 판매 -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x1F4E4;" Margin="0,0,5,0"/>
                        <TextBlock Text="판매"/>
                    </StackPanel>
                </TabItem.Header>
                <local:SaleView DataContext="{Binding SaleVM}"/>
            </TabItem>

            <!-- Tab 4: 재고 -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x1F4CA;" Margin="0,0,5,0"/>
                        <TextBlock Text="재고"/>
                    </StackPanel>
                </TabItem.Header>
                <local:InventoryView DataContext="{Binding InventoryVM}"/>
            </TabItem>

            <!-- Tab 5: 품목 -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x1F3F7;" Margin="0,0,5,0"/>
                        <TextBlock Text="품목"/>
                    </StackPanel>
                </TabItem.Header>
                <local:ProductManagementView DataContext="{Binding ProductVM}"/>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
