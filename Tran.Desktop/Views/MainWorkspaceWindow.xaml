<Window x:Class="Tran.Desktop.Views.MainWorkspaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Tran.Desktop.Views"
        mc:Ignorable="d"
        Title="{Binding WindowTitle, FallbackValue='Tran - 작업 화면'}"
        Width="1400" Height="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Tran.Surface.Background}"
        FontFamily="{StaticResource Tran.FontFamily}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </Window.Resources>

    <DockPanel LastChildFill="True">

        <!-- ============================================ -->
        <!-- 거래처 탭 바 (다크 네이비 배경)               -->
        <!-- 피플카 스타일: 상단 탭 시스템                  -->
        <!-- ============================================ -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Tran.Primary.900}" Padding="8,0">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Content="+ 거래처"
                        Command="{Binding AddCompanyCommand}"
                        Style="{StaticResource Tran.GhostButton}"
                        Foreground="{StaticResource Tran.Sidebar.Text.Secondary}"
                        FontSize="12" Padding="14,6" Margin="5,4"/>

                <!-- 품목관리 고정 탭 -->
                <Border DockPanel.Dock="Left" Margin="2,4" Padding="12,6" CornerRadius="6,6,0,0"
                        Cursor="Hand" MouseLeftButtonDown="ProductManagementTab_Click">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="Transparent"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsProductManagementMode}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource Tran.Accent.Blue}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="&#x1F3F7; 품목관리" Foreground="White"
                               FontSize="12.5" FontWeight="Medium"
                               VerticalAlignment="Center"/>
                </Border>

                <!-- 구분선 -->
                <Border DockPanel.Dock="Left" Width="1" Background="{StaticResource Tran.Primary.500}"
                        Margin="4,8"/>

                <ItemsControl ItemsSource="{Binding CompanyWorkspaces}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="2,4" Padding="12,6" CornerRadius="6,6,0,0" Cursor="Hand"
                                    MouseLeftButtonDown="CompanyTab_Click">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource Tran.Accent.Blue}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding CompanyName}" Foreground="White"
                                               FontSize="12.5" FontWeight="Medium"
                                               VerticalAlignment="Center"/>
                                    <Button Content="&#xD7;" FontSize="12"
                                            Command="{Binding DataContext.CloseCompanyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource Tran.GhostButton}"
                                            Foreground="{StaticResource Tran.Sidebar.Text.Secondary}"
                                            Padding="6,0" Margin="8,0,0,0"
                                            VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- ============================================ -->
        <!-- 하단 상태바                                   -->
        <!-- ============================================ -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Tran.Surface.Footer}" Padding="20,8"
                BorderBrush="{StaticResource Tran.Border.Light}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage, FallbackValue='준비'}"
                           FontSize="12" Foreground="{StaticResource Tran.Text.Secondary}"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <Ellipse Width="6" Height="6" Fill="{StaticResource Tran.Success}" Margin="0,0,6,0"/>
                    <TextBlock Text="연결 상태: 정상" Foreground="{StaticResource Tran.Success}"
                               FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Grid.Column="2" FontSize="12" Foreground="{StaticResource Tran.Text.Disabled}"
                           VerticalAlignment="Center">
                    <Run Text="Tran v1.0"/>
                </TextBlock>
            </Grid>
        </Border>

        <!-- ============================================ -->
        <!-- 메인 콘텐츠 영역                              -->
        <!-- ============================================ -->
        <Grid>
            <!-- 거래처 워크스페이스 모드 -->
            <DockPanel Visibility="{Binding IsCompanyWorkspaceMode, Converter={StaticResource BoolToVisConverter}}">

                <!-- 상단 바: 거래처 정보 (흰색 배경, 피플카 스타일) -->
                <Border DockPanel.Dock="Top" Background="{StaticResource Tran.Surface.Header}" 
                        Padding="20,12" BorderBrush="{StaticResource Tran.Border.Light}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- 거래처명 -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CompanyName, FallbackValue='거래처명'}"
                                       FontSize="18" FontWeight="Bold"
                                       Foreground="{StaticResource Tran.Text.Primary}"
                                       VerticalAlignment="Center"/>
                            <Border Background="{StaticResource Tran.Accent.Blue}" CornerRadius="6"
                                    Padding="10,4" Margin="12,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding CompanyType, FallbackValue='고객사'}"
                                           Foreground="White" FontSize="11" FontWeight="Medium"/>
                            </Border>
                        </StackPanel>

                        <!-- 오늘 처리 건수 -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                    VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="오늘: " Foreground="{StaticResource Tran.Text.Secondary}" FontSize="13"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TodayDocumentCount, FallbackValue='0'}"
                                       Foreground="{StaticResource Tran.Accent.Blue}" FontSize="13" FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="건" Foreground="{StaticResource Tran.Text.Secondary}" FontSize="13"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- 데이터 가져오기 버튼 -->
                        <Button Grid.Column="3"
                                Content="데이터 가져오기"
                                Style="{StaticResource Tran.SecondaryButton}"
                                Click="OpenDataImport_Click"
                                Height="34" Padding="16,0"
                                Margin="0,0,10,0"/>

                        <!-- 구분선 -->
                        <Border Grid.Column="4" Width="1" Background="{StaticResource Tran.Border.Light}"
                                Margin="0,4,15,4"/>

                        <!-- 거래처 추가 버튼 -->
                        <Button Grid.Column="5"
                                Content="+ 거래처 추가"
                                Style="{StaticResource Tran.PrimaryButton}"
                                Click="AddCompany_Click"
                                Height="34" Padding="16,0"/>
                    </Grid>
                </Border>

                <!-- 탭 컨트롤 (메인 작업 영역) -->
                <TabControl Name="MainTabControl"
                            SelectedIndex="{Binding SelectedTabIndex}"
                            Padding="0" BorderThickness="0"
                            Background="{StaticResource Tran.Surface.Background}">

                    <!-- Tab 0: 발주 -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x1F4E5;" Margin="0,0,5,0"/>
                                <TextBlock Text="발주"/>
                            </StackPanel>
                        </TabItem.Header>
                        <local:OrderView DataContext="{Binding OrderVM}"/>
                    </TabItem>

                    <!-- Tab 1: 견적 -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x1F4CB;" Margin="0,0,5,0"/>
                                <TextBlock Text="견적"/>
                            </StackPanel>
                        </TabItem.Header>
                        <local:QuotationView DataContext="{Binding QuotationVM}"/>
                    </TabItem>

                    <!-- Tab 2: 구매 -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x1F4E6;" Margin="0,0,5,0"/>
                                <TextBlock Text="구매"/>
                            </StackPanel>
                        </TabItem.Header>
                        <local:PurchaseView DataContext="{Binding PurchaseVM}"/>
                    </TabItem>

                    <!-- Tab 3: 판매 -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x1F4E4;" Margin="0,0,5,0"/>
                                <TextBlock Text="판매"/>
                            </StackPanel>
                        </TabItem.Header>
                        <local:SaleView DataContext="{Binding SaleVM}"/>
                    </TabItem>

                    <!-- Tab 4: 재고 -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x1F4CA;" Margin="0,0,5,0"/>
                                <TextBlock Text="재고"/>
                            </StackPanel>
                        </TabItem.Header>
                        <local:InventoryView DataContext="{Binding InventoryVM}"/>
                    </TabItem>

                    <!-- Tab 5: 통계 -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x1F4C8;" Margin="0,0,5,0"/>
                                <TextBlock Text="통계"/>
                            </StackPanel>
                        </TabItem.Header>
                        <local:SalesStatisticsView DataContext="{Binding SalesStatisticsVM}"/>
                    </TabItem>
                </TabControl>
            </DockPanel>

            <!-- 품목관리 모드 -->
            <local:ProductManagementView DataContext="{Binding GlobalProductVM}"
                Visibility="{Binding IsProductManagementMode, Converter={StaticResource BoolToVisConverter}}"/>
        </Grid>
    </DockPanel>
</Window>
