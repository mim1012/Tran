<mah:MetroWindow x:Class="Tran.Desktop.Views.MainWorkspaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Tran.Desktop.Views"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="{Binding WindowTitle, FallbackValue='Tran - 작업 화면'}"
        Width="1400" Height="900"
        MinWidth="720" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        TitleCharacterCasing="Normal"
        ShowTitleBar="False"
        GlowBrush="{StaticResource Tran.Primary.500}"
        BorderThickness="1"
        WindowTransitionsEnabled="False"
        SaveWindowPosition="True"
        Background="{StaticResource Tran.Surface.Background}"
        FontFamily="{StaticResource Tran.FontFamily}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </Window.Resources>

    <DockPanel LastChildFill="True">

        <!-- TOP: Company Tab Bar (44px, Dark Navy) -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Tran.Surface.Header}" Height="44">
            <DockPanel Margin="8,0">
                <!-- Logo -->
                <TextBlock DockPanel.Dock="Left" Text="Tran"
                           Foreground="White" FontSize="15" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="8,0,16,0"/>

                <!-- Separator -->
                <Border DockPanel.Dock="Left" Width="1" Background="{StaticResource Tran.Sidebar.Divider}"
                        Margin="0,10"/>

                <!-- Add Company button -->
                <Button DockPanel.Dock="Right"
                        Content="+ 거래처"
                        Command="{Binding AddCompanyCommand}"
                        Style="{StaticResource Tran.GhostButton}"
                        Foreground="{StaticResource Tran.Sidebar.Text}"
                        FontSize="12" Padding="12,0" Height="30" Margin="5,0"/>

                <!-- Data Import button -->
                <Button DockPanel.Dock="Right"
                        Content="데이터 가져오기"
                        Style="{StaticResource Tran.GhostButton}"
                        Click="OpenDataImport_Click"
                        Foreground="{StaticResource Tran.Sidebar.Text}"
                        FontSize="12" Padding="12,0" Height="30" Margin="5,0"/>

                <!-- Company Tabs -->
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                              Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <!-- Product Management Fixed Tab -->
                        <Border Margin="2,6" Padding="10,0" CornerRadius="4" Height="32"
                                Cursor="Hand" MouseLeftButtonDown="ProductManagementTab_Click">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsProductManagementMode}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource Tran.Sidebar.ItemActive}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="TagOutline"
                                      Foreground="{StaticResource Tran.Sidebar.Text}"
                                      Width="13" Height="13"
                                      VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="품목관리" Foreground="White"
                                           FontSize="12" FontWeight="Medium"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Separator -->
                        <Border Width="1" Background="{StaticResource Tran.Sidebar.Divider}"
                                Margin="4,10"/>

                        <!-- Company Workspace Tabs -->
                        <ItemsControl ItemsSource="{Binding CompanyWorkspaces}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="2,6" Padding="10,0" CornerRadius="4" Height="32"
                                            Cursor="Hand" MouseLeftButtonDown="CompanyTab_Click">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource Tran.Sidebar.ItemActive}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CompanyName}" Foreground="White"
                                                       FontSize="12" FontWeight="Medium"
                                                       VerticalAlignment="Center"/>
                                            <Button Content="x" FontSize="11"
                                                    Command="{Binding DataContext.CloseCompanyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource Tran.GhostButton}"
                                                    Foreground="{StaticResource Tran.Sidebar.Text}"
                                                    Padding="4,0" Margin="8,0,0,0" Height="20" Width="20"
                                                    VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- BOTTOM: Status Bar (32px) -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Tran.Surface.Footer}" Padding="15,6"
                BorderBrush="{StaticResource Tran.Neutral.200}" BorderThickness="0,1,0,0" Height="32">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage, FallbackValue='준비'}"
                           FontSize="11" Foreground="{StaticResource Tran.Neutral.500}"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1"
                           Text="연결 상태: 정상" Foreground="{StaticResource Tran.Success}"
                           FontSize="11" VerticalAlignment="Center"
                           Margin="0,0,20,0"/>

                <TextBlock Grid.Column="2" FontSize="11" Foreground="{StaticResource Tran.Neutral.400}"
                           VerticalAlignment="Center">
                    <Run Text="Tran v1.0"/>
                </TextBlock>
            </Grid>
        </Border>

        <!-- MAIN AREA: Sidebar + Content -->
        <Grid>
            <!-- Company Workspace Mode -->
            <Grid Visibility="{Binding IsCompanyWorkspaceMode, Converter={StaticResource BoolToVisConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT SIDEBAR (Responsive: 200px ↔ 52px) -->
                <Border Grid.Column="0" Background="{StaticResource Tran.Sidebar.Background}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Width" Value="200"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                    <Setter Property="Width" Value="52"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel>
                        <!-- Toggle Button + Company Info Header -->
                        <Border DockPanel.Dock="Top" Padding="8,10"
                                BorderBrush="{StaticResource Tran.Sidebar.Divider}" BorderThickness="0,0,0,1">
                            <DockPanel>
                                <!-- Toggle Sidebar Button -->
                                <Button DockPanel.Dock="Left" Click="ToggleSidebar_Click" Cursor="Hand"
                                        ToolTip="사이드바 접기/펼치기">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="toggleBg" Background="Transparent"
                                                    CornerRadius="4" Width="36" Height="36">
                                                <materialDesign:PackIcon Kind="Menu"
                                                      Foreground="{StaticResource Tran.Sidebar.Text}"
                                                      Width="16" Height="16"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="toggleBg" Property="Background"
                                                            Value="{StaticResource Tran.Sidebar.ItemHover}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- Company Info (hidden when collapsed) -->
                                <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="{Binding CompanyName, FallbackValue='거래처명'}"
                                               Foreground="White" FontSize="13" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="오늘: " Foreground="{StaticResource Tran.Sidebar.Text}" FontSize="10"/>
                                        <TextBlock Text="{Binding TodayDocumentCount, FallbackValue='0'}"
                                                   Foreground="White" FontSize="10" FontWeight="SemiBold"/>
                                        <TextBlock Text="건" Foreground="{StaticResource Tran.Sidebar.Text}" FontSize="10"/>
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Bottom Management Section -->
                        <StackPanel DockPanel.Dock="Bottom" Margin="6,6">
                            <Border Height="1" Background="{StaticResource Tran.Sidebar.Divider}" Margin="4,0,4,6"/>

                            <!-- 거래명세표 (Tag 6) -->
                            <Button Click="SidebarItem_Click" Tag="6" Cursor="Hand" ToolTip="거래명세표">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bg" Background="Transparent" CornerRadius="4" Padding="12,8">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon x:Name="icon" Kind="FileDocumentOutline"
                                                      Foreground="{StaticResource Tran.Sidebar.Text}"
                                                      Width="16" Height="16" Margin="0,0,10,0"
                                                      VerticalAlignment="Center"/>
                                                <TextBlock x:Name="label" Text="거래명세표"
                                                           Foreground="{StaticResource Tran.Sidebar.Text}" FontSize="12"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bg" Property="Background" Value="{StaticResource Tran.Sidebar.ItemHover}"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                                <Setter TargetName="label" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="icon" Property="Margin" Value="0"/>
                                                <Setter TargetName="bg" Property="Padding" Value="0,8"/>
                                                <Setter TargetName="bg" Property="HorizontalAlignment" Value="Center"/>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- 거래처관리 (Tag 7) -->
                            <Button Click="SidebarItem_Click" Tag="7" Cursor="Hand" ToolTip="거래처관리">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bg" Background="Transparent" CornerRadius="4" Padding="12,8">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon x:Name="icon" Kind="AccountGroupOutline"
                                                      Foreground="{StaticResource Tran.Sidebar.Text}"
                                                      Width="16" Height="16" Margin="0,0,10,0"
                                                      VerticalAlignment="Center"/>
                                                <TextBlock x:Name="label" Text="거래처관리"
                                                           Foreground="{StaticResource Tran.Sidebar.Text}" FontSize="12"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bg" Property="Background" Value="{StaticResource Tran.Sidebar.ItemHover}"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                                <Setter TargetName="label" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="icon" Property="Margin" Value="0"/>
                                                <Setter TargetName="bg" Property="Padding" Value="0,8"/>
                                                <Setter TargetName="bg" Property="HorizontalAlignment" Value="Center"/>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- 정산관리 (Tag 8) -->
                            <Button Click="SidebarItem_Click" Tag="8" Cursor="Hand" ToolTip="정산관리">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bg" Background="Transparent" CornerRadius="4" Padding="12,8">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon x:Name="icon" Kind="Calculator"
                                                      Foreground="{StaticResource Tran.Sidebar.Text}"
                                                      Width="16" Height="16" Margin="0,0,10,0"
                                                      VerticalAlignment="Center"/>
                                                <TextBlock x:Name="label" Text="정산관리"
                                                           Foreground="{StaticResource Tran.Sidebar.Text}" FontSize="12"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bg" Property="Background" Value="{StaticResource Tran.Sidebar.ItemHover}"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                                <Setter TargetName="label" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="icon" Property="Margin" Value="0"/>
                                                <Setter TargetName="bg" Property="Padding" Value="0,8"/>
                                                <Setter TargetName="bg" Property="HorizontalAlignment" Value="Center"/>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- 양식관리 (Tag 9) -->
                            <Button Click="SidebarItem_Click" Tag="9" Cursor="Hand" ToolTip="양식관리">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bg" Background="Transparent" CornerRadius="4" Padding="12,8">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon x:Name="icon" Kind="FileDocumentEditOutline"
                                                      Foreground="{StaticResource Tran.Sidebar.Text}"
                                                      Width="16" Height="16" Margin="0,0,10,0"
                                                      VerticalAlignment="Center"/>
                                                <TextBlock x:Name="label" Text="양식관리"
                                                           Foreground="{StaticResource Tran.Sidebar.Text}" FontSize="12"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bg" Property="Background" Value="{StaticResource Tran.Sidebar.ItemHover}"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                                <Setter TargetName="label" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="icon" Property="Margin" Value="0"/>
                                                <Setter TargetName="bg" Property="Padding" Value="0,8"/>
                                                <Setter TargetName="bg" Property="HorizontalAlignment" Value="Center"/>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>

                        <!-- Main Navigation Items -->
                        <StackPanel Margin="6,6">
                            <!-- ERP Module Label -->
                            <TextBlock Text="ERP 모듈" Foreground="{StaticResource Tran.Sidebar.Text}"
                                       FontSize="10" FontWeight="SemiBold" Margin="12,8,0,8"
                                       Opacity="0.6">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- 발주 (Tab 0) -->
                            <Button Click="SidebarItem_Click" Tag="0" Cursor="Hand" ToolTip="발주">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bg" CornerRadius="4" Padding="12,9">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.SelectedTabIndex, RelativeSource={RelativeSource AncestorType=Window}}" Value="0">
                                                            <Setter Property="Background" Value="{StaticResource Tran.Sidebar.ItemActive}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon x:Name="icon" Kind="FileDocumentOutline"
                                                      Width="16" Height="16" Margin="0,0,10,0"
                                                      VerticalAlignment="Center">
                                                    <materialDesign:PackIcon.Style>
                                                        <Style TargetType="materialDesign:PackIcon">
                                                            <Setter Property="Foreground" Value="{StaticResource Tran.Sidebar.Text}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DataContext.SelectedTabIndex, RelativeSource={RelativeSource AncestorType=Window}}" Value="0">
                                                                    <Setter Property="Foreground" Value="White"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </materialDesign:PackIcon.Style>
                                                </materialDesign:PackIcon>
                                                <TextBlock x:Name="label" Text="발주" FontSize="13">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource Tran.Sidebar.Text}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DataContext.SelectedTabIndex, RelativeSource={RelativeSource AncestorType=Window}}" Value="0">
                                                                    <Setter Property="Foreground" Value="White"/>
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bg" Property="Background" Value="{StaticResource Tran.Sidebar.ItemHover}"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                                <Setter TargetName="label" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="icon" Property="Margin" Value="0"/>
                                                <Setter TargetName="bg" Property="Padding" Value="0,9"/>
                                                <Setter TargetName="bg" Property="HorizontalAlignment" Value="Center"/>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- 견적 (Tab 1) -->
                            <Button Click="SidebarItem_Click" Tag="1" Cursor="Hand" ToolTip="견적">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bg" CornerRadius="4" Padding="12,9">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.SelectedTabIndex, RelativeSource={RelativeSource AncestorType=Window}}" Value="1">
                                                            <Setter Property="Background" Value="{StaticResource Tran.Sidebar.ItemActive}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon x:Name="icon" Kind="ClipboardTextOutline"
                                                      Foreground="{StaticResource Tran.Sidebar.Text}"
                                                      Width="16" Height="16" Margin="0,0,10,0"
                                                      VerticalAlignment="Center"/>
                                                <TextBlock x:Name="label" Text="견적" FontSize="13"
                                                           Foreground="{StaticResource Tran.Sidebar.Text}"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bg" Property="Background" Value="{StaticResource Tran.Sidebar.ItemHover}"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                                <Setter TargetName="label" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="icon" Property="Margin" Value="0"/>
                                                <Setter TargetName="bg" Property="Padding" Value="0,9"/>
                                                <Setter TargetName="bg" Property="HorizontalAlignment" Value="Center"/>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- 구매 (Tab 2) -->
                            <Button Click="SidebarItem_Click" Tag="2" Cursor="Hand" ToolTip="구매">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bg" CornerRadius="4" Padding="12,9">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.SelectedTabIndex, RelativeSource={RelativeSource AncestorType=Window}}" Value="2">
                                                            <Setter Property="Background" Value="{StaticResource Tran.Sidebar.ItemActive}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon x:Name="icon" Kind="PackageVariant"
                                                      Foreground="{StaticResource Tran.Sidebar.Text}"
                                                      Width="16" Height="16" Margin="0,0,10,0"
                                                      VerticalAlignment="Center"/>
                                                <TextBlock x:Name="label" Text="구매" FontSize="13"
                                                           Foreground="{StaticResource Tran.Sidebar.Text}"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bg" Property="Background" Value="{StaticResource Tran.Sidebar.ItemHover}"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                                <Setter TargetName="label" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="icon" Property="Margin" Value="0"/>
                                                <Setter TargetName="bg" Property="Padding" Value="0,9"/>
                                                <Setter TargetName="bg" Property="HorizontalAlignment" Value="Center"/>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- 판매 (Tab 3) -->
                            <Button Click="SidebarItem_Click" Tag="3" Cursor="Hand" ToolTip="판매">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bg" CornerRadius="4" Padding="12,9">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.SelectedTabIndex, RelativeSource={RelativeSource AncestorType=Window}}" Value="3">
                                                            <Setter Property="Background" Value="{StaticResource Tran.Sidebar.ItemActive}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon x:Name="icon" Kind="CurrencyUsd"
                                                      Foreground="{StaticResource Tran.Sidebar.Text}"
                                                      Width="16" Height="16" Margin="0,0,10,0"
                                                      VerticalAlignment="Center"/>
                                                <TextBlock x:Name="label" Text="판매" FontSize="13"
                                                           Foreground="{StaticResource Tran.Sidebar.Text}"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bg" Property="Background" Value="{StaticResource Tran.Sidebar.ItemHover}"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                                <Setter TargetName="label" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="icon" Property="Margin" Value="0"/>
                                                <Setter TargetName="bg" Property="Padding" Value="0,9"/>
                                                <Setter TargetName="bg" Property="HorizontalAlignment" Value="Center"/>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- 재고 (Tab 4) -->
                            <Button Click="SidebarItem_Click" Tag="4" Cursor="Hand" ToolTip="재고">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bg" CornerRadius="4" Padding="12,9">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.SelectedTabIndex, RelativeSource={RelativeSource AncestorType=Window}}" Value="4">
                                                            <Setter Property="Background" Value="{StaticResource Tran.Sidebar.ItemActive}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon x:Name="icon" Kind="Warehouse"
                                                      Foreground="{StaticResource Tran.Sidebar.Text}"
                                                      Width="16" Height="16" Margin="0,0,10,0"
                                                      VerticalAlignment="Center"/>
                                                <TextBlock x:Name="label" Text="재고" FontSize="13"
                                                           Foreground="{StaticResource Tran.Sidebar.Text}"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bg" Property="Background" Value="{StaticResource Tran.Sidebar.ItemHover}"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                                <Setter TargetName="label" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="icon" Property="Margin" Value="0"/>
                                                <Setter TargetName="bg" Property="Padding" Value="0,9"/>
                                                <Setter TargetName="bg" Property="HorizontalAlignment" Value="Center"/>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- 통계 (Tab 5) -->
                            <Button Click="SidebarItem_Click" Tag="5" Cursor="Hand" ToolTip="통계">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bg" CornerRadius="4" Padding="12,9">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.SelectedTabIndex, RelativeSource={RelativeSource AncestorType=Window}}" Value="5">
                                                            <Setter Property="Background" Value="{StaticResource Tran.Sidebar.ItemActive}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon x:Name="icon" Kind="ChartBar"
                                                      Foreground="{StaticResource Tran.Sidebar.Text}"
                                                      Width="16" Height="16" Margin="0,0,10,0"
                                                      VerticalAlignment="Center"/>
                                                <TextBlock x:Name="label" Text="통계" FontSize="13"
                                                           Foreground="{StaticResource Tran.Sidebar.Text}"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bg" Property="Background" Value="{StaticResource Tran.Sidebar.ItemHover}"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                                <Setter TargetName="label" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="icon" Property="Margin" Value="0"/>
                                                <Setter TargetName="bg" Property="Padding" Value="0,9"/>
                                                <Setter TargetName="bg" Property="HorizontalAlignment" Value="Center"/>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- RIGHT: Content Area (TabControl with hidden tabs) -->
                <TabControl Grid.Column="1" Name="MainTabControl"
                            SelectedIndex="{Binding SelectedTabIndex}"
                            Padding="0" BorderThickness="0"
                            Background="{StaticResource Tran.Surface.Background}">
                    <TabControl.ItemContainerStyle>
                        <Style TargetType="TabItem">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </Style>
                    </TabControl.ItemContainerStyle>

                    <TabItem>
                        <local:OrderView DataContext="{Binding OrderVM}"/>
                    </TabItem>
                    <TabItem>
                        <local:QuotationView DataContext="{Binding QuotationVM}"/>
                    </TabItem>
                    <TabItem>
                        <local:PurchaseView DataContext="{Binding PurchaseVM}"/>
                    </TabItem>
                    <TabItem>
                        <local:SaleView DataContext="{Binding SaleVM}"/>
                    </TabItem>
                    <TabItem>
                        <local:InventoryView DataContext="{Binding InventoryVM}"/>
                    </TabItem>
                    <TabItem>
                        <local:SalesStatisticsView DataContext="{Binding SalesStatisticsVM}"/>
                    </TabItem>
                </TabControl>
            </Grid>

            <!-- Product Management Mode (full content, no sidebar) -->
            <local:ProductManagementView DataContext="{Binding GlobalProductVM}"
                Visibility="{Binding IsProductManagementMode, Converter={StaticResource BoolToVisConverter}}"/>
        </Grid>
    </DockPanel>
</mah:MetroWindow>
