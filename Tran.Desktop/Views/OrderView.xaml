<UserControl x:Class="Tran.Desktop.Views.OrderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Tran.Desktop.Views"
             mc:Ignorable="d"
             Background="White">

    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding CompleteOrderCommand}"/>
        <KeyBinding Key="F6" Command="{Binding SaveDraftCommand}"/>
        <KeyBinding Key="F" Modifiers="Ctrl" Command="{Binding SearchCommand}"/>
    </UserControl.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 상단 Blue 액센트 바 (#1E90FF) -->
        <Border Grid.Row="0" Height="3" Background="#1E90FF"/>

        <!-- 상단 영역: 좌측 전체 품목 + 우측 자주 거래 품목 (50%) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 좌측: 전체 품목 -->
            <Grid Grid.Column="0" Margin="15,10,5,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 섹션 제목 -->
                <TextBlock Grid.Row="0" Text="전체 품목"
                           FontSize="16" FontWeight="Bold"
                           Foreground="#2C3E50" Margin="0,0,0,10"/>

                <!-- 검색 바 -->
                <Border Grid.Row="1" BorderBrush="#DEE2E6" BorderThickness="1"
                        CornerRadius="4" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#x1F50D;"
                                   VerticalAlignment="Center"
                                   Margin="10,0,5,0" FontSize="14" Foreground="#95A5A6"/>
                        <TextBox Grid.Column="1" Name="ProductSearchBox"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 BorderThickness="0" Padding="5,8"
                                 FontSize="14" VerticalContentAlignment="Center"
                                 Background="Transparent"/>
                    </Grid>
                </Border>

                <!-- 전체 품목 DataGrid (가상 스크롤) -->
                <DataGrid Grid.Row="2"
                          ItemsSource="{Binding FilteredProducts}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          Background="White"
                          RowHeight="38"
                          BorderBrush="#E0E0E0"
                          BorderThickness="1"
                          CanUserAddRows="False"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True"
                          MouseDoubleClick="ProductGrid_MouseDoubleClick">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F5F5F5"/>
                            <Setter Property="Foreground" Value="#333"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="BorderBrush" Value="#E0E0E0"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            <Setter Property="FontSize" Value="13"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Cursor" Value="Hand"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F0F7FF"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#E8F1FF"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="품목명" Binding="{Binding ProductName}" Width="2*"/>
                        <DataGridTextColumn Header="품목코드" Binding="{Binding ProductCode}" Width="*"/>
                        <DataGridTextColumn Header="단가" Binding="{Binding DefaultPrice, StringFormat=\{0:N0\}}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Right"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="단위" Binding="{Binding Unit}" Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- 중간 구분선 -->
            <GridSplitter Grid.Column="1" Width="5"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Background="#E0E0E0"
                          ResizeBehavior="PreviousAndNext"/>

            <!-- 우측: 자주 거래 품목 -->
            <Grid Grid.Column="2" Margin="5,10,15,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 섹션 제목 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="자주 거래 품목"
                               FontSize="16" FontWeight="Bold"
                               Foreground="#2C3E50"/>
                    <TextBlock Text=" (클릭하여 추가)"
                               FontSize="12" Foreground="#95A5A6"
                               VerticalAlignment="Bottom" Margin="5,0,0,2"/>
                </StackPanel>

                <!-- 자주 거래 품목 ListBox -->
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding FrequentProducts}"
                         BorderBrush="#E0E0E0"
                         BorderThickness="1"
                         Background="White"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         ScrollViewer.CanContentScroll="True">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10,8" Cursor="Hand"
                                    BorderBrush="#F0F0F0" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Product.ProductName}"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   Foreground="#2C3E50"/>
                                        <TextBlock Text="{Binding Product.ProductCode}"
                                                   FontSize="11" Foreground="#95A5A6"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Product.DefaultPrice, StringFormat=\{0:N0\}원}"
                                               FontSize="13" Foreground="#1E90FF"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>

                                    <Button Grid.Column="2" Content="+"
                                            Command="{Binding DataContext.AddFrequentProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Width="28" Height="28"
                                            FontSize="16" FontWeight="Bold"
                                            Foreground="White"
                                            Background="#1E90FF"
                                            BorderThickness="0" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="14"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F0F7FF"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
        </Grid>

        <!-- 수평 GridSplitter -->
        <GridSplitter Grid.Row="2" Height="5"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Center"
                      Background="#E0E0E0"
                      ResizeBehavior="PreviousAndNext"/>

        <!-- 하단 영역: 탭 컨트롤 (등록/임시저장/이력) -->
        <TabControl Grid.Row="3" Margin="15,5,15,15"
                    BorderBrush="#E0E0E0" BorderThickness="1">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Padding" Value="15,8"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Foreground" Value="#666"/>
                    <Setter Property="Cursor" Value="Hand"/>
                </Style>
            </TabControl.Resources>

            <!-- 등록 탭 -->
            <TabItem Header="등록">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 등록 탭 헤더 -->
                    <Border Grid.Row="0" Padding="15,10" Background="#F8F9FA"
                            BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="현재 발주 품목"
                                       FontSize="14" FontWeight="Bold"
                                       Foreground="#2C3E50" VerticalAlignment="Center"/>
                            <TextBlock Text=" (0개 품목)"
                                       FontSize="12" Foreground="#95A5A6"
                                       VerticalAlignment="Center" Margin="5,0,0,0"/>
                            <Button Content="F7 품목 선택"
                                    Height="28" Padding="10,0"
                                    FontSize="12"
                                    Foreground="White"
                                    Background="#1E90FF"
                                    BorderThickness="0" Cursor="Hand"
                                    Margin="15,0,0,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="4"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- 발주 품목 DataGrid (수량/단가 편집 가능) -->
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding CurrentOrderItems}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              RowHeaderWidth="0"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              Background="White"
                              RowHeight="38"
                              BorderThickness="0"
                              VirtualizingStackPanel.IsVirtualizing="True">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F5F5F5"/>
                                <Setter Property="Foreground" Value="#333"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="BorderBrush" Value="#E0E0E0"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                <Setter Property="FontSize" Value="13"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="10,6"/>
                                <Setter Property="BorderBrush" Value="#F0F0F0"/>
                                <Setter Property="BorderThickness" Value="0,0,1,0"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#E8F1FF"/>
                                        <Setter Property="Foreground" Value="#000"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>

                        <DataGrid.Columns>
                            <!-- 품목명 -->
                            <DataGridTextColumn Header="품목명" Binding="{Binding ProductName}" Width="2*" IsReadOnly="True"/>

                            <!-- 비고 -->
                            <DataGridTextColumn Header="비고" Binding="{Binding Note}" Width="*" IsReadOnly="True"/>

                            <!-- 수량 (편집 가능) -->
                            <DataGridTextColumn Header="수량" Binding="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox">
                                        <Setter Property="TextAlignment" Value="Right"/>
                                        <Setter Property="Padding" Value="5,3"/>
                                    </Style>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>

                            <!-- 단가 (편집 가능) -->
                            <DataGridTextColumn Header="단가" Binding="{Binding UnitPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=\{0:N0\}}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox">
                                        <Setter Property="TextAlignment" Value="Right"/>
                                        <Setter Property="Padding" Value="5,3"/>
                                    </Style>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>

                            <!-- 금액 (자동 계산) -->
                            <DataGridTextColumn Header="금액" Binding="{Binding LineAmount, StringFormat=\{0:N0\}, Mode=OneWay}" Width="150" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Right"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#1E90FF"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- 삭제 버튼 -->
                            <DataGridTemplateColumn Header="" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="X"
                                                Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Width="24" Height="24"
                                                FontSize="12" FontWeight="Bold"
                                                Foreground="White"
                                                Background="#E74C3C"
                                                BorderThickness="0" Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            CornerRadius="12">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- 합계 영역 -->
                    <Border Grid.Row="2" Background="#F0F0F0" Padding="15,10"
                            BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="합계"
                                       FontSize="16" FontWeight="Bold"
                                       VerticalAlignment="Center" Foreground="#2C3E50"/>
                            <TextBlock Grid.Column="1"
                                       FontSize="20" FontWeight="Bold" Foreground="#1E90FF">
                                <Run Text="&#x20A9;"/>
                                <Run Text="{Binding TotalAmount, StringFormat=\{0:N0\}, Mode=OneWay, FallbackValue='0'}"/>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- 하단 버튼 영역 -->
                    <Border Grid.Row="3" Background="#F8F9FA" Padding="15,10"
                            BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="F6 임시저장"
                                    Command="{Binding SaveDraftCommand}"
                                    Height="36" Padding="20,0"
                                    FontSize="14" FontWeight="Bold"
                                    Foreground="White"
                                    Background="#95A5A6"
                                    BorderThickness="0" Cursor="Hand"
                                    Margin="0,0,10,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="4"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button Content="F5 발주 완료"
                                    Command="{Binding CompleteOrderCommand}"
                                    Height="36" Padding="20,0"
                                    FontSize="14" FontWeight="Bold"
                                    Foreground="White"
                                    Background="#1E90FF"
                                    BorderThickness="0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="4"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- 임시저장 탭 -->
            <TabItem Header="임시저장">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="15,10" Background="#F8F9FA"
                            BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                        <TextBlock Text="임시 저장된 발주 목록"
                                   FontSize="14" FontWeight="Bold"
                                   Foreground="#2C3E50"/>
                    </Border>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding DraftOrders}"
                             BorderThickness="0"
                             VirtualizingStackPanel.IsVirtualizing="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="15,10"
                                        BorderBrush="#F0F0F0" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#2C3E50">
                                                <Run Text="임시저장 #"/>
                                                <Run Text="{Binding OrderId, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock FontSize="12" Foreground="#95A5A6" Margin="0,3,0,0">
                                                <Run Text="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm, Mode=OneWay}"/>
                                                <Run Text=" | "/>
                                                <Run Text="{Binding Items.Count, Mode=OneWay}"/>
                                                <Run Text="개 품목"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <TextBlock Grid.Column="1"
                                                   FontSize="14" FontWeight="Bold" Foreground="#1E90FF"
                                                   VerticalAlignment="Center" Margin="0,0,15,0">
                                            <Run Text="&#x20A9;"/>
                                            <Run Text="{Binding TotalAmount, StringFormat=\{0:N0\}, Mode=OneWay}"/>
                                        </TextBlock>

                                        <Button Grid.Column="2" Content="불러오기"
                                                Command="{Binding DataContext.LoadDraftCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Height="28" Padding="10,0"
                                                FontSize="12"
                                                Foreground="White"
                                                Background="#3498DB"
                                                BorderThickness="0" Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            CornerRadius="4"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Grid>
            </TabItem>

            <!-- 이력 탭 -->
            <TabItem Header="이력">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="15,10" Background="#F8F9FA"
                            BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="완료된 발주 이력"
                                       FontSize="14" FontWeight="Bold"
                                       Foreground="#2C3E50" VerticalAlignment="Center"/>
                            <Button Content="새로고침"
                                    Height="26" Padding="10,0"
                                    FontSize="11"
                                    Foreground="White"
                                    Background="#95A5A6"
                                    BorderThickness="0" Cursor="Hand"
                                    Margin="10,0,0,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="3"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Border>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding OrderHistory}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              Background="White"
                              RowHeight="38"
                              BorderThickness="0"
                              CanUserAddRows="False"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F5F5F5"/>
                                <Setter Property="Foreground" Value="#333"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="BorderBrush" Value="#E0E0E0"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                <Setter Property="FontSize" Value="13"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="발주번호" Binding="{Binding OrderId}" Width="150"/>
                            <DataGridTextColumn Header="발주일" Binding="{Binding OrderDate, StringFormat=yyyy-MM-dd}" Width="120"/>
                            <DataGridTextColumn Header="품목 수" Binding="{Binding Items.Count}" Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="합계" Binding="{Binding TotalAmount, StringFormat=\{0:N0\}원}" Width="150">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Right"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <!-- 상태 (DataTrigger on State enum) -->
                            <DataGridTemplateColumn Header="상태" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6" Padding="8,4"
                                                HorizontalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#F0F0F0"/>
