<UserControl x:Class="Tran.Desktop.Views.OrderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Tran.Desktop.Views"
             mc:Ignorable="d"
             Background="{StaticResource Tran.Surface.Background}">

    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding CompleteOrderCommand}"/>
        <KeyBinding Key="F6" Command="{Binding SaveDraftCommand}"/>
        <KeyBinding Key="F" Modifiers="Ctrl" Command="{Binding SearchCommand}"/>
    </UserControl.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 상단 Blue 액센트 바 -->
        <Border Grid.Row="0" Height="3" Background="{StaticResource Tran.Accent.Order}"/>

        <!-- 상단 영역: 좌측 자주 거래 품목 + 우측 전체 품목 (50%) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 우측: 전체 품목 -->
            <Grid Grid.Column="2" Margin="5,10,15,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 섹션 제목 -->
                <TextBlock Grid.Row="0" Text="전체 품목"
                           FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource Tran.Neutral.800}" Margin="0,0,0,10"/>

                <!-- 검색 바 -->
                <Border Grid.Row="1" Style="{StaticResource Tran.SearchBox}" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#x1F50D;"
                                   VerticalAlignment="Center"
                                   Margin="10,0,5,0" FontSize="14" Foreground="{StaticResource Tran.Neutral.400}"/>
                        <TextBox Grid.Column="1" Name="ProductSearchBox"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 BorderThickness="0" Padding="5,8" Height="Auto"
                                 FontSize="14" VerticalContentAlignment="Center"
                                 Background="Transparent"/>
                    </Grid>
                </Border>

                <!-- 전체 품목 DataGrid (가상 스크롤) -->
                <DataGrid Grid.Row="2" Name="AllProductsGrid"
                          ItemsSource="{Binding FilteredProducts}"
                          SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          Background="White"
                          RowHeight="38"
                          BorderBrush="{StaticResource Tran.Neutral.200}"
                          BorderThickness="1"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True"
                          MouseDoubleClick="ProductGrid_MouseDoubleClick"
                          PreviewMouseLeftButtonDown="ProductGrid_PreviewMouseLeftButtonDown"
                          PreviewMouseMove="ProductGrid_PreviewMouseMove">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="품목명" Binding="{Binding ProductName}" Width="2*"/>
                        <DataGridTextColumn Header="품목코드" Binding="{Binding ProductCode}" Width="*"/>
                        <DataGridTextColumn Header="단가" Binding="{Binding DefaultPrice, StringFormat=\{0:N0\}}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Right"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="단위" Binding="{Binding Unit}" Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- 중간: 화살표 토글 버튼 -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="5,0">
                <Button Command="{Binding AddToFrequentCommand}"
                        Width="36" Height="36" Margin="0,0,0,8"
                        ToolTip="자주거래 품목에 추가"
                        Background="White" BorderBrush="#CCCCCC" BorderThickness="1"
                        Cursor="Hand">
                    <TextBlock Text="&#x25C0;" FontSize="16" Foreground="#222222"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Button Command="{Binding RemoveFromFrequentCommand}"
                        Width="36" Height="36"
                        ToolTip="자주거래 품목에서 제거"
                        Background="White" BorderBrush="#CCCCCC" BorderThickness="1"
                        Cursor="Hand">
                    <TextBlock Text="&#x25B6;" FontSize="16" Foreground="#222222"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
            </StackPanel>

            <!-- 좌측: 자주 거래 품목 -->
            <Grid Grid.Column="0" Margin="15,10,5,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 섹션 제목 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="자주 거래 품목"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource Tran.Neutral.800}"/>
                    <TextBlock Text=" (클릭하여 추가)"
                               FontSize="11.5" Foreground="{StaticResource Tran.Neutral.400}"
                               VerticalAlignment="Bottom" Margin="5,0,0,2"/>
                </StackPanel>

                <!-- 자주 거래 품목 ListBox -->
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding FrequentProducts}"
                         SelectedItem="{Binding SelectedFrequentProduct, Mode=TwoWay}"
                         AllowDrop="True"
                         Drop="FrequentListBox_Drop"
                         DragOver="FrequentListBox_DragOver"
                         PreviewMouseLeftButtonDown="FrequentListBox_PreviewMouseLeftButtonDown"
                         PreviewMouseMove="FrequentListBox_PreviewMouseMove"
                         BorderBrush="{StaticResource Tran.Neutral.200}"
                         BorderThickness="1"
                         Background="White"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         ScrollViewer.CanContentScroll="True">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10,8" Cursor="Hand"
                                    BorderBrush="{StaticResource Tran.State.Draft.Bg}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Product.ProductName}"
                                                   FontSize="13.5" FontWeight="Medium"
                                                   Foreground="{StaticResource Tran.Neutral.800}"/>
                                        <TextBlock Text="{Binding Product.ProductCode}"
                                                   FontSize="11" Foreground="{StaticResource Tran.Neutral.400}"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Product.DefaultPrice, StringFormat=\{0:N0\}원}"
                                               FontSize="13" Foreground="{StaticResource Tran.Accent.Order}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>

                                    <Button Grid.Column="2" Content="+"
                                            Command="{Binding DataContext.AddFrequentProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource Tran.IconButton}"
                                            FontSize="16"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource Tran.Primary.50}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
        </Grid>

        <!-- 수평 GridSplitter -->
        <GridSplitter Grid.Row="2" Height="5"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Center"
                      Background="{StaticResource Tran.Neutral.200}"
                      ResizeBehavior="PreviousAndNext"/>

        <!-- 하단 영역: 탭 컨트롤 (등록/임시저장/이력) -->
        <TabControl Grid.Row="3" Margin="15,5,15,15">

            <!-- 등록 탭 -->
            <TabItem Header="등록">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 등록 탭 헤더 -->
                    <Border Grid.Row="0" Style="{StaticResource Tran.SectionHeader}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="현재 발주 품목"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource Tran.Neutral.800}" VerticalAlignment="Center"/>
                            <TextBlock FontSize="12" Foreground="{StaticResource Tran.Neutral.400}"
                                       VerticalAlignment="Center" Margin="5,0,0,0">
                                <Run Text=" ("/>
                                <Run Text="{Binding CurrentOrderItems.Count, Mode=OneWay}"/>
                                <Run Text="개 품목)"/>
                            </TextBlock>
                            <Button Content="F7 품목 선택"
                                    Click="AddProduct_Click"
                                    Style="{StaticResource Tran.PrimaryButton}"
                                    Height="28" Padding="10,0"
                                    FontSize="12"
                                    Margin="15,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 발주 품목 DataGrid (수량/단가 편집 가능) -->
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding CurrentOrderItems}"
                              AllowDrop="True"
                              Drop="OrderItemsGrid_Drop"
                              DragOver="OrderItemsGrid_DragOver"
                              CanUserDeleteRows="False"
                              Background="White"
                              RowHeight="38"
                              BorderThickness="0"
                              VirtualizingStackPanel.IsVirtualizing="True">

                        <DataGrid.Columns>
                            <!-- 품목명 -->
                            <DataGridTextColumn Header="품목명" Binding="{Binding ProductName}" Width="2*" IsReadOnly="True"/>

                            <!-- 비고 -->
                            <DataGridTextColumn Header="비고" Binding="{Binding Note}" Width="*" IsReadOnly="True"/>

                            <!-- 수량 (편집 가능) -->
                            <DataGridTextColumn Header="수량" Binding="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox">
                                        <Setter Property="TextAlignment" Value="Right"/>
                                        <Setter Property="Padding" Value="5,3"/>
                                    </Style>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>

                            <!-- 단가 (편집 가능) -->
                            <DataGridTextColumn Header="단가" Binding="{Binding UnitPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=\{0:N0\}}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox">
                                        <Setter Property="TextAlignment" Value="Right"/>
                                        <Setter Property="Padding" Value="5,3"/>
                                    </Style>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>

                            <!-- 금액 (자동 계산) -->
                            <DataGridTextColumn Header="금액" Binding="{Binding LineAmount, StringFormat=\{0:N0\}, Mode=OneWay}" Width="150" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Right"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="{StaticResource Tran.Accent.Order}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- 삭제 버튼 -->
                            <DataGridTemplateColumn Header="" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="X"
                                                Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource Tran.IconButton.Danger}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- 합계 + 버튼 통합 영역 -->
                    <Border Grid.Row="2" Background="{StaticResource Tran.State.Draft.Bg}" Padding="10,5"
                            BorderBrush="{StaticResource Tran.Neutral.200}" BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="합계"
                                       FontSize="13" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Foreground="{StaticResource Tran.Neutral.800}"
                                       Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1"
                                       FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Tran.Accent.Order}"
                                       VerticalAlignment="Center">
                                <Run Text="&#x20A9;"/>
                                <Run Text="{Binding TotalAmount, StringFormat=\{0:N0\}, Mode=OneWay, FallbackValue='0'}"/>
                            </TextBlock>

                            <Button Grid.Column="3" Content="F6 임시저장"
                                    Command="{Binding SaveDraftCommand}"
                                    Style="{StaticResource Tran.SecondaryButton}"
                                    Height="30" Padding="15,0"
                                    FontSize="12" FontWeight="Medium"
                                    Margin="0,0,8,0"/>

                            <Button Grid.Column="4" Content="F5 발주 완료"
                                    Command="{Binding CompleteOrderCommand}"
                                    Style="{StaticResource Tran.PrimaryButton}"
                                    Height="30" Padding="15,0"
                                    FontSize="12" FontWeight="Medium"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- 임시저장 탭 -->
            <TabItem Header="임시저장">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource Tran.SectionHeader}">
                        <TextBlock Text="임시 저장된 발주 목록"
                                   FontSize="14" FontWeight="Medium"
                                   Foreground="{StaticResource Tran.Neutral.800}"/>
                    </Border>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding DraftOrders}"
                             BorderThickness="0"
                             VirtualizingStackPanel.IsVirtualizing="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="15,10"
                                        BorderBrush="{StaticResource Tran.State.Draft.Bg}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock FontSize="13.5" FontWeight="Medium" Foreground="{StaticResource Tran.Neutral.800}">
                                                <Run Text="임시저장 #"/>
                                                <Run Text="{Binding OrderId, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock FontSize="12" Foreground="{StaticResource Tran.Neutral.400}" Margin="0,3,0,0">
                                                <Run Text="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm, Mode=OneWay}"/>
                                                <Run Text=" | "/>
                                                <Run Text="{Binding Items.Count, Mode=OneWay}"/>
                                                <Run Text="개 품목"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <TextBlock Grid.Column="1"
                                                   FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource Tran.Accent.Order}"
                                                   VerticalAlignment="Center" Margin="0,0,15,0">
                                            <Run Text="&#x20A9;"/>
                                            <Run Text="{Binding TotalAmount, StringFormat=\{0:N0\}, Mode=OneWay}"/>
                                        </TextBlock>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                            <Button Content="불러오기"
                                                    Command="{Binding DataContext.LoadDraftCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource Tran.PrimaryButton}"
                                                    Height="28" Padding="10,0"
                                                    FontSize="12"
                                                    Margin="0,0,5,0"/>
                                            <Button Content="&#x2716;"
                                                    Command="{Binding DataContext.DeleteDraftCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource Tran.IconButton.Danger}"
                                                    Height="28" Width="28"
                                                    ToolTip="임시저장 삭제"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Grid>
            </TabItem>

            <!-- 이력 탭 -->
            <TabItem Header="이력">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource Tran.SectionHeader}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="완료된 발주 이력"
                                       FontSize="14" FontWeight="Medium"
                                       Foreground="{StaticResource Tran.Neutral.800}" VerticalAlignment="Center"/>
                            <Button Content="새로고침"
                                    Style="{StaticResource Tran.SecondaryButton}"
                                    Height="26" Padding="10,0"
                                    FontSize="11"
                                    Margin="10,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding OrderHistory}"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              Background="White"
                              RowHeight="38"
                              BorderThickness="0"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="발주번호" Binding="{Binding OrderId}" Width="150"/>
                            <DataGridTextColumn Header="발주일" Binding="{Binding OrderDate, StringFormat=yyyy-MM-dd}" Width="120"/>
                            <DataGridTextColumn Header="품목 수" Binding="{Binding Items.Count}" Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="합계" Binding="{Binding TotalAmount, StringFormat=\{0:N0\}원}" Width="150">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Right"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <!-- 상태 (DataTrigger on State enum) -->
                            <DataGridTemplateColumn Header="상태" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6" Padding="8,4"
                                                HorizontalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource Tran.State.Draft.Bg}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding State}" Value="Completed">
                                                            <Setter Property="Background" Value="{StaticResource Tran.State.Confirmed.Bg}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding State}" Value="Cancelled">
                                                            <Setter Property="Background" Value="{StaticResource Tran.State.Cancelled.Bg}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="12">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="작성중"/>
                                                        <Setter Property="Foreground" Value="{StaticResource Tran.State.Draft.Fg}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding State}" Value="Completed">
                                                                <Setter Property="Text" Value="완료"/>
                                                                <Setter Property="Foreground" Value="{StaticResource Tran.State.Confirmed.Fg}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding State}" Value="Cancelled">
                                                                <Setter Property="Text" Value="취소"/>
                                                                <Setter Property="Foreground" Value="{StaticResource Tran.State.Cancelled.Fg}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
