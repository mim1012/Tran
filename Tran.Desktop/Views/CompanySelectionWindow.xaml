<Window x:Class="Tran.Desktop.Views.CompanySelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Tran.Desktop.Views"
        mc:Ignorable="d"
        Title="Tran - 거래처 선택"
        Width="900" Height="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Tran.Surface.Background}"
        FontFamily="{StaticResource Tran.FontFamily}">

    <Window.InputBindings>
        <KeyBinding Key="F" Modifiers="Ctrl" Command="{Binding FocusSearchCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 헤더 영역 (피플카 스타일: 다크 네이비 배경) -->
        <Border Grid.Row="0" Background="{StaticResource Tran.Primary.900}" Padding="20,28">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="작업할 거래처를 선택하세요"
                           FontSize="20" FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="거래처를 선택하면 해당 거래처와의 작업 화면으로 이동합니다"
                           FontSize="13" Foreground="{StaticResource Tran.Sidebar.Text.Secondary}"
                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <!-- 최근 거래처 칩 영역 -->
        <Border Grid.Row="1" Background="{StaticResource Tran.Neutral.50}" Padding="15,12"
                BorderBrush="{StaticResource Tran.Neutral.200}" BorderThickness="0,0,0,1"
                Visibility="{Binding HasRecentCompanies, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="최근 거래처" Style="{StaticResource Tran.Typography.Caption}"
                           Margin="0,0,0,8"/>
                <ItemsControl ItemsSource="{Binding RecentCompanies}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.SelectCompanyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Margin="0,0,8,0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Style="{StaticResource Tran.Chip}" Cursor="Hand">
                                            <TextBlock Text="{Binding CompanyName}"
                                                       Foreground="{StaticResource Tran.Primary.600}"
                                                       FontSize="13"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- 검색 및 필터 영역 -->
        <Border Grid.Row="2" Padding="20,15" Background="White"
                BorderBrush="{StaticResource Tran.Neutral.200}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Tran.SearchBox}" Margin="0,0,15,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#x1F50D;"
                                   VerticalAlignment="Center"
                                   Margin="10,0,5,0" FontSize="14" Foreground="{StaticResource Tran.Neutral.400}"/>
                        <TextBox Grid.Column="1" Name="SearchTextBox"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 BorderThickness="0" Padding="5,8"
                                 FontSize="14" VerticalContentAlignment="Center"
                                 Background="Transparent" Height="Auto">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Tag" Value="거래처명, 사업자번호 검색..."/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Grid>
                </Border>

                <TextBlock Grid.Column="1" Text="타입:" FontSize="13" Foreground="{StaticResource Tran.Neutral.600}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox Grid.Column="2"
                          ItemsSource="{Binding CompanyTypes}"
                          SelectedItem="{Binding SelectedType}"
                          Padding="10,5"
                          FontSize="13" VerticalContentAlignment="Center"/>
            </Grid>
        </Border>

        <!-- 거래처 카드 영역 (스크롤 가능) -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="15">
            <Grid>
                <!-- 거래처가 없을 때 -->
                <TextBlock Text="검색 조건에 맞는 거래처가 없습니다"
                           FontSize="14" Foreground="{StaticResource Tran.Neutral.400}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <!-- 거래처 카드 목록 -->
                <ItemsControl ItemsSource="{Binding FilteredCompanies}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="250" Margin="5" Style="{StaticResource Tran.Card}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- 거래처명 -->
                                    <TextBlock Grid.Row="0"
                                               Text="{Binding CompanyName}"
                                               Style="{StaticResource Tran.Heading3}"
                                               Margin="0,0,0,5"
                                               TextTrimming="CharacterEllipsis"/>

                                    <!-- 타입 배지 -->
                                    <Border Grid.Row="1" HorizontalAlignment="Left"
                                            CornerRadius="4" Padding="8,3"
                                            Margin="0,0,0,8"
                                            Background="{Binding TypeBadgeBackground}">
                                        <TextBlock Text="{Binding CompanyTypeDisplay}"
                                                   FontSize="11" Foreground="{Binding TypeBadgeForeground}"/>
                                    </Border>

                                    <!-- 사업자번호 -->
                                    <TextBlock Grid.Row="2"
                                               Style="{StaticResource Tran.Typography.Caption}"
                                               Margin="0,0,0,3">
                                        <Run Text="사업자번호: "/>
                                        <Run Text="{Binding BusinessNumber, Mode=OneWay}"/>
                                    </TextBlock>

                                    <!-- 주소 -->
                                    <TextBlock Grid.Row="3"
                                               Text="{Binding Address}"
                                               Style="{StaticResource Tran.Typography.Caption}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,0,0,12"/>

                                    <!-- 버튼 영역 -->
                                    <Grid Grid.Row="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- 선택 버튼 -->
                                        <Button Grid.Column="0"
                                                Content="선택"
                                                Style="{StaticResource Tran.PrimaryButton}"
                                                Command="{Binding DataContext.SelectCompanyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                HorizontalAlignment="Stretch"
                                                Height="32"/>

                                        <!-- 수정 버튼 -->
                                        <Button Grid.Column="1"
                                                Content="&#x270F;"
                                                ToolTip="수정"
                                                Command="{Binding DataContext.EditCompanyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource Tran.SecondaryButton}"
                                                Width="32" Height="32"
                                                Padding="0"
                                                Margin="5,0,0,0"
                                                FontSize="14"/>

                                        <!-- 삭제 버튼 -->
                                        <Button Grid.Column="2"
                                                Content="&#x2716;"
                                                ToolTip="삭제(비활성화)"
                                                Command="{Binding DataContext.DeactivateCompanyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource Tran.SecondaryButton}"
                                                Width="32" Height="32"
                                                Padding="0"
                                                Margin="5,0,0,0"
                                                FontSize="12"
                                                Foreground="Red"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ScrollViewer>

        <!-- 하단 버튼 영역 -->
        <Border Grid.Row="4" Background="{StaticResource Tran.Surface.Footer}" Padding="20,15"
                BorderBrush="{StaticResource Tran.Neutral.200}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="+ 새 거래처 등록"
                        Style="{StaticResource Tran.SuccessButton}"
                        Command="{Binding AddNewCompanyCommand}"
                        HorizontalAlignment="Left"
                        Padding="20,8"/>

                <Button Grid.Column="1"
                        Content="&#x1F3F7; 품목관리"
                        Style="{StaticResource Tran.SecondaryButton}"
                        Command="{Binding OpenProductManagementCommand}"
                        HorizontalAlignment="Left"
                        Padding="20,8"
                        Margin="10,0,0,0"/>

                <TextBlock Grid.Column="3"
                           Style="{StaticResource Tran.Typography.Caption}"
                           VerticalAlignment="Center">
                    <Run Text="총 "/>
                    <Run Text="{Binding TotalCompanyCount, Mode=OneWay}"/>
                    <Run Text="개 거래처"/>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Window>
