<UserControl x:Class="Tran.Desktop.Views.SalesStatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{StaticResource Tran.Surface.Background}"
             d:DesignHeight="800" d:DesignWidth="1200">

    <UserControl.InputBindings>
        <KeyBinding Key="F9" Command="{Binding RefreshCommand}"/>
    </UserControl.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="3"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 녹색 악센트 바 (3px) -->
        <Border Grid.Row="0" Background="{StaticResource Tran.Accent.Sale}"
                Style="{StaticResource Tran.AccentBar}"/>

        <!-- 헤더: 타이틀 + 기간 필터 + 조회 버튼 -->
        <Border Grid.Row="1" Style="{StaticResource Tran.SectionHeader}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="매출 통계"
                           Style="{StaticResource Tran.Heading2}"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="2" Text="기간:"
                           FontSize="13" VerticalAlignment="Center"
                           Foreground="{StaticResource Tran.Neutral.600}"
                           Margin="0,0,8,0"/>

                <DatePicker Grid.Column="3"
                            SelectedDate="{Binding FromDate}"
                            Width="130" Height="30"
                            VerticalContentAlignment="Center"
                            Margin="0,0,5,0"/>

                <TextBlock Grid.Column="4" Text="~"
                           FontSize="14" VerticalAlignment="Center"
                           Foreground="{StaticResource Tran.Neutral.500}"
                           Margin="3,0"/>

                <DatePicker Grid.Column="5"
                            SelectedDate="{Binding ToDate}"
                            Width="130" Height="30"
                            VerticalContentAlignment="Center"
                            Margin="5,0,12,0"/>

                <Button Grid.Column="6"
                        Content="조회"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource Tran.SuccessButton}"/>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- 요약 카드 6개 -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="2" Margin="15,10,15,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 오늘 매출 -->
            <Border Grid.Column="0" Style="{StaticResource Tran.SummaryCard}"
                    Background="{StaticResource Tran.Neutral.50}"
                    BorderBrush="{StaticResource Tran.Neutral.200}"
                    Margin="0,0,4,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="오늘 매출" FontSize="11"
                               Foreground="{StaticResource Tran.Neutral.400}"
                               HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding TodaySales, StringFormat={}{0:N0}원}"
                               FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource Tran.Neutral.800}"
                               HorizontalAlignment="Center"/>
                    <TextBlock FontSize="10" Foreground="{StaticResource Tran.Neutral.400}"
                               HorizontalAlignment="Center" Margin="0,2,0,0">
                        <Run Text="{Binding TodayCount, Mode=OneWay}"/>
                        <Run Text="건"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- 이번달 매출 -->
            <Border Grid.Column="1" Style="{StaticResource Tran.SummaryCard}"
                    Background="{StaticResource Tran.Success.Light}"
                    BorderBrush="{StaticResource Tran.Success}"
                    Margin="4,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="이번달 매출" FontSize="11"
                               Foreground="{StaticResource Tran.Success}"
                               HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding MonthSales, StringFormat={}{0:N0}원}"
                               FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource Tran.Success}"
                               HorizontalAlignment="Center"/>
                    <TextBlock FontSize="10"
                               Foreground="{StaticResource Tran.Success.Dark}"
                               HorizontalAlignment="Center" Margin="0,2,0,0">
                        <Run Text="전월 대비 "/>
                        <Run Text="{Binding MonthGrowthRate, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- 이번달 매입 -->
            <Border Grid.Column="2" Style="{StaticResource Tran.SummaryCard}"
                    Background="#F3EEFA"
                    BorderBrush="#8B5CF6"
                    Margin="4,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="이번달 매입" FontSize="11"
                               Foreground="#8B5CF6"
                               HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding MonthPurchases, StringFormat={}{0:N0}원}"
                               FontSize="18" FontWeight="Bold"
                               Foreground="#8B5CF6"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- 이번달 이익 -->
            <Border Grid.Column="3" Margin="4,0">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Tran.SummaryCard}">
                        <Setter Property="Background" Value="{StaticResource Tran.Success.Light}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource Tran.Success}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMonthProfitNegative}" Value="True">
                                <Setter Property="Background" Value="{StaticResource Tran.Danger.Light}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource Tran.Danger}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="이번달 이익" FontSize="11"
                               HorizontalAlignment="Center" Margin="0,0,0,4">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource Tran.Success}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMonthProfitNegative}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Tran.Danger}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding MonthProfit, StringFormat={}{0:N0}원}"
                               FontSize="18" FontWeight="Bold"
                               HorizontalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource Tran.Success}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMonthProfitNegative}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Tran.Danger}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource Tran.Success.Dark}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMonthProfitNegative}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Tran.Danger.Dark}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <Run Text="이익률 "/>
                        <Run Text="{Binding MonthProfitRate, StringFormat={}{0:F1}%, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- 미확정 건수 -->
            <Border Grid.Column="4" Style="{StaticResource Tran.SummaryCard}"
                    Background="{StaticResource Tran.Warning.Light}"
                    BorderBrush="{StaticResource Tran.Warning}"
                    Margin="4,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="미확정 건수" FontSize="11"
                               Foreground="{StaticResource Tran.Warning}"
                               HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding DraftCount}"
                               FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource Tran.Warning}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="건" FontSize="10"
                               Foreground="{StaticResource Tran.Warning.Dark}"
                               HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- 재고부족 품목 -->
            <Border Grid.Column="5" Style="{StaticResource Tran.SummaryCard}"
                    Background="{StaticResource Tran.Danger.Light}"
                    BorderBrush="{StaticResource Tran.Danger}"
                    Margin="4,0,0,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="재고부족 품목" FontSize="11"
                               Foreground="{StaticResource Tran.Danger}"
                               HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding LowStockCount}"
                               FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource Tran.Danger}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="품목" FontSize="10"
                               Foreground="{StaticResource Tran.Danger.Dark}"
                               HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- GridSplitter -->
        <GridSplitter Grid.Row="3"
                      Height="5"
                      HorizontalAlignment="Stretch"
                      Background="{StaticResource Tran.Neutral.200}"
                      ResizeDirection="Rows"
                      ShowsPreview="True"/>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- 하단 탭: 거래처별 / 상품별 / 카테고리별 / 월별 추이 -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <TabControl Grid.Row="4" Margin="15,5,15,10">

            <!-- ═══════════════════════════════════════════════ -->
            <!-- 탭 0: 거래처별 매출 (확장) -->
            <!-- ═══════════════════════════════════════════════ -->
            <TabItem Header="거래처별">
                <DataGrid ItemsSource="{Binding CompanyRankList}"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          RowHeight="38"
                          BorderThickness="0"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="거래처명" Binding="{Binding CompanyName}" Width="2*"/>

                        <DataGridTextColumn Header="판매건수" Binding="{Binding SaleCount}" Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Right"/>
                                    <Setter Property="Padding" Value="0,0,8,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="매출액" Binding="{Binding TotalAmount, StringFormat={}{0:N0}}" Width="130">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Right"/>
                                    <Setter Property="Padding" Value="0,0,8,0"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="{StaticResource Tran.Accent.Sale}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="매입액" Binding="{Binding PurchaseAmount, StringFormat={}{0:N0}}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Right"/>
                                    <Setter Property="Padding" Value="0,0,8,0"/>
                                    <Setter Property="Foreground" Value="#8B5CF6"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="이익" Binding="{Binding Profit, StringFormat={}{0:N0}}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Right"/>
                                    <Setter Property="Padding" Value="0,0,8,0"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="{StaticResource Tran.Success}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="이익률(%)" Binding="{Binding ProfitRate, StringFormat={}{0:F1}%}" Width="90">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Right"/>
                                    <Setter Property="Padding" Value="0,0,8,0"/>
                                    <Setter Property="Foreground" Value="{StaticResource Tran.Neutral.600}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- 매출 비중 바 -->
                        <DataGridTemplateColumn Header="비중" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,0">
                                        <Border Background="{StaticResource Tran.Success.Light}"
                                                CornerRadius="3"
                                                HorizontalAlignment="Left"
                                                Height="14"
                                                Width="{Binding AmountBarRatio, Converter={StaticResource RatioToPixelConverter}, ConverterParameter=120}"/>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- ═══════════════════════════════════════════════ -->
            <!-- 탭 1: 상품별 (마스터-디테일) -->
            <!-- ═══════════════════════════════════════════════ -->
            <TabItem Header="상품별">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 좌측: 품목 목록 -->
                    <DataGrid Grid.Column="0"
                              ItemsSource="{Binding ProductDetailList}"
                              SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              RowHeight="36"
                              BorderThickness="0"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="품목명" Binding="{Binding ProductName}" Width="*"/>
                            <DataGridTextColumn Header="매출" Binding="{Binding TotalSalesAmount, StringFormat={}{0:N0}}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Right"/>
                                        <Setter Property="Padding" Value="0,0,6,0"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="{StaticResource Tran.Accent.Sale}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="매입" Binding="{Binding TotalPurchaseAmount, StringFormat={}{0:N0}}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Right"/>
                                        <Setter Property="Padding" Value="0,0,6,0"/>
                                        <Setter Property="Foreground" Value="#8B5CF6"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="이익률" Binding="{Binding GrossProfitRate, StringFormat={}{0:F1}%}" Width="70">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Right"/>
                                        <Setter Property="Padding" Value="0,0,6,0"/>
                                        <Setter Property="Foreground" Value="{StaticResource Tran.Neutral.600}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="등급" Width="55">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource Tran.Neutral.100}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding AbcRank}" Value="A">
                                                            <Setter Property="Background" Value="{StaticResource Tran.Success.Light}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding AbcRank}" Value="B">
                                                            <Setter Property="Background" Value="{StaticResource Tran.Warning.Light}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding AbcRank}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource Tran.Neutral.500}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding AbcRank}" Value="A">
                                                                <Setter Property="Foreground" Value="{StaticResource Tran.Success.Dark}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding AbcRank}" Value="B">
                                                                <Setter Property="Foreground" Value="{StaticResource Tran.Warning.Dark}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="추세" Binding="{Binding TrendDirection}" Width="45">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Center"/>
                                        <Setter Property="FontSize" Value="14"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- GridSplitter -->
                    <GridSplitter Grid.Column="1" Width="5"
                                  HorizontalAlignment="Stretch"
                                  Background="{StaticResource Tran.Neutral.200}"/>

                    <!-- 우측: 선택 품목 세부 -->
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="12,8">
                        <!-- 선택 안됨 안내 -->
                        <Grid>
                            <TextBlock Text="좌측 목록에서 품목을 선택하면&#x0a;세부 통계가 표시됩니다."
                                       FontSize="13"
                                       Foreground="{StaticResource Tran.Neutral.400}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center"
                                       LineHeight="22">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedProduct}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- 선택된 품목 세부 정보 -->
                            <StackPanel DataContext="{Binding}">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedProduct}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <!-- 품목 정보 카드 -->
                                <Border Background="{StaticResource Tran.Neutral.50}"
                                        BorderBrush="{StaticResource Tran.Neutral.200}"
                                        BorderThickness="1" CornerRadius="6"
                                        Padding="14,10" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding SelectedProduct.ProductName}"
                                                   FontSize="16" FontWeight="Bold"
                                                   Foreground="{StaticResource Tran.Neutral.800}"/>
                                        <TextBlock Margin="0,4,0,8" FontSize="11" Foreground="{StaticResource Tran.Neutral.500}">
                                            <Run Text="{Binding SelectedProduct.ProductCode, Mode=OneWay}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding SelectedProduct.Category, Mode=OneWay, TargetNullValue=미분류}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding SelectedProduct.Unit, Mode=OneWay}"/>
                                        </TextBlock>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" FontSize="11" Foreground="{StaticResource Tran.Neutral.500}" Text="매출액" Margin="0,2"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Tran.Accent.Sale}" HorizontalAlignment="Right">
                                                <Run Text="{Binding SelectedProduct.TotalSalesAmount, StringFormat={}{0:N0}, Mode=OneWay}"/>
                                            </TextBlock>

                                            <TextBlock Grid.Row="1" Grid.Column="0" FontSize="11" Foreground="{StaticResource Tran.Neutral.500}" Text="매입액" Margin="0,2"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" FontSize="13" FontWeight="Bold" Foreground="#8B5CF6" HorizontalAlignment="Right">
                                                <Run Text="{Binding SelectedProduct.TotalPurchaseAmount, StringFormat={}{0:N0}, Mode=OneWay}"/>
                                            </TextBlock>

                                            <TextBlock Grid.Row="2" Grid.Column="0" FontSize="11" Foreground="{StaticResource Tran.Neutral.500}" Text="이익 / 이익률" Margin="0,2"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Tran.Success}" HorizontalAlignment="Right">
                                                <Run Text="{Binding SelectedProduct.GrossProfit, StringFormat={}{0:N0}, Mode=OneWay}"/>
                                                <Run Text=" ("/>
                                                <Run Text="{Binding SelectedProduct.GrossProfitRate, StringFormat={}{0:F1}%, Mode=OneWay}"/>
                                                <Run Text=")"/>
                                            </TextBlock>
                                        </Grid>

                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                                <TextBlock Text="재고" FontSize="10" Foreground="{StaticResource Tran.Neutral.400}" HorizontalAlignment="Center"/>
                                                <TextBlock FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"
                                                           Foreground="{StaticResource Tran.Neutral.700}"
                                                           Text="{Binding SelectedProduct.CurrentStock, StringFormat={}{0:N0}}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                                <TextBlock Text="안전재고" FontSize="10" Foreground="{StaticResource Tran.Neutral.400}" HorizontalAlignment="Center"/>
                                                <TextBlock FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"
                                                           Foreground="{StaticResource Tran.Neutral.700}"
                                                           Text="{Binding SelectedProduct.SafetyStock, StringFormat={}{0:N0}}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                                <TextBlock Text="거래처" FontSize="10" Foreground="{StaticResource Tran.Neutral.400}" HorizontalAlignment="Center"/>
                                                <TextBlock FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"
                                                           Foreground="{StaticResource Tran.Neutral.700}">
                                                    <Run Text="{Binding SelectedProduct.CustomerCount, Mode=OneWay}"/>
                                                    <Run Text="곳"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- 월별 추이 바차트 -->
                                <TextBlock Text="월별 추이 (최근 6개월)"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource Tran.Neutral.700}"
                                           Margin="0,0,0,6"/>
                                <ItemsControl ItemsSource="{Binding SelectedProductMonthly}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2" Height="22">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="60"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="80"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding MonthLabel}"
                                                           FontSize="11" Foreground="{StaticResource Tran.Neutral.500}"
                                                           VerticalAlignment="Center"/>
                                                <Border Grid.Column="1"
                                                        Background="{StaticResource Tran.Success.Light}"
                                                        CornerRadius="3"
                                                        HorizontalAlignment="Left"
                                                        Height="14"
                                                        Width="{Binding SalesBarRatio, Converter={StaticResource RatioToPixelConverter}, ConverterParameter=140}"
                                                        VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding SalesAmount, StringFormat={}{0:N0}}"
                                                           FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{StaticResource Tran.Accent.Sale}"
                                                           TextAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           Padding="0,0,4,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- 거래처별 분포 -->
                                <TextBlock Text="거래처별 분포"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource Tran.Neutral.700}"
                                           Margin="0,14,0,6"/>
                                <ItemsControl ItemsSource="{Binding SelectedProductCustomers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2" Height="22">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="50"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding CompanyName}"
                                                               FontSize="11" Foreground="{StaticResource Tran.Neutral.700}"
                                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <Border Background="#E0E7FF"
                                                            CornerRadius="3"
                                                            HorizontalAlignment="Left"
                                                            Height="12"
                                                            Width="{Binding BarRatio, Converter={StaticResource RatioToPixelConverter}, ConverterParameter=60}"
                                                            VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Amount, StringFormat={}{0:N0}}"
                                                           FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{StaticResource Tran.Neutral.700}"
                                                           TextAlignment="Right"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding AmountRatio, StringFormat={}{0:F1}%}"
                                                           FontSize="10"
                                                           Foreground="{StaticResource Tran.Neutral.500}"
                                                           TextAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           Padding="0,0,4,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ═══════════════════════════════════════════════ -->
            <!-- 탭 2: 카테고리별 (신규) -->
            <!-- ═══════════════════════════════════════════════ -->
            <TabItem Header="카테고리별">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 좌측: 카테고리 목록 -->
                    <Border Grid.Column="0" Background="{StaticResource Tran.Neutral.50}"
                            BorderBrush="{StaticResource Tran.Neutral.200}"
                            BorderThickness="0,0,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,8">
                            <ItemsControl ItemsSource="{Binding CategoryList}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="10,8" Margin="0,2" CornerRadius="5"
                                                Cursor="Hand"
                                                MouseLeftButtonDown="Category_Click">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource Tran.Neutral.100}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Category}"
                                                               FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{StaticResource Tran.Neutral.800}"/>
                                                    <TextBlock Grid.Column="1" FontSize="12" FontWeight="Bold"
                                                               Foreground="{StaticResource Tran.Accent.Sale}">
                                                        <Run Text="{Binding AmountRatio, StringFormat={}{0:F1}%, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </Grid>
                                                <Grid Grid.Row="1" Margin="0,4,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0"
                                                            Background="{StaticResource Tran.Success.Light}"
                                                            CornerRadius="3"
                                                            HorizontalAlignment="Left"
                                                            Height="10"
                                                            Width="{Binding BarRatio, Converter={StaticResource RatioToPixelConverter}, ConverterParameter=150}"/>
                                                    <TextBlock Grid.Column="1" FontSize="11"
                                                               Foreground="{StaticResource Tran.Neutral.500}" Margin="6,0,0,0">
                                                        <Run Text="{Binding ProductCount, Mode=OneWay}"/>
                                                        <Run Text="품목"/>
                                                    </TextBlock>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <!-- GridSplitter -->
                    <GridSplitter Grid.Column="1" Width="5"
                                  HorizontalAlignment="Stretch"
                                  Background="{StaticResource Tran.Neutral.200}"/>

                    <!-- 우측: 해당 카테고리 품목 -->
                    <DataGrid Grid.Column="2"
                              ItemsSource="{Binding FilteredCategoryProducts}"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              RowHeight="36"
                              BorderThickness="0"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="품목명" Binding="{Binding ProductName}" Width="*"/>
                            <DataGridTextColumn Header="코드" Binding="{Binding ProductCode}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource Tran.Neutral.500}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="매출" Binding="{Binding TotalSalesAmount, StringFormat={}{0:N0}}" Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Right"/>
                                        <Setter Property="Padding" Value="0,0,6,0"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="{StaticResource Tran.Accent.Sale}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="매입" Binding="{Binding TotalPurchaseAmount, StringFormat={}{0:N0}}" Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Right"/>
                                        <Setter Property="Padding" Value="0,0,6,0"/>
                                        <Setter Property="Foreground" Value="#8B5CF6"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="이익률" Binding="{Binding GrossProfitRate, StringFormat={}{0:F1}%}" Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Right"/>
                                        <Setter Property="Padding" Value="0,0,6,0"/>
                                        <Setter Property="Foreground" Value="{StaticResource Tran.Neutral.600}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="재고" Binding="{Binding CurrentStock, StringFormat={}{0:N0}}" Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Right"/>
                                        <Setter Property="Padding" Value="0,0,6,0"/>
                                        <Setter Property="Foreground" Value="{StaticResource Tran.Neutral.600}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ═══════════════════════════════════════════════ -->
            <!-- 탭 3: 월별 추이 (신규) -->
            <!-- ═══════════════════════════════════════════════ -->
            <TabItem Header="월별 추이">
                <Grid Margin="10,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 기간 토글 -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="기간:" FontSize="13"
                                   Foreground="{StaticResource Tran.Neutral.600}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button Content="6개월"
                                Command="{Binding SetTrend6MonthsCommand}"
                                Padding="12,4" Margin="0,0,6,0"
                                FontSize="12"/>
                        <Button Content="12개월"
                                Command="{Binding SetTrend12MonthsCommand}"
                                Padding="12,4"
                                FontSize="12"/>
                    </StackPanel>

                    <!-- 월별 바차트 -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding MonthlyTrendList}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3" MinHeight="32">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="65"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="65"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- 월 라벨 -->
                                        <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Tran.Neutral.600}"
                                                   VerticalAlignment="Center"/>

                                        <!-- 이중 바차트 -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <!-- 매출 바 (녹색) -->
                                            <Border Background="{StaticResource Tran.Success.Light}"
                                                    CornerRadius="3"
                                                    HorizontalAlignment="Left"
                                                    Height="10"
                                                    Margin="0,0,0,2"
                                                    Width="{Binding SalesBarRatio, Converter={StaticResource RatioToPixelConverter}, ConverterParameter=250}"/>
                                            <!-- 매입 바 (보라색) -->
                                            <Border Background="#E8DAFF"
                                                    CornerRadius="3"
                                                    HorizontalAlignment="Left"
                                                    Height="10"
                                                    Width="{Binding PurchaseBarRatio, Converter={StaticResource RatioToPixelConverter}, ConverterParameter=250}"/>
                                        </StackPanel>

                                        <!-- 매출 금액 -->
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding SalesAmount, StringFormat={}{0:N0}}"
                                                   FontSize="12" FontWeight="Bold"
                                                   Foreground="{StaticResource Tran.Success}"
                                                   TextAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Padding="0,0,8,0"/>

                                        <!-- 매입 금액 -->
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding PurchaseAmount, StringFormat={}{0:N0}}"
                                                   FontSize="12"
                                                   Foreground="#8B5CF6"
                                                   TextAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Padding="0,0,8,0"/>

                                        <!-- 이익 -->
                                        <TextBlock Grid.Column="4"
                                                   Text="{Binding Profit, StringFormat={}{0:N0}}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Tran.Success}"
                                                   TextAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Padding="0,0,8,0"/>

                                        <!-- 이익률 -->
                                        <TextBlock Grid.Column="5"
                                                   Text="{Binding ProfitRate, StringFormat={}{0:F1}%}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource Tran.Neutral.500}"
                                                   TextAlignment="Right"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- 하단 합계 -->
                    <Border Grid.Row="2"
                            Background="{StaticResource Tran.Neutral.50}"
                            BorderBrush="{StaticResource Tran.Neutral.200}"
                            BorderThickness="0,1,0,0"
                            Padding="10,8" Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock Text="합계 매출" FontSize="10" Foreground="{StaticResource Tran.Neutral.400}" HorizontalAlignment="Center"/>
                                <TextBlock FontSize="14" FontWeight="Bold" Foreground="{StaticResource Tran.Success}" HorizontalAlignment="Center"
                                           Text="{Binding TrendTotalSales, StringFormat={}{0:N0}}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock Text="합계 매입" FontSize="10" Foreground="{StaticResource Tran.Neutral.400}" HorizontalAlignment="Center"/>
                                <TextBlock FontSize="14" FontWeight="Bold" Foreground="#8B5CF6" HorizontalAlignment="Center"
                                           Text="{Binding TrendTotalPurchases, StringFormat={}{0:N0}}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock Text="합계 이익" FontSize="10" Foreground="{StaticResource Tran.Neutral.400}" HorizontalAlignment="Center"/>
                                <TextBlock FontSize="14" FontWeight="Bold" Foreground="{StaticResource Tran.Success}" HorizontalAlignment="Center"
                                           Text="{Binding TrendTotalProfit, StringFormat={}{0:N0}}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                                <TextBlock Text="평균 이익률" FontSize="10" Foreground="{StaticResource Tran.Neutral.400}" HorizontalAlignment="Center"/>
                                <TextBlock FontSize="14" FontWeight="Bold" Foreground="{StaticResource Tran.Neutral.700}" HorizontalAlignment="Center"
                                           Text="{Binding TrendAvgProfitRate, StringFormat={}{0:F1}%}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
