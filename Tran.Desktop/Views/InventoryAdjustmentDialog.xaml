<Window x:Class="Tran.Desktop.Views.InventoryAdjustmentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="재고 조정"
        Width="420" Height="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource Tran.Surface.Background}"
        FontFamily="{StaticResource Tran.FontFamily}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Form -->
            <RowDefinition Height="Auto"/> <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- 다크 네이비 헤더 -->
        <Border Grid.Row="0" Background="{StaticResource Tran.Primary.900}" Padding="20,14">
            <TextBlock Text="재고 조정" FontSize="16" FontWeight="Bold" Foreground="White"/>
        </Border>

        <!-- Form Area -->
        <StackPanel Grid.Row="1" Margin="24,20">
            <!-- 품목명 -->
            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="품목" Style="{StaticResource Tran.Typography.Label}" Margin="0,0,0,4"/>
                <TextBlock x:Name="ProductNameText" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource Tran.Text.Primary}"/>
            </StackPanel>

            <!-- 현재 재고 -->
            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="현재 확정 재고" Style="{StaticResource Tran.Typography.Label}" Margin="0,0,0,4"/>
                <TextBlock x:Name="CurrentStockText" FontSize="14" FontWeight="Medium"
                           Foreground="{StaticResource Tran.Text.Primary}"/>
            </StackPanel>

            <!-- 조정 유형 -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <RadioButton x:Name="IncreaseRadio" Content="증가 (+)" IsChecked="True"
                             FontSize="14" Margin="0,0,20,0" VerticalContentAlignment="Center"
                             Foreground="{StaticResource Tran.Success}"/>
                <RadioButton x:Name="DecreaseRadio" Content="감소 (-)"
                             FontSize="14" VerticalContentAlignment="Center"
                             Foreground="{StaticResource Tran.Danger}"/>
            </StackPanel>

            <!-- 조정 수량 -->
            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="조정 수량" Style="{StaticResource Tran.Typography.Label}" Margin="0,0,0,6"/>
                <TextBox x:Name="AdjustmentQtyBox" TextAlignment="Right" Text="0"/>
            </StackPanel>

            <!-- 사유 -->
            <StackPanel Margin="0,0,0,8">
                <TextBlock Text="조정 사유" Style="{StaticResource Tran.Typography.Label}" Margin="0,0,0,6"/>
                <TextBox x:Name="ReasonBox" Height="60"
                         TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top"
                         Padding="12,10"/>
            </StackPanel>
        </StackPanel>

        <!-- Footer Buttons -->
        <Border Grid.Row="2" Background="{StaticResource Tran.Surface.Footer}" Padding="24,14"
                BorderBrush="{StaticResource Tran.Border.Light}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="취소" IsCancel="True"
                        Style="{StaticResource Tran.SecondaryButton}"
                        Width="100" Height="38" Margin="0,0,10,0"/>
                <Button Content="조정" Click="OkButton_Click"
                        Style="{StaticResource Tran.WarningButton}"
                        Width="100" Height="38"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
