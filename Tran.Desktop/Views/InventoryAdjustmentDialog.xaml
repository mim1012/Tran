<mah:MetroWindow x:Class="Tran.Desktop.Views.InventoryAdjustmentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        Title="재고 조정"
        Width="400" Height="320"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowMaxRestoreButton="False"
        ShowMinButton="False"
        TitleCharacterCasing="Normal"
        GlowBrush="{StaticResource Tran.Primary.500}"
        BorderThickness="1"
        WindowTransitionsEnabled="False">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 품목명 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="품목" FontSize="12" Foreground="Gray" Margin="0,0,0,4"/>
            <TextBlock x:Name="ProductNameText" FontSize="16" FontWeight="SemiBold"/>
        </StackPanel>

        <!-- 현재 재고 -->
        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <TextBlock Text="현재 확정 재고" FontSize="12" Foreground="Gray" Margin="0,0,0,4"/>
            <TextBlock x:Name="CurrentStockText" FontSize="14" FontWeight="Medium"/>
        </StackPanel>

        <!-- 조정 유형 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,15">
            <RadioButton x:Name="IncreaseRadio" Content="증가 (+)" IsChecked="True"
                         FontSize="14" Margin="0,0,20,0" VerticalContentAlignment="Center"/>
            <RadioButton x:Name="DecreaseRadio" Content="감소 (-)"
                         FontSize="14" VerticalContentAlignment="Center"/>
        </StackPanel>

        <!-- 조정 수량 -->
        <StackPanel Grid.Row="3" Margin="0,0,0,15">
            <TextBlock Text="조정 수량" FontSize="12" Foreground="Gray" Margin="0,0,0,4"/>
            <TextBox x:Name="AdjustmentQtyBox" FontSize="14" Padding="8,6"
                     TextAlignment="Right" Text="0"/>
        </StackPanel>

        <!-- 사유 -->
        <StackPanel Grid.Row="4" Margin="0,0,0,15">
            <TextBlock Text="조정 사유" FontSize="12" Foreground="Gray" Margin="0,0,0,4"/>
            <TextBox x:Name="ReasonBox" FontSize="13" Padding="8,6"
                     TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" Height="60"/>
        </StackPanel>

        <!-- 버튼 -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="취소" IsCancel="True"
                    Width="80" Height="32" Margin="0,0,8,0"
                    FontSize="13"/>
            <Button Content="조정" Click="OkButton_Click"
                    Width="80" Height="32"
                    FontSize="13" FontWeight="SemiBold"
                    Style="{StaticResource Tran.PrimaryButton}"/>
        </StackPanel>
    </Grid>
</mah:MetroWindow>
