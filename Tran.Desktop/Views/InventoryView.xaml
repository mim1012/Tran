<UserControl x:Class="Tran.Desktop.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Tran.Desktop.Converters"
             mc:Ignorable="d"
             Background="{StaticResource Tran.Surface.Background}"
             d:DesignHeight="700" d:DesignWidth="1000">

    <UserControl.InputBindings>
        <KeyBinding Key="F9" Command="{Binding RefreshCommand}"/>
    </UserControl.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="3"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6*"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="4*"/>
        </Grid.RowDefinitions>

        <!-- 오렌지 악센트 바 (3px) -->
        <Border Grid.Row="0" Background="{StaticResource Tran.Accent.Inventory}"
                Style="{StaticResource Tran.AccentBar}"/>

        <!-- 헤더: 타이틀 + 검색 + 재고 조정 버튼 -->
        <Border Grid.Row="1" Style="{StaticResource Tran.SectionHeader}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="재고 관리"
                           Style="{StaticResource Tran.Heading2}"
                           VerticalAlignment="Center"/>

                <!-- 검색 -->
                <Border Grid.Column="2" Style="{StaticResource Tran.SearchBox}"
                        Height="32" Margin="0,0,12,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#x1F50D;" FontSize="14"
                                   VerticalAlignment="Center" Margin="8,0,5,0"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Height="Auto"
                                 VerticalContentAlignment="Center"
                                 FontSize="13"
                                 Padding="2,0"/>
                    </Grid>
                </Border>

                <!-- 재고 조정 버튼 -->
                <Button Grid.Column="3"
                        Content="&#x1F4CB; F5 재고 조정"
                        Click="AdjustButton_Click"
                        Style="{StaticResource Tran.WarningButton}"/>
            </Grid>
        </Border>

        <!-- 부족 재고 알림 배너 -->
        <Border Grid.Row="2" VerticalAlignment="Top" Panel.ZIndex="1"
                Background="#FFF4E5" BorderBrush="#E67700" BorderThickness="0,0,0,1"
                Padding="15,8" Margin="15,0"
                Visibility="{Binding HasLowStockAlert, Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#x26A0;&#xFE0F;" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding LowStockAlertMessage}"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="#E67700" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Border>

        <!-- 메인 재고 DataGrid (읽기전용) -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding InventoryList}"
                  SelectedItem="{Binding SelectedProduct}"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  RowHeight="38"
                  BorderThickness="0"
                  Margin="15,10"
                  VirtualizingStackPanel.IsVirtualizing="True"
                  VirtualizingStackPanel.VirtualizationMode="Recycling">

            <DataGrid.Columns>
                <!-- 품목코드 -->
                <DataGridTextColumn Header="품목코드" Binding="{Binding ProductCode}" Width="120"/>

                <!-- 품목명 -->
                <DataGridTextColumn Header="품목명" Binding="{Binding ProductName}" Width="2*"/>

                <!-- 입고 -->
                <DataGridTextColumn Header="입고" Binding="{Binding PendingInQuantity}" Width="90">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Right"/>
                            <Setter Property="Padding" Value="0,0,8,0"/>
                            <Setter Property="Foreground" Value="{StaticResource Tran.Success}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 출고 -->
                <DataGridTextColumn Header="출고" Binding="{Binding PendingOutQuantity}" Width="90">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Right"/>
                            <Setter Property="Padding" Value="0,0,8,0"/>
                            <Setter Property="Foreground" Value="{StaticResource Tran.Danger}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 현재재고 -->
                <DataGridTextColumn Header="현재재고" Binding="{Binding ConfirmedQuantity}" Width="90">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Right"/>
                            <Setter Property="Padding" Value="0,0,8,0"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 안전재고 -->
                <DataGridTextColumn Header="안전재고" Binding="{Binding SafetyStock}" Width="90">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Right"/>
                            <Setter Property="Padding" Value="0,0,5,0"/>
                            <Setter Property="Foreground" Value="{StaticResource Tran.Neutral.400}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 재고 상태 (아이콘 + 색상) -->
                <DataGridTemplateColumn Header="상태" Width="100" SortMemberPath="StockStatusOrder">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock HorizontalAlignment="Center"
                                       FontSize="13" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="--"/>
                                        <Setter Property="Foreground" Value="{StaticResource Tran.Neutral.400}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StockStatus}" Value="정상">
                                                <Setter Property="Text" Value="&#x2705; 정상"/>
                                                <Setter Property="Foreground" Value="{StaticResource Tran.Success}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StockStatus}" Value="부족">
                                                <Setter Property="Text" Value="&#x26A0;&#xFE0F; 부족"/>
                                                <Setter Property="Foreground" Value="{StaticResource Tran.Warning}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StockStatus}" Value="품절">
                                                <Setter Property="Text" Value="&#x274C; 품절"/>
                                                <Setter Property="Foreground" Value="{StaticResource Tran.Danger}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- GridSplitter -->
        <GridSplitter Grid.Row="3"
                      Height="5"
                      HorizontalAlignment="Stretch"
                      Background="{StaticResource Tran.Neutral.200}"
                      ResizeDirection="Rows"
                      ShowsPreview="True"/>

        <!-- 하단 탭 영역 -->
        <TabControl Grid.Row="4" Margin="15,5,15,10">

            <!-- 탭 1: 입출고 이력 -->
            <TabItem Header="입출고 이력">
                <DataGrid ItemsSource="{Binding TransactionHistory}"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          RowHeight="35"
                          BorderThickness="0"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling">
                    <DataGrid.Columns>
                        <!-- 일시 -->
                        <DataGridTextColumn Header="일시" Binding="{Binding CreatedAt, StringFormat=MM-dd HH:mm}" Width="120"/>

                        <!-- 품목 -->
                        <DataGridTextColumn Header="품목" Binding="{Binding Product.ProductName}" Width="*"/>

                        <!-- 유형 (입고/출고/조정) -->
                        <DataGridTemplateColumn Header="유형" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="4" Padding="6,2"
                                            HorizontalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource Tran.State.Draft.Bg}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Type}" Value="Inbound">
                                                        <Setter Property="Background" Value="{StaticResource Tran.State.Confirmed.Bg}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Type}" Value="Outbound">
                                                        <Setter Property="Background" Value="{StaticResource Tran.State.Cancelled.Bg}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Type}" Value="Adjustment">
                                                        <Setter Property="Background" Value="{StaticResource Tran.State.RevisionRequested.Bg}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="11" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="--"/>
                                                    <Setter Property="Foreground" Value="{StaticResource Tran.Neutral.600}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Type}" Value="Inbound">
                                                            <Setter Property="Text" Value="입고"/>
                                                            <Setter Property="Foreground" Value="{StaticResource Tran.State.Confirmed.Fg}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Type}" Value="Outbound">
                                                            <Setter Property="Text" Value="출고"/>
                                                            <Setter Property="Foreground" Value="{StaticResource Tran.State.Cancelled.Fg}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Type}" Value="Adjustment">
                                                            <Setter Property="Text" Value="조정"/>
                                                            <Setter Property="Foreground" Value="{StaticResource Tran.State.RevisionRequested.Fg}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 수량 (+/-) -->
                        <DataGridTemplateColumn Header="수량" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Quantity, StringFormat={}{0:N0}}"
                                               HorizontalAlignment="Right"
                                               FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource Tran.Neutral.700}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Type}" Value="Inbound">
                                                        <Setter Property="Foreground" Value="{StaticResource Tran.Success}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Type}" Value="Outbound">
                                                        <Setter Property="Foreground" Value="{StaticResource Tran.Danger}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Type}" Value="Adjustment">
                                                        <Setter Property="Foreground" Value="{StaticResource Tran.State.RevisionRequested.Fg}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 참조 -->
                        <DataGridTextColumn Header="참조" Binding="{Binding ReferenceType}" Width="150"/>

                        <!-- 메모 -->
                        <DataGridTextColumn Header="메모" Binding="{Binding Note}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- 탭 2: 재고 요약 -->
            <TabItem Header="재고 요약">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="15">
                    <StackPanel Margin="10">
                        <!-- 요약 카드 영역 -->
                        <TextBlock Text="재고 현황 요약"
                                   Style="{StaticResource Tran.Heading3}"
                                   Margin="0,0,0,15"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 총 품목 수 -->
                            <Border Grid.Column="0" Style="{StaticResource Tran.SummaryCard}"
                                    Background="{StaticResource Tran.Neutral.50}"
                                    BorderBrush="{StaticResource Tran.Neutral.200}"
                                    Margin="0,0,8,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="총 품목 수" FontSize="12"
                                               Foreground="{StaticResource Tran.Neutral.400}"
                                               HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                    <TextBlock Text="{Binding TotalProductCount}"
                                               FontSize="24" FontWeight="Bold"
                                               Foreground="{StaticResource Tran.Neutral.800}"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- 정상 재고 -->
                            <Border Grid.Column="1" Style="{StaticResource Tran.SummaryCard}"
                                    Background="{StaticResource Tran.Success.Light}"
                                    BorderBrush="{StaticResource Tran.Success}"
                                    Margin="4,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="정상 재고" FontSize="12"
                                               Foreground="{StaticResource Tran.Success}"
                                               HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                    <TextBlock Text="{Binding NormalStockCount}"
                                               FontSize="24" FontWeight="Bold"
                                               Foreground="{StaticResource Tran.Success}"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- 부족 재고 -->
                            <Border Grid.Column="2" Style="{StaticResource Tran.SummaryCard}"
                                    Background="{StaticResource Tran.Warning.Light}"
                                    BorderBrush="{StaticResource Tran.Warning}"
                                    Margin="4,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="부족 재고" FontSize="12"
                                               Foreground="{StaticResource Tran.Warning}"
                                               HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                    <TextBlock Text="{Binding LowStockCount}"
                                               FontSize="24" FontWeight="Bold"
                                               Foreground="{StaticResource Tran.Warning}"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- 품절 -->
                            <Border Grid.Column="3" Style="{StaticResource Tran.SummaryCard}"
                                    Background="{StaticResource Tran.Danger.Light}"
                                    BorderBrush="{StaticResource Tran.Danger}"
                                    Margin="8,0,0,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="품절" FontSize="12"
                                               Foreground="{StaticResource Tran.Danger}"
                                               HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                    <TextBlock Text="{Binding OutOfStockCount}"
                                               FontSize="24" FontWeight="Bold"
                                               Foreground="{StaticResource Tran.Danger}"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- 안내 텍스트 -->
                        <TextBlock Text="* 재고 요약은 현재 확정 재고 기준입니다. 입고/출고 예정 수량은 포함되지 않습니다."
                                   Style="{StaticResource Tran.Caption}"
                                   Margin="0,20,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 탭 3: 발주 제안 -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="발주 제안" VerticalAlignment="Center"/>
                        <Border Background="{StaticResource Tran.Danger}"
                                CornerRadius="8" Padding="5,1" Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding SuggestionCount,
                            Converter={x:Static local:PositiveToVisibleConverter.Instance}}">
                            <TextBlock Text="{Binding SuggestionCount}"
                                       Foreground="White" FontSize="10" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                </TabItem.Header>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid Grid.Row="0"
                              ItemsSource="{Binding OrderSuggestions}"
                              IsReadOnly="False"
                              SelectionMode="Single"
                              RowHeight="38"
                              BorderThickness="0"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling">
                        <DataGrid.Columns>
                            <!-- 품목명 -->
                            <DataGridTextColumn Header="품목명" Binding="{Binding ProductName}" Width="2*" IsReadOnly="True"/>

                            <!-- 품목코드 -->
                            <DataGridTextColumn Header="코드" Binding="{Binding ProductCode}" Width="100" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource Tran.Neutral.500}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- 현재 재고 -->
                            <DataGridTextColumn Header="현재재고" Binding="{Binding CurrentStock}" Width="85" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Right"/>
                                        <Setter Property="Padding" Value="0,0,8,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- 안전재고 -->
                            <DataGridTextColumn Header="안전재고" Binding="{Binding SafetyStock}" Width="85" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Right"/>
                                        <Setter Property="Padding" Value="0,0,8,0"/>
                                        <Setter Property="Foreground" Value="{StaticResource Tran.Neutral.400}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- 부족수량 -->
                            <DataGridTextColumn Header="부족수량" Binding="{Binding ShortageQty}" Width="85" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Right"/>
                                        <Setter Property="Padding" Value="0,0,8,0"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="{StaticResource Tran.Danger}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- 추천 발주량 (편집 가능) -->
                            <DataGridTextColumn Header="추천발주량" Binding="{Binding SuggestedQty, UpdateSourceTrigger=PropertyChanged}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Right"/>
                                        <Setter Property="Padding" Value="0,0,8,0"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Background" Value="{StaticResource Tran.Warning.Light}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Background" Value="{StaticResource Tran.Warning.Light}"/>
                                        <Setter Property="TextAlignment" Value="Right"/>
                                        <Setter Property="Padding" Value="0,0,5,0"/>
                                    </Style>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>

                            <!-- 추천 거래처 -->
                            <DataGridTextColumn Header="추천거래처" Binding="{Binding SuggestedCompanyName}" Width="150" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource Tran.Primary.600}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- 추천 단가 -->
                            <DataGridTextColumn Header="추천단가" Binding="{Binding SuggestedUnitPrice, StringFormat={}{0:N0}}" Width="100" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Right"/>
                                        <Setter Property="Padding" Value="0,0,8,0"/>
                                        <Setter Property="Foreground" Value="{StaticResource Tran.Neutral.600}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- 발주 버튼 -->
                            <DataGridTemplateColumn Header="" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="발주"
                                                Command="{Binding DataContext.CreateOrderCommand,
                                                    RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource Tran.PrimaryButton}"
                                                Height="26" Padding="10,0" FontSize="11"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- 하단: 전체 발주 생성 버튼 -->
                    <Border Grid.Row="1" Padding="10,8"
                            BorderBrush="{StaticResource Tran.Neutral.200}" BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       VerticalAlignment="Center" FontSize="12"
                                       Foreground="{StaticResource Tran.Neutral.500}">
                                <Run Text="* 추천발주량은 안전재고 x 2 - 현재재고로 산출됩니다. 수량 편집 후 발주 가능합니다."/>
                            </TextBlock>

                            <Button Grid.Column="1"
                                    Content="전체 발주 생성"
                                    Command="{Binding CreateAllOrdersCommand}"
                                    Style="{StaticResource Tran.SuccessButton}"
                                    Padding="20,6"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
