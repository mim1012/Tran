<UserControl x:Class="Tran.Desktop.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="White"
             d:DesignHeight="700" d:DesignWidth="1000">

    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding AdjustInventoryCommand}"/>
        <KeyBinding Key="F9" Command="{Binding RefreshCommand}"/>
    </UserControl.InputBindings>

    <UserControl.Resources>
        <!-- 공통 DataGrid 컬럼 헤더 스타일 -->
        <Style x:Key="InventoryColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F5F5F5"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <!-- 공통 DataGrid 셀 스타일 -->
        <Style x:Key="InventoryCellStyle" TargetType="DataGridCell">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#F0F0F0"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FFF5E6"/>
                    <Setter Property="Foreground" Value="#000"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 금액/수량 오른쪽 정렬 -->
        <Style x:Key="RightAlignStyle" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Padding" Value="0,0,5,0"/>
        </Style>

        <!-- 오렌지 버튼 스타일 -->
        <Style x:Key="OrangeButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F39C12"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E67E22"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#F5D6A0"/>
                    <Setter Property="Foreground" Value="#A0A0A0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 하단 탭 DataGrid 셀 스타일 -->
        <Style x:Key="TransactionCellStyle" TargetType="DataGridCell">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderBrush" Value="#F0F0F0"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FFF5E6"/>
                    <Setter Property="Foreground" Value="#000"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="3"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6*"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="4*"/>
        </Grid.RowDefinitions>

        <!-- 오렌지 악센트 바 (3px) -->
        <Border Grid.Row="0" Background="#F39C12"/>

        <!-- 헤더: 타이틀 + 검색 + 재고 조정 버튼 -->
        <Border Grid.Row="1" Background="#F8F9FA" Padding="15,12" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="재고 관리"
                           FontSize="20" FontWeight="Bold"
                           Foreground="#2C3E50"
                           VerticalAlignment="Center"/>

                <!-- 검색 -->
                <Border Grid.Column="2" BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="4"
                        Height="32" Margin="0,0,12,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#x1F50D;" FontSize="14"
                                   VerticalAlignment="Center" Margin="8,0,5,0"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 BorderThickness="0"
                                 VerticalContentAlignment="Center"
                                 FontSize="13"
                                 Padding="2,0">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Foreground" Value="#333"/>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Grid>
                </Border>

                <!-- 재고 조정 버튼 -->
                <Button Grid.Column="3"
                        Content="&#x1F4CB; 재고 조정"
                        Command="{Binding AdjustInventoryCommand}"
                        Style="{StaticResource OrangeButtonStyle}"/>
            </Grid>
        </Border>

        <!-- 메인 재고 DataGrid (읽기전용) -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding InventoryList}"
                  SelectedItem="{Binding SelectedProduct}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  Background="White"
                  RowHeight="38"
                  BorderThickness="0"
                  Margin="15,10"
                  ColumnHeaderStyle="{StaticResource InventoryColumnHeaderStyle}"
                  CellStyle="{StaticResource InventoryCellStyle}"
                  VirtualizingStackPanel.IsVirtualizing="True"
                  VirtualizingStackPanel.VirtualizationMode="Recycling">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="BorderThickness" Value="3,0,0,0"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#FFF8EE"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#FAFAFA"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.Columns>
                <!-- 품목코드 -->
                <DataGridTextColumn Header="품목코드" Binding="{Binding ProductCode}" Width="120"/>

                <!-- 품목명 -->
                <DataGridTextColumn Header="품목명" Binding="{Binding ProductName}" Width="2*"/>

                <!-- 카테고리 -->
                <DataGridTextColumn Header="카테고리" Binding="{Binding Category}" Width="100"/>

                <!-- 확정재고 -->
                <DataGridTextColumn Header="확정재고" Binding="{Binding ConfirmedQuantity}" Width="90">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Right"/>
                            <Setter Property="Padding" Value="0,0,8,0"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 입고예정 -->
                <DataGridTextColumn Header="입고예정" Binding="{Binding PendingInQuantity}" Width="90">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Right"/>
                            <Setter Property="Padding" Value="0,0,8,0"/>
                            <Setter Property="Foreground" Value="#27AE60"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 출고예정 -->
                <DataGridTextColumn Header="출고예정" Binding="{Binding PendingOutQuantity}" Width="90">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Right"/>
                            <Setter Property="Padding" Value="0,0,8,0"/>
                            <Setter Property="Foreground" Value="#E74C3C"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 가용재고 -->
                <DataGridTextColumn Header="가용재고" Binding="{Binding AvailableQuantity}" Width="90">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Right"/>
                            <Setter Property="Padding" Value="0,0,8,0"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Foreground" Value="#1E90FF"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 안전재고 -->
                <DataGridTextColumn Header="안전재고" Binding="{Binding SafetyStock}" Width="90">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource RightAlignStyle}">
                            <Setter Property="Foreground" Value="#95A5A6"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 재고 상태 (아이콘 + 색상) -->
                <DataGridTemplateColumn Header="상태" Width="100" SortMemberPath="StockStatusOrder">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock HorizontalAlignment="Center"
                                       FontSize="13" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="--"/>
                                        <Setter Property="Foreground" Value="#95A5A6"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StockStatus}" Value="정상">
                                                <Setter Property="Text" Value="&#x2705; 정상"/>
                                                <Setter Property="Foreground" Value="#27AE60"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StockStatus}" Value="부족">
                                                <Setter Property="Text" Value="&#x26A0;&#xFE0F; 부족"/>
                                                <Setter Property="Foreground" Value="#F39C12"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StockStatus}" Value="품절">
                                                <Setter Property="Text" Value="&#x274C; 품절"/>
                                                <Setter Property="Foreground" Value="#E74C3C"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- GridSplitter -->
        <GridSplitter Grid.Row="3"
                      Height="5"
                      HorizontalAlignment="Stretch"
                      Background="#E0E0E0"
                      ResizeDirection="Rows"
                      ShowsPreview="True"/>

        <!-- 하단 탭 영역 -->
        <TabControl Grid.Row="4" Margin="15,5,15,10" BorderBrush="#E0E0E0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Padding" Value="12,6"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Foreground" Value="#555"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="#F39C12"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TabControl.Resources>

            <!-- 탭 1: 입출고 이력 -->
            <TabItem Header="입출고 이력">
                <DataGrid ItemsSource="{Binding TransactionHistory}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          Background="White"
                          RowHeight="35"
                          BorderThickness="0"
                          ColumnHeaderStyle="{StaticResource InventoryColumnHeaderStyle}"
                          CellStyle="{StaticResource TransactionCellStyle}"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling">
                    <DataGrid.Columns>
                        <!-- 일시 -->
                        <DataGridTextColumn Header="일시" Binding="{Binding CreatedAt, StringFormat=MM-dd HH:mm}" Width="120"/>

                        <!-- 품목 -->
                        <DataGridTextColumn Header="품목" Binding="{Binding Product.ProductName}" Width="*"/>

                        <!-- 유형 (입고/출고/조정) -->
                        <DataGridTemplateColumn Header="유형" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="4" Padding="6,2"
                                            HorizontalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#F0F0F0"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Type}" Value="Inbound">
                                                        <Setter Property="Background" Value="#E6F4EA"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Type}" Value="Outbound">
                                                        <Setter Property="Background" Value="#FFE5E5"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Type}" Value="Adjustment">
                                                        <Setter Property="Background" Value="#FFF4E5"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="11" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="--"/>
                                                    <Setter Property="Foreground" Value="#555"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Type}" Value="Inbound">
                                                            <Setter Property="Text" Value="입고"/>
                                                            <Setter Property="Foreground" Value="#1E7F34"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Type}" Value="Outbound">
                                                            <Setter Property="Text" Value="출고"/>
                                                            <Setter Property="Foreground" Value="#C92A2A"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Type}" Value="Adjustment">
                                                            <Setter Property="Text" Value="조정"/>
                                                            <Setter Property="Foreground" Value="#E67700"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 수량 (+/-) -->
                        <DataGridTemplateColumn Header="수량" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Quantity, StringFormat={}{0:N0}}"
                                               HorizontalAlignment="Right"
                                               FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#333"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Type}" Value="Inbound">
                                                        <Setter Property="Foreground" Value="#27AE60"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Type}" Value="Outbound">
                                                        <Setter Property="Foreground" Value="#E74C3C"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Type}" Value="Adjustment">
                                                        <Setter Property="Foreground" Value="#E67700"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 참조 -->
                        <DataGridTextColumn Header="참조" Binding="{Binding ReferenceType}" Width="150"/>

                        <!-- 메모 -->
                        <DataGridTextColumn Header="메모" Binding="{Binding Note}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- 탭 2: 재고 요약 -->
            <TabItem Header="재고 요약">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="15">
                    <StackPanel Margin="10">
                        <!-- 요약 카드 영역 -->
                        <TextBlock Text="재고 현황 요약" FontSize="16" FontWeight="Bold"
                                   Foreground="#2C3E50" Margin="0,0,0,15"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 총 품목 수 -->
                            <Border Grid.Column="0" Background="#F8F9FA" CornerRadius="6"
                                    Padding="15" Margin="0,0,8,0" BorderBrush="#E0E0E0" BorderThickness="1">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="총 품목 수" FontSize="12" Foreground="#95A5A6"
                                               HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                    <TextBlock Text="{Binding TotalProductCount}"
                                               FontSize="24" FontWeight="Bold" Foreground="#2C3E50"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- 정상 재고 -->
                            <Border Grid.Column="1" Background="#E6F4EA" CornerRadius="6"
                                    Padding="15" Margin="4,0" BorderBrush="#C3E6CB" BorderThickness="1">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="정상 재고" FontSize="12" Foreground="#27AE60"
                                               HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                    <TextBlock Text="{Binding NormalStockCount}"
                                               FontSize="24" FontWeight="Bold" Foreground="#27AE60"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- 부족 재고 -->
                            <Border Grid.Column="2" Background="#FFF5E6" CornerRadius="6"
                                    Padding="15" Margin="4,0" BorderBrush="#FFE0B2" BorderThickness="1">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="부족 재고" FontSize="12" Foreground="#F39C12"
                                               HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                    <TextBlock Text="{Binding LowStockCount}"
                                               FontSize="24" FontWeight="Bold" Foreground="#F39C12"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- 품절 -->
                            <Border Grid.Column="3" Background="#FDEDEC" CornerRadius="6"
                                    Padding="15" Margin="8,0,0,0" BorderBrush="#F5C6CB" BorderThickness="1">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="품절" FontSize="12" Foreground="#E74C3C"
                                               HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                    <TextBlock Text="{Binding OutOfStockCount}"
                                               FontSize="24" FontWeight="Bold" Foreground="#E74C3C"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- 안내 텍스트 -->
                        <TextBlock Text="* 재고 요약은 현재 확정 재고 기준입니다. 입고/출고 예정 수량은 포함되지 않습니다."
                                   FontSize="12" Foreground="#95A5A6" Margin="0,20,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
