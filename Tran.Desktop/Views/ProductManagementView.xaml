<UserControl x:Class="Tran.Desktop.Views.ProductManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{StaticResource Tran.Surface.Background}"
             d:DesignHeight="650" d:DesignWidth="1000">

    <UserControl.Resources>
        <!-- BooleanToVisibilityConverter -->
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 헤더: 타이틀 + 검색 + 추가 버튼 -->
        <Border Grid.Row="0" Style="{StaticResource Tran.SectionHeader}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="품목 관리"
                           Style="{StaticResource Tran.Heading2}"
                           VerticalAlignment="Center"/>

                <!-- 회사 필터 ComboBox -->
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding FilterCompanies}"
                          SelectedItem="{Binding SelectedCompanyFilter}"
                          DisplayMemberPath="CompanyName"
                          Height="32" Width="180"
                          Margin="15,0,0,0"
                          VerticalContentAlignment="Center"
                          FontSize="13">
                    <ComboBox.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="전체 회사"/>
                        </Style>
                    </ComboBox.Resources>
                </ComboBox>

                <!-- 전체 버튼 -->
                <Button Grid.Column="2"
                        Content="전체"
                        Command="{Binding ClearFilterCommand}"
                        Style="{StaticResource Tran.SecondaryButton}"
                        Height="32" Padding="10,0"
                        Margin="5,0,0,0"
                        FontSize="12"/>

                <!-- 검색 -->
                <Border Grid.Column="4" Style="{StaticResource Tran.SearchBox}"
                        Height="32" Margin="0,0,12,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Data="{StaticResource Tran.Icon.Search}"
                              Fill="{StaticResource Tran.Neutral.400}"
                              Width="14" Height="14" Stretch="Uniform"
                              VerticalAlignment="Center" Margin="8,0,5,0"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Height="Auto"
                                 VerticalContentAlignment="Center"
                                 FontSize="13"
                                 Padding="2,0"/>
                    </Grid>
                </Border>

                <!-- ㄱ순 정렬 버튼 -->
                <Button Grid.Column="5"
                        Content="ㄱ순 정렬"
                        Command="{Binding SortProductsCommand}"
                        Style="{StaticResource Tran.SecondaryButton}"
                        Margin="0,0,8,0"/>

                <!-- 품목 추가 버튼 -->
                <Button Grid.Column="6"
                        Content="+ 품목 추가"
                        Command="{Binding AddProductCommand}"
                        Style="{StaticResource Tran.PrimaryButton}"/>
            </Grid>
        </Border>

        <!-- 메인 영역: DataGrid -->
        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Products}"
                  SelectedItem="{Binding SelectedProduct}"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  RowHeight="40"
                  BorderThickness="0"
                  Margin="15,10"
                  VirtualizingStackPanel.IsVirtualizing="True"
                  VirtualizingStackPanel.VirtualizationMode="Recycling">

            <DataGrid.Columns>
                <!-- 회사명 -->
                <DataGridTextColumn Header="회사명" Binding="{Binding CompanyNames}" Width="180">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource Tran.Neutral.600}"/>
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="ToolTip" Value="{Binding CompanyNames}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 품목명 -->
                <DataGridTextColumn Header="품목명" Binding="{Binding ProductName}" Width="2*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 카테고리 -->
                <DataGridTemplateColumn Header="카테고리" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource Tran.State.Draft.Bg}" CornerRadius="4"
                                    Padding="8,3" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding Category}"
                                           FontSize="12" Foreground="{StaticResource Tran.Neutral.600}"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- 단위 -->
                <DataGridTextColumn Header="단위" Binding="{Binding Unit}" Width="70">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="Foreground" Value="{StaticResource Tran.Neutral.600}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 기본단가 -->
                <DataGridTextColumn Header="기본단가" Binding="{Binding DefaultPrice, StringFormat=&#x20A9;{0:N0}}" Width="130">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Right"/>
                            <Setter Property="Padding" Value="0,0,8,0"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Foreground" Value="{StaticResource Tran.Primary.600}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 활성 상태 -->
                <DataGridTemplateColumn Header="상태" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="비활성"/>
                                        <Setter Property="Foreground" Value="{StaticResource Tran.Danger}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Text" Value="활성"/>
                                                <Setter Property="Foreground" Value="{StaticResource Tran.Success}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- 삭제 버튼 -->
                <DataGridTemplateColumn Header="" Width="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.DeleteProductCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    Style="{StaticResource Tran.IconButton.Danger}"
                                    ToolTip="품목 삭제">
                                <Path Data="{StaticResource Tran.Icon.Close}"
                                      Fill="{StaticResource Tran.Danger}"
                                      Width="12" Height="12" Stretch="Uniform"/>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 하단: 편집 폼 (IsEditing=True일 때만 표시) -->
        <Border Grid.Row="2"
                Background="{StaticResource Tran.Surface.Section}"
                BorderBrush="{StaticResource Tran.Neutral.200}"
                BorderThickness="0,1,0,0"
                Padding="20,15"
                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 편집 헤더 -->
                <Grid Grid.Row="0" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="품목 편집"
                               Style="{StaticResource Tran.Heading3}"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1"
                            Content="취소"
                            Command="{Binding CancelEditCommand}"
                            Style="{StaticResource Tran.SecondaryButton}"
                            Height="30" Padding="12,4" FontSize="12"/>
                </Grid>

                <!-- 1행: 품목코드 + 품목명 -->
                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="품목코드:"
                               Style="{StaticResource Tran.Label}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding EditingProduct.ProductCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsNewProduct}"/>

                    <TextBlock Grid.Column="3" Text="품목명:"
                               Style="{StaticResource Tran.Label}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Grid.Column="4"
                             Text="{Binding EditingProduct.ProductName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>

                <!-- 2행: 카테고리 + 단위 + 기본단가 -->
                <Grid Grid.Row="2" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="카테고리:"
                               Style="{StaticResource Tran.Label}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding Categories}"
                              Text="{Binding EditingProduct.Category, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              IsEditable="True"/>

                    <TextBlock Grid.Column="3" Text="단위:"
                               Style="{StaticResource Tran.Label}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Grid.Column="4"
                              ItemsSource="{Binding Units}"
                              Text="{Binding EditingProduct.Unit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              IsEditable="True"/>

                    <TextBlock Grid.Column="6" Text="기본단가:"
                               Style="{StaticResource Tran.Label}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Grid.Column="7"
                             Text="{Binding EditingProduct.DefaultPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N0}}"
                             TextAlignment="Right"/>
                </Grid>

                <!-- 3행: 활성 상태 + 저장 버튼 -->
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0"
                              Content="활성 품목"
                              IsChecked="{Binding EditingProduct.IsActive, Mode=TwoWay}"
                              FontSize="13" VerticalAlignment="Center"
                              VerticalContentAlignment="Center"/>

                    <Button Grid.Column="2"
                            Content="저장"
                            Command="{Binding SaveProductCommand}"
                            Style="{StaticResource Tran.SuccessButton}"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
