<UserControl x:Class="Tran.Desktop.Views.QuotationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="White"
             d:DesignHeight="750" d:DesignWidth="1100">

    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding ConfirmCommand}"/>
        <KeyBinding Key="F6" Command="{Binding SaveDraftCommand}"/>
        <KeyBinding Key="F7" Command="{Binding AddProductCommand}"/>
    </UserControl.InputBindings>

    <UserControl.Resources>
        <!-- 공통 DataGrid 컬럼 헤더 스타일 -->
        <Style x:Key="QuotationColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F5F5F5"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <!-- 공통 셀 스타일 -->
        <Style x:Key="QuotationCellStyle" TargetType="DataGridCell">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#F0F0F0"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E8F1FF"/>
                    <Setter Property="Foreground" Value="#000"/>
                </Trigger>
                <Trigger Property="IsEditing" Value="True">
                    <Setter Property="Background" Value="#FFF9E6"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 금액 오른쪽 정렬 -->
        <Style x:Key="RightAlignStyle" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Padding" Value="0,0,5,0"/>
        </Style>

        <!-- 파란색 주요 버튼 스타일 -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E90FF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1A7AD9"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#B0D4F1"/>
                    <Setter Property="Foreground" Value="#A0A0A0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 보조 버튼 스타일 -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#95A5A6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#7F8C8D"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 긍정 버튼 스타일 -->
        <Style x:Key="SuccessButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#27AE60"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#219A52"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#A3D9B1"/>
                    <Setter Property="Foreground" Value="#A0A0A0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 작은 복사 버튼 스타일 -->
        <Style x:Key="SmallCopyButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#ECF0F1"/>
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#BDC3C7"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D5DBDB"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="3"/>
            <RowDefinition Height="6*"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="4*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 파란색 악센트 바 (3px) -->
        <Border Grid.Row="0" Background="#1E90FF"/>

        <!-- 상단 영역: 좌(견적 작성 폼 65%) + 우(단가 변경 미리보기 35%) -->
        <Grid Grid.Row="1" Margin="15,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="65*"/>
                <ColumnDefinition Width="35*"/>
            </Grid.ColumnDefinitions>

            <!-- 좌측: 견적서 작성 폼 -->
            <Grid Grid.Column="0" Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 타이틀 -->
                <TextBlock Grid.Row="0" Text="견적서 작성"
                           FontSize="20" FontWeight="Bold"
                           Foreground="#2C3E50" Margin="0,0,0,12"/>

                <!-- 기본 정보 -->
                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="거래처:"
                               FontSize="14" FontWeight="Bold" Foreground="#555"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding Companies}"
                              SelectedItem="{Binding SelectedCompany}"
                              DisplayMemberPath="CompanyName"
                              Height="32" FontSize="13" Padding="8,5"
                              Margin="0,0,15,0"/>

                    <TextBlock Grid.Column="2" Text="유효기간:"
                               FontSize="14" FontWeight="Bold" Foreground="#555"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <DatePicker Grid.Column="3"
                                SelectedDate="{Binding ValidUntilDate}"
                                Height="32" FontSize="13" Padding="5,3"/>
                </Grid>

                <!-- 품목 DataGrid (편집 가능) -->
                <DataGrid Grid.Row="2"
                          ItemsSource="{Binding CurrentItems}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          RowHeaderWidth="0"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          Background="White"
                          RowHeight="36"
                          BorderBrush="#E0E0E0"
                          BorderThickness="1"
                          ColumnHeaderStyle="{StaticResource QuotationColumnHeaderStyle}"
                          CellStyle="{StaticResource QuotationCellStyle}"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling">
                    <DataGrid.Columns>
                        <!-- 품목명 (읽기전용) -->
                        <DataGridTextColumn Header="품목" Binding="{Binding ProductName}" Width="2*" IsReadOnly="True"/>

                        <!-- 수량 (편집 가능) -->
                        <DataGridTextColumn Header="수량" Binding="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="80" IsReadOnly="False">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource RightAlignStyle}"/>
                            </DataGridTextColumn.ElementStyle>
                            <DataGridTextColumn.EditingElementStyle>
                                <Style TargetType="TextBox">
                                    <Setter Property="Background" Value="#FFF9E6"/>
                                    <Setter Property="BorderBrush" Value="#1E90FF"/>
                                    <Setter Property="Padding" Value="4,2"/>
                                </Style>
                            </DataGridTextColumn.EditingElementStyle>
                        </DataGridTextColumn>

                        <!-- 단가 (편집 가능) -->
                        <DataGridTextColumn Header="단가" Binding="{Binding UnitPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N0}}" Width="110" IsReadOnly="False">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Right"/>
                                    <Setter Property="Padding" Value="0,0,5,0"/>
                                    <Setter Property="Foreground" Value="#1E90FF"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                            <DataGridTextColumn.EditingElementStyle>
                                <Style TargetType="TextBox">
                                    <Setter Property="Background" Value="#FFF9E6"/>
                                    <Setter Property="BorderBrush" Value="#1E90FF"/>
                                    <Setter Property="Padding" Value="4,2"/>
                                </Style>
                            </DataGridTextColumn.EditingElementStyle>
                        </DataGridTextColumn>

                        <!-- 금액 (계산, 읽기전용) -->
                        <DataGridTextColumn Header="금액" Binding="{Binding LineAmount, StringFormat=₩{0:N0}, Mode=OneWay}" Width="130" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Right"/>
                                    <Setter Property="Padding" Value="0,0,5,0"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="#1E5EFF"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- 삭제 버튼 -->
                        <DataGridTemplateColumn Header="" Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="&#x2716;"
                                            Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent" Foreground="#E74C3C"
                                            BorderThickness="0" FontSize="14"
                                            Cursor="Hand" ToolTip="품목 제거"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- F7 품목 추가 버튼 -->
                <Button Grid.Row="3"
                        Content="F7 품목 추가"
                        Command="{Binding AddProductCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        HorizontalAlignment="Left"
                        Margin="0,8,0,8"/>

                <!-- 합계 + 메모 -->
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="합계:"
                               FontSize="16" FontWeight="Bold" Foreground="#555"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding TotalAmount, StringFormat=₩{0:N0}}"
                               FontSize="20" FontWeight="Bold" Foreground="#1E90FF"
                               VerticalAlignment="Center" Margin="0,0,20,0"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="메모:" FontSize="13" Foreground="#555"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Text="{Binding Memo, UpdateSourceTrigger=PropertyChanged}"
                                 Width="200" Height="32" FontSize="13" Padding="8,5"
                                 VerticalContentAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- 우측: 단가 변경 미리보기 -->
            <Border Grid.Column="1" Background="#FAFBFC" BorderBrush="#E0E0E0"
                    BorderThickness="1" CornerRadius="6" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 미리보기 헤더 -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="단가 변경 미리보기"
                                   FontSize="16" FontWeight="Bold" Foreground="#2C3E50"/>
                        <TextBlock Text="현재 견적 단가와 기존 단가 비교"
                                   FontSize="12" Foreground="#95A5A6" Margin="0,3,0,0"/>
                    </StackPanel>

                    <!-- 단가 비교 DataGrid -->
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding PricePreview}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              RowHeaderWidth="0"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              Background="White"
                              RowHeight="34"
                              BorderBrush="#E0E0E0"
                              BorderThickness="1"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F0F4F8"/>
                                <Setter Property="Foreground" Value="#555"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="BorderBrush" Value="#E0E0E0"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.Columns>
                            <!-- 품목 -->
                            <DataGridTextColumn Header="품목" Binding="{Binding ProductName}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontSize" Value="12"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- 현재 단가 -->
                            <DataGridTextColumn Header="현재" Binding="{Binding CurrentPrice, StringFormat=₩{0:N0}}" Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Right"/>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="Foreground" Value="#95A5A6"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- 변경 단가 -->
                            <DataGridTextColumn Header="변경" Binding="{Binding NewPrice, StringFormat=₩{0:N0}}" Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Right"/>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="#1E90FF"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- 변동 표시 -->
                            <DataGridTemplateColumn Header="" Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock HorizontalAlignment="Center"
                                                   FontSize="13" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value=""/>
                                                    <Setter Property="Foreground" Value="#95A5A6"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ChangeDirection}" Value="Up">
                                                            <Setter Property="Text" Value="&#x2191;"/>
                                                            <Setter Property="Foreground" Value="#E74C3C"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ChangeDirection}" Value="Down">
                                                            <Setter Property="Text" Value="&#x2193;"/>
                                                            <Setter Property="Foreground" Value="#27AE60"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ChangeDirection}" Value="New">
                                                            <Setter Property="Text" Value="(신규)"/>
                                                            <Setter Property="Foreground" Value="#1E90FF"/>
                                                            <Setter Property="FontSize" Value="11"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- GridSplitter -->
        <GridSplitter Grid.Row="2"
                      Height="5"
                      HorizontalAlignment="Stretch"
                      Background="#E0E0E0"
                      ResizeDirection="Rows"
                      ShowsPreview="True"/>

        <!-- 하단: 탭 (견적 목록 / 단가 이력) -->
        <TabControl Grid.Row="3" Margin="15,5,15,5" BorderBrush="#E0E0E0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Padding" Value="12,6"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Foreground" Value="#555"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="#1E90FF"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TabControl.Resources>

            <!-- 탭 1: 견적 목록 -->
            <TabItem Header="견적 목록">
                <DataGrid ItemsSource="{Binding QuotationHistory}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          Background="White"
                          RowHeight="35"
                          BorderThickness="0"
                          ColumnHeaderStyle="{StaticResource QuotationColumnHeaderStyle}"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling">
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="8,5"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="BorderBrush" Value="#F0F0F0"/>
                            <Setter Property="BorderThickness" Value="0,0,1,0"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#E8F1FF"/>
                                    <Setter Property="Foreground" Value="#000"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>

                    <DataGrid.Columns>
                        <!-- 견적번호 -->
                        <DataGridTextColumn Header="견적번호" Binding="{Binding QuotationId}" Width="130"/>

                        <!-- 거래처 -->
                        <DataGridTextColumn Header="거래처" Binding="{Binding Company.CompanyName}" Width="150"/>

                        <!-- 일자 -->
                        <DataGridTextColumn Header="일자" Binding="{Binding QuotationDate, StringFormat=yyyy-MM-dd}" Width="100"/>

                        <!-- 유효기간 -->
                        <DataGridTextColumn Header="유효기간" Binding="{Binding ValidUntil, StringFormat=yyyy-MM-dd}" Width="100"/>

                        <!-- 상태 -->
                        <DataGridTemplateColumn Header="상태" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="6" Padding="8,3"
                                            HorizontalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#F0F0F0"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding State}" Value="Draft">
                                                        <Setter Property="Background" Value="#F0F0F0"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="Sent">
                                                        <Setter Property="Background" Value="#E8F1FF"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="UnderReview">
                                                        <Setter Property="Background" Value="#FFF4E5"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="Confirmed">
                                                        <Setter Property="Background" Value="#E6F4EA"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="RevisionRequested">
                                                        <Setter Property="Background" Value="#FFE5E5"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="Expired">
                                                        <Setter Property="Background" Value="#F5F5F5"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="11" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="알 수 없음"/>
                                                    <Setter Property="Foreground" Value="#555555"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding State}" Value="Draft">
                                                            <Setter Property="Text" Value="작성중"/>
                                                            <Setter Property="Foreground" Value="#555555"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding State}" Value="Sent">
                                                            <Setter Property="Text" Value="발송됨"/>
                                                            <Setter Property="Foreground" Value="#1E5EFF"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding State}" Value="UnderReview">
                                                            <Setter Property="Text" Value="검토중"/>
                                                            <Setter Property="Foreground" Value="#E67700"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding State}" Value="Confirmed">
                                                            <Setter Property="Text" Value="확정"/>
                                                            <Setter Property="Foreground" Value="#1E7F34"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding State}" Value="RevisionRequested">
                                                            <Setter Property="Text" Value="수정요청"/>
                                                            <Setter Property="Foreground" Value="#C92A2A"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding State}" Value="Expired">
                                                            <Setter Property="Text" Value="만료"/>
                                                            <Setter Property="Foreground" Value="#868E96"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 금액 -->
                        <DataGridTextColumn Header="금액" Binding="{Binding TotalAmount, StringFormat=₩{0:N0}}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Right"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- 복사 버튼 (TODO: CopyQuotationCommand 구현 후 활성화) -->
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- 탭 2: 단가 이력 (TODO: PriceHistory VM 속성 구현 후 활성화) -->
            <TabItem Header="단가 이력">
                <DataGrid
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          Background="White"
                          RowHeight="35"
                          BorderThickness="0"
                          ColumnHeaderStyle="{StaticResource QuotationColumnHeaderStyle}"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling">
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="8,5"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="BorderBrush" Value="#F0F0F0"/>
                            <Setter Property="BorderThickness" Value="0,0,1,0"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#E8F1FF"/>
                                    <Setter Property="Foreground" Value="#000"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>

                    <DataGrid.Columns>
                        <!-- 변경일 -->
                        <DataGridTextColumn Header="변경일" Binding="{Binding ChangedDate, StringFormat=yyyy-MM-dd}" Width="110"/>

                        <!-- 품목 -->
                        <DataGridTextColumn Header="품목" Binding="{Binding ProductName}" Width="*"/>

                        <!-- 거래처 -->
                        <DataGridTextColumn Header="거래처" Binding="{Binding CompanyName}" Width="130"/>

                        <!-- 이전 단가 -->
                        <DataGridTextColumn Header="이전 단가" Binding="{Binding PreviousPrice, StringFormat=₩{0:N0}}" Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Right"/>
                                    <Setter Property="Foreground" Value="#95A5A6"/>
                                    <Setter Property="TextDecorations" Value="Strikethrough"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- 변경 단가 -->
                        <DataGridTextColumn Header="변경 단가" Binding="{Binding NewPrice, StringFormat=₩{0:N0}}" Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Right"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="#1E90FF"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- 변동률 -->
                        <DataGridTemplateColumn Header="변동" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ChangePercentDisplay}"
                                               HorizontalAlignment="Center"
                                               FontSize="12" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#555"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsIncrease}" Value="True">
                                                        <Setter Property="Foreground" Value="#E74C3C"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsIncrease}" Value="False">
                                                        <Setter Property="Foreground" Value="#27AE60"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 참조 견적번호 -->
                        <DataGridTextColumn Header="견적번호" Binding="{Binding QuotationId}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <!-- 하단 버튼 바 -->
        <Border Grid.Row="4" Background="#F8F9FA" Padding="15,10" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 왼쪽: 상태 표시 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="13" Foreground="#95A5A6"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 오른쪽: 버튼들 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="F6 임시저장"
                            Command="{Binding SaveDraftCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,8,0"/>

                    <Button Command="{Binding SendCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x1F4E4;" FontSize="13" Margin="0,0,5,0"/>
                            <TextBlock Text="발송" FontSize="13"/>
                        </StackPanel>
                    </Button>

                    <Button Content="F5 확정"
                            Command="{Binding ConfirmCommand}"
                            Style="{StaticResource SuccessButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
