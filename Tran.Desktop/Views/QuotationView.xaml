<UserControl x:Class="Tran.Desktop.Views.QuotationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{StaticResource Tran.Surface.Background}"
             d:DesignHeight="750" d:DesignWidth="1100">

    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding ConfirmCommand}"/>
        <KeyBinding Key="F6" Command="{Binding SaveDraftCommand}"/>
    </UserControl.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="3"/>
            <RowDefinition Height="6*"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="4*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 파란색 악센트 바 (3px) -->
        <Border Grid.Row="0" Background="{StaticResource Tran.Primary.600}"/>

        <!-- 상단 영역: 좌(견적 작성 폼 65%) + 우(단가 변경 미리보기 35%) -->
        <Grid Grid.Row="1" Margin="15,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="65*" MinWidth="300"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="35*" MinWidth="200"/>
            </Grid.ColumnDefinitions>

            <!-- 좌측: 견적서 작성 폼 -->
            <Grid Grid.Column="0" Margin="0,0,5,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 타이틀 -->
                <TextBlock Grid.Row="0" Text="견적서 작성"
                           FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource Tran.Neutral.800}" Margin="0,0,0,12"/>

                <!-- 기본 정보 -->
                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="거래처:"
                               FontSize="14" FontWeight="Bold" Foreground="{StaticResource Tran.Neutral.500}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding CompanyName, FallbackValue='(거래처 미선택)'}"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource Tran.Neutral.800}"
                               VerticalAlignment="Center" Margin="0,0,15,0"/>

                    <TextBlock Grid.Column="2" Text="유효기간:"
                               FontSize="14" FontWeight="Bold" Foreground="{StaticResource Tran.Neutral.500}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <DatePicker Grid.Column="3"
                                SelectedDate="{Binding ValidUntilDate}"
                                Height="32" FontSize="13" Padding="5,3"/>
                </Grid>

                <!-- 품목 DataGrid (편집 가능) -->
                <DataGrid Grid.Row="2"
                          ItemsSource="{Binding CurrentItems}"
                          CanUserDeleteRows="False"
                          RowHeight="36"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling">
                    <DataGrid.Columns>
                        <!-- 품목명 (읽기전용) -->
                        <DataGridTextColumn Header="품목" Binding="{Binding ProductName}" Width="2*" IsReadOnly="True"/>

                        <!-- 수량 (편집 가능) -->
                        <DataGridTextColumn Header="수량" Binding="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="80" IsReadOnly="False">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Right"/>
                                    <Setter Property="Padding" Value="0,0,5,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                            <DataGridTextColumn.EditingElementStyle>
                                <Style TargetType="TextBox">
                                    <Setter Property="Background" Value="{StaticResource Tran.Warning.Light}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource Tran.Primary.600}"/>
                                    <Setter Property="Padding" Value="4,2"/>
                                    <Setter Property="Height" Value="Auto"/>
                                </Style>
                            </DataGridTextColumn.EditingElementStyle>
                        </DataGridTextColumn>

                        <!-- 단가 (편집 가능) -->
                        <DataGridTextColumn Header="단가" Binding="{Binding UnitPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N0}}" Width="110" IsReadOnly="False">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Right"/>
                                    <Setter Property="Padding" Value="0,0,5,0"/>
                                    <Setter Property="Foreground" Value="{StaticResource Tran.Primary.600}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                            <DataGridTextColumn.EditingElementStyle>
                                <Style TargetType="TextBox">
                                    <Setter Property="Background" Value="{StaticResource Tran.Warning.Light}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource Tran.Primary.600}"/>
                                    <Setter Property="Padding" Value="4,2"/>
                                    <Setter Property="Height" Value="Auto"/>
                                </Style>
                            </DataGridTextColumn.EditingElementStyle>
                        </DataGridTextColumn>

                        <!-- 금액 (계산, 읽기전용) -->
                        <DataGridTextColumn Header="금액" Binding="{Binding LineAmount, StringFormat=&#x20A9;{0:N0}, Mode=OneWay}" Width="130" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Right"/>
                                    <Setter Property="Padding" Value="0,0,5,0"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="{StaticResource Tran.State.Sent.Fg}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- 삭제 버튼 -->
                        <DataGridTemplateColumn Header="" Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="&#x2716;"
                                            Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource Tran.GhostButton}"
                                            Foreground="{StaticResource Tran.Danger}"
                                            Height="Auto" Width="Auto" Padding="4,2"
                                            FontSize="14"
                                            ToolTip="품목 제거"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- F7 품목 추가 버튼 -->
                <Button Grid.Row="3"
                        Content="F7 품목 추가"
                        Click="AddProduct_Click"
                        Style="{StaticResource Tran.PrimaryButton}"
                        HorizontalAlignment="Left"
                        Margin="0,8,0,8"/>

                <!-- 합계 + 메모 -->
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="합계:"
                               FontSize="16" FontWeight="Bold" Foreground="{StaticResource Tran.Neutral.500}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding TotalAmount, StringFormat=&#x20A9;{0:N0}}"
                               FontSize="20" FontWeight="Bold" Foreground="{StaticResource Tran.Primary.600}"
                               VerticalAlignment="Center" Margin="0,0,20,0"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="메모:" FontSize="13" Foreground="{StaticResource Tran.Neutral.500}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Text="{Binding Memo, UpdateSourceTrigger=PropertyChanged}"
                                 Width="200" Height="32" FontSize="13" Padding="8,5"
                                 VerticalContentAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- 좌우 GridSplitter -->
            <GridSplitter Grid.Column="1"
                          Width="5"
                          VerticalAlignment="Stretch"
                          Background="{StaticResource Tran.Neutral.200}"
                          ResizeBehavior="PreviousAndNext"
                          Cursor="SizeWE"/>

            <!-- 우측: 단가 변경 미리보기 -->
            <Border Grid.Column="2" Style="{StaticResource Tran.Card}" Padding="12" Margin="5,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 미리보기 헤더 -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="단가 변경 미리보기"
                                   FontSize="16" FontWeight="Bold" Foreground="{StaticResource Tran.Neutral.800}"/>
                        <TextBlock Text="현재 견적 단가와 기존 단가 비교"
                                   FontSize="12" Foreground="{StaticResource Tran.Neutral.400}" Margin="0,3,0,0"/>
                    </StackPanel>

                    <!-- 단가 비교 DataGrid -->
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding PricePreview}"
                              IsReadOnly="True"
                              RowHeight="34"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling">

                        <DataGrid.Columns>
                            <!-- 품목 -->
                            <DataGridTextColumn Header="품목" Binding="{Binding ProductName}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontSize" Value="12"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- 현재 단가 -->
                            <DataGridTextColumn Header="현재" Binding="{Binding CurrentPrice, StringFormat=&#x20A9;{0:N0}}" Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Right"/>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="Foreground" Value="{StaticResource Tran.Neutral.400}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- 변경 단가 -->
                            <DataGridTextColumn Header="변경" Binding="{Binding NewPrice, StringFormat=&#x20A9;{0:N0}}" Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Right"/>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="{StaticResource Tran.Primary.600}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- 변동 표시 -->
                            <DataGridTemplateColumn Header="" Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock HorizontalAlignment="Center"
                                                   FontSize="13" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value=""/>
                                                    <Setter Property="Foreground" Value="{StaticResource Tran.Neutral.400}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ChangeDirection}" Value="Up">
                                                            <Setter Property="Text" Value="&#x2191;"/>
                                                            <Setter Property="Foreground" Value="{StaticResource Tran.Danger}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ChangeDirection}" Value="Down">
                                                            <Setter Property="Text" Value="&#x2193;"/>
                                                            <Setter Property="Foreground" Value="{StaticResource Tran.Success}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ChangeDirection}" Value="New">
                                                            <Setter Property="Text" Value="(신규)"/>
                                                            <Setter Property="Foreground" Value="{StaticResource Tran.Primary.600}"/>
                                                            <Setter Property="FontSize" Value="11"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- GridSplitter -->
        <GridSplitter Grid.Row="2"
                      Height="5"
                      HorizontalAlignment="Stretch"
                      Background="{StaticResource Tran.Neutral.200}"
                      ResizeDirection="Rows"
                      Cursor="SizeNS"/>

        <!-- 하단: 탭 (견적 목록 / 단가 이력) -->
        <TabControl Grid.Row="3" Margin="15,5,15,5">

            <!-- 탭 1: 견적 목록 -->
            <TabItem Header="견적 목록">
                <DataGrid ItemsSource="{Binding QuotationHistory}"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          RowHeight="35"
                          BorderThickness="0"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling">

                    <DataGrid.Columns>
                        <!-- 견적번호 -->
                        <DataGridTextColumn Header="견적번호" Binding="{Binding QuotationId}" Width="130"/>

                        <!-- 거래처 -->
                        <DataGridTextColumn Header="거래처" Binding="{Binding Company.CompanyName}" Width="150"/>

                        <!-- 일자 -->
                        <DataGridTextColumn Header="일자" Binding="{Binding QuotationDate, StringFormat=yyyy-MM-dd}" Width="100"/>

                        <!-- 유효기간 -->
                        <DataGridTextColumn Header="유효기간" Binding="{Binding ValidUntil, StringFormat=yyyy-MM-dd}" Width="100"/>

                        <!-- 상태 -->
                        <DataGridTemplateColumn Header="상태" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="6" Padding="8,3"
                                            HorizontalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource Tran.State.Draft.Bg}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding State}" Value="Draft">
                                                        <Setter Property="Background" Value="{StaticResource Tran.State.Draft.Bg}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="Sent">
                                                        <Setter Property="Background" Value="{StaticResource Tran.State.Sent.Bg}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="UnderReview">
                                                        <Setter Property="Background" Value="{StaticResource Tran.State.RevisionRequested.Bg}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="Confirmed">
                                                        <Setter Property="Background" Value="{StaticResource Tran.State.Confirmed.Bg}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="RevisionRequested">
                                                        <Setter Property="Background" Value="{StaticResource Tran.State.Cancelled.Bg}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="Expired">
                                                        <Setter Property="Background" Value="{StaticResource Tran.Neutral.50}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="11" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="알 수 없음"/>
                                                    <Setter Property="Foreground" Value="{StaticResource Tran.State.Draft.Fg}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding State}" Value="Draft">
                                                            <Setter Property="Text" Value="작성중"/>
                                                            <Setter Property="Foreground" Value="{StaticResource Tran.State.Draft.Fg}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding State}" Value="Sent">
                                                            <Setter Property="Text" Value="발송됨"/>
                                                            <Setter Property="Foreground" Value="{StaticResource Tran.State.Sent.Fg}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding State}" Value="UnderReview">
                                                            <Setter Property="Text" Value="검토중"/>
                                                            <Setter Property="Foreground" Value="{StaticResource Tran.State.RevisionRequested.Fg}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding State}" Value="Confirmed">
                                                            <Setter Property="Text" Value="확정"/>
                                                            <Setter Property="Foreground" Value="{StaticResource Tran.State.Confirmed.Fg}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding State}" Value="RevisionRequested">
                                                            <Setter Property="Text" Value="수정요청"/>
                                                            <Setter Property="Foreground" Value="{StaticResource Tran.State.Cancelled.Fg}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding State}" Value="Expired">
                                                            <Setter Property="Text" Value="만료"/>
                                                            <Setter Property="Foreground" Value="{StaticResource Tran.Neutral.400}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 금액 -->
                        <DataGridTextColumn Header="금액" Binding="{Binding TotalAmount, StringFormat=&#x20A9;{0:N0}}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Right"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- 복사 버튼 (TODO: CopyQuotationCommand 구현 후 활성화) -->
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- 탭 2: 단가 이력 -->
            <TabItem Header="단가 이력">
                <DataGrid ItemsSource="{Binding PriceHistory}"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          RowHeight="35"
                          BorderThickness="0"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling">

                    <DataGrid.Columns>
                        <!-- 변경일 -->
                        <DataGridTextColumn Header="변경일" Binding="{Binding ChangedDate, StringFormat=yyyy-MM-dd}" Width="110"/>

                        <!-- 품목 -->
                        <DataGridTextColumn Header="품목" Binding="{Binding ProductName}" Width="*"/>

                        <!-- 거래처 -->
                        <DataGridTextColumn Header="거래처" Binding="{Binding CompanyName}" Width="130"/>

                        <!-- 이전 단가 -->
                        <DataGridTextColumn Header="이전 단가" Binding="{Binding PreviousPrice, StringFormat=&#x20A9;{0:N0}}" Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Right"/>
                                    <Setter Property="Foreground" Value="{StaticResource Tran.Neutral.400}"/>
                                    <Setter Property="TextDecorations" Value="Strikethrough"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- 변경 단가 -->
                        <DataGridTextColumn Header="변경 단가" Binding="{Binding NewPrice, StringFormat=&#x20A9;{0:N0}}" Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Right"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="{StaticResource Tran.Primary.600}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- 변동률 -->
                        <DataGridTemplateColumn Header="변동" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ChangePercentDisplay}"
                                               HorizontalAlignment="Center"
                                               FontSize="12" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource Tran.Neutral.500}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsIncrease}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource Tran.Danger}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsIncrease}" Value="False">
                                                        <Setter Property="Foreground" Value="{StaticResource Tran.Success}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 참조 견적번호 -->
                        <DataGridTextColumn Header="견적번호" Binding="{Binding QuotationId}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <!-- 하단 버튼 바 -->
        <Border Grid.Row="4" Background="{StaticResource Tran.Surface.Footer}" Padding="15,10"
                BorderBrush="{StaticResource Tran.Neutral.200}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 왼쪽: 상태 표시 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="13" Foreground="{StaticResource Tran.Neutral.400}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 오른쪽: 버튼들 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="F6 임시저장"
                            Command="{Binding SaveDraftCommand}"
                            Style="{StaticResource Tran.SecondaryButton}"
                            Margin="0,0,8,0"/>

                    <Button Command="{Binding SendCommand}"
                            Style="{StaticResource Tran.PrimaryButton}"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x1F4E4;" FontSize="13" Margin="0,0,5,0"/>
                            <TextBlock Text="발송" FontSize="13"/>
                        </StackPanel>
                    </Button>

                    <Button Content="F5 확정"
                            Command="{Binding ConfirmCommand}"
                            Style="{StaticResource Tran.SuccessButton}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
