<UserControl x:Class="Tran.Desktop.Views.PurchaseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{StaticResource Tran.Surface.Background}"
             d:DesignHeight="700" d:DesignWidth="1000">

    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding ConfirmDeliveryCommand}"/>
        <KeyBinding Key="F9" Command="{Binding RefreshCommand}"/>
    </UserControl.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="3"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 보라색 악센트 바 (3px) -->
        <Border Grid.Row="0" Background="{StaticResource Tran.Accent.Purchase}"/>

        <!-- 헤더: 타이틀 + 필터 -->
        <Border Grid.Row="1" Background="{StaticResource Tran.Neutral.50}" Padding="15,12"
                BorderBrush="{StaticResource Tran.Neutral.200}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="구매 관리"
                           FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource Tran.Neutral.800}"
                           VerticalAlignment="Center"/>

                <!-- 상태 필터 -->
                <TextBlock Grid.Column="2" Text="상태:"
                           VerticalAlignment="Center" FontSize="14"
                           Margin="0,0,8,0" Foreground="{StaticResource Tran.Neutral.500}"/>
                <ComboBox Grid.Column="3"
                          SelectedItem="{Binding StateFilter}"
                          Width="140"
                          Margin="0,0,15,0"
                          xmlns:sys="clr-namespace:System;assembly=System.Runtime">
                    <sys:String>전체</sys:String>
                    <sys:String>입고대기</sys:String>
                    <sys:String>부분입고</sys:String>
                    <sys:String>입고완료</sys:String>
                </ComboBox>
            </Grid>
        </Border>

        <!-- 마스터: 구매 목록 DataGrid -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Purchases}"
                  SelectedItem="{Binding SelectedPurchase}"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  RowHeight="40"
                  BorderThickness="0"
                  Margin="15,10"
                  VirtualizingStackPanel.IsVirtualizing="True"
                  VirtualizingStackPanel.VirtualizationMode="Recycling">

            <DataGrid.Columns>
                <!-- 구매번호 -->
                <DataGridTextColumn Header="구매번호" Binding="{Binding PurchaseId}" Width="130"/>

                <!-- 발주번호 -->
                <DataGridTextColumn Header="발주번호" Binding="{Binding OrderId}" Width="130"/>

                <!-- 거래처 -->
                <DataGridTextColumn Header="거래처" Binding="{Binding Company.CompanyName}" Width="150"/>

                <!-- 상태 (색상 배지) -->
                <DataGridTemplateColumn Header="상태" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="6"
                                    Padding="10,4"
                                    HorizontalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource Tran.State.Draft.Bg}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding State}" Value="PendingDelivery">
                                                <Setter Property="Background" Value="{StaticResource Tran.State.RevisionRequested.Bg}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="PartiallyDelivered">
                                                <Setter Property="Background" Value="{StaticResource Tran.State.Sent.Bg}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="Delivered">
                                                <Setter Property="Background" Value="{StaticResource Tran.State.Confirmed.Bg}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="Cancelled">
                                                <Setter Property="Background" Value="{StaticResource Tran.State.Cancelled.Bg}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontSize="12"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="알 수 없음"/>
                                            <Setter Property="Foreground" Value="{StaticResource Tran.State.Draft.Fg}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding State}" Value="PendingDelivery">
                                                    <Setter Property="Text" Value="입고대기"/>
                                                    <Setter Property="Foreground" Value="{StaticResource Tran.State.RevisionRequested.Fg}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="PartiallyDelivered">
                                                    <Setter Property="Text" Value="부분입고"/>
                                                    <Setter Property="Foreground" Value="{StaticResource Tran.State.Sent.Fg}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Delivered">
                                                    <Setter Property="Text" Value="입고완료"/>
                                                    <Setter Property="Foreground" Value="{StaticResource Tran.State.Confirmed.Fg}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Cancelled">
                                                    <Setter Property="Text" Value="취소"/>
                                                    <Setter Property="Foreground" Value="{StaticResource Tran.State.Cancelled.Fg}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- 금액 -->
                <DataGridTextColumn Header="금액" Binding="{Binding TotalAmount, StringFormat=&#x20A9;{0:N0}}" Width="130">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Right"/>
                            <Setter Property="Padding" Value="0,0,5,0"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 일자 -->
                <DataGridTextColumn Header="구매일자" Binding="{Binding PurchaseDate, StringFormat=yyyy-MM-dd}" Width="110"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- GridSplitter -->
        <GridSplitter Grid.Row="3"
                      Height="5"
                      HorizontalAlignment="Stretch"
                      Background="{StaticResource Tran.Neutral.200}"
                      ResizeDirection="Rows"
                      ShowsPreview="True"/>

        <!-- 디테일: 입고 상세 -->
        <Border Grid.Row="4" Background="{StaticResource Tran.Surface.Background}"
                BorderBrush="{StaticResource Tran.Neutral.200}" BorderThickness="0,1,0,0">
            <Grid Margin="15,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 디테일 없을 때 안내 -->
                <TextBlock Grid.Row="0" Grid.RowSpan="3"
                           Text="구매 건을 선택하면 입고 상세 내역을 확인할 수 있습니다."
                           Foreground="{StaticResource Tran.Neutral.400}" FontSize="14"
                           HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedPurchase}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- 디테일 내용 (SelectedPurchase가 있을 때만 표시) -->
                <Grid Grid.Row="0" Grid.RowSpan="3">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedPurchase}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 디테일 헤더 -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Background="{StaticResource Tran.Accent.Purchase}" CornerRadius="3" Padding="8,4" Margin="0,0,10,0">
                            <TextBlock Text="입고 상세" Foreground="White" FontSize="13" FontWeight="Bold"/>
                        </Border>
                        <TextBlock Text="{Binding SelectedPurchase.PurchaseId, StringFormat=({0})}"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource Tran.Neutral.800}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- 입고 상세 DataGrid (편집 가능) -->
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding SelectedPurchaseItems}"
                              CanUserDeleteRows="False"
                              RowHeight="38"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling">

                        <DataGrid.Columns>
                            <!-- 품목명 (읽기전용) -->
                            <DataGridTextColumn Header="품목명" Binding="{Binding ProductName}" Width="2*" IsReadOnly="True"/>

                            <!-- 발주수량 (읽기전용) -->
                            <DataGridTextColumn Header="발주수량" Binding="{Binding OrderedQuantity}" Width="100" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Right"/>
                                        <Setter Property="Padding" Value="0,0,5,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- 입고수량 (편집 가능) -->
                            <DataGridTextColumn Header="입고수량" Binding="{Binding ReceivedQuantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100" IsReadOnly="False">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Right"/>
                                        <Setter Property="Padding" Value="0,0,5,0"/>
                                        <Setter Property="Foreground" Value="{StaticResource Tran.Primary.600}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Background" Value="{StaticResource Tran.Warning.Light}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource Tran.Accent.Purchase}"/>
                                        <Setter Property="Padding" Value="4,2"/>
                                        <Setter Property="Height" Value="Auto"/>
                                    </Style>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>

                            <!-- 불량수량 (편집 가능) -->
                            <DataGridTextColumn Header="불량" Binding="{Binding DefectQuantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="80" IsReadOnly="False">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Right"/>
                                        <Setter Property="Padding" Value="0,0,5,0"/>
                                        <Setter Property="Foreground" Value="{StaticResource Tran.Danger}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Background" Value="{StaticResource Tran.Danger.Light}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource Tran.Danger}"/>
                                        <Setter Property="Padding" Value="4,2"/>
                                        <Setter Property="Height" Value="Auto"/>
                                    </Style>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>

                            <!-- 단가 (읽기전용) -->
                            <DataGridTextColumn Header="단가" Binding="{Binding UnitPrice, StringFormat=&#x20A9;{0:N0}}" Width="110" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Right"/>
                                        <Setter Property="Padding" Value="0,0,5,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- 금액 (읽기전용, 계산) -->
                            <DataGridTextColumn Header="금액" Binding="{Binding LineAmount, StringFormat=&#x20A9;{0:N0}}" Width="130" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Right"/>
                                        <Setter Property="Padding" Value="0,0,5,0"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="{StaticResource Tran.Accent.Purchase}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- 하단: 합계 + 버튼 -->
                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- 합계 금액 -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="합계 금액:" FontSize="14" FontWeight="Bold" Foreground="{StaticResource Tran.Neutral.500}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding SelectedPurchase.TotalAmount, StringFormat=&#x20A9;{0:N0}}"
                                       FontSize="18" FontWeight="Bold" Foreground="{StaticResource Tran.Accent.Purchase}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- F5 입고 확정 버튼 -->
                        <Button Grid.Column="1"
                                Content="F5 입고 확정"
                                Command="{Binding ConfirmDeliveryCommand}"
                                Style="{StaticResource Tran.PurchaseButton}"/>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
