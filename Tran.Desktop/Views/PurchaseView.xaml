<UserControl x:Class="Tran.Desktop.Views.PurchaseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="White"
             d:DesignHeight="700" d:DesignWidth="1000">

    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding ConfirmDeliveryCommand}"/>
        <KeyBinding Key="F9" Command="{Binding RefreshCommand}"/>
    </UserControl.InputBindings>

    <UserControl.Resources>
        <!-- 공통 DataGrid 컬럼 헤더 스타일 -->
        <Style x:Key="PurchaseColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F5F5F5"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <!-- 공통 DataGrid 셀 스타일 -->
        <Style x:Key="PurchaseCellStyle" TargetType="DataGridCell">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#F0F0F0"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#F3E8FF"/>
                    <Setter Property="Foreground" Value="#000"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 금액 오른쪽 정렬 스타일 -->
        <Style x:Key="RightAlignTextStyle" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Padding" Value="0,0,5,0"/>
        </Style>

        <!-- 보라색 버튼 스타일 -->
        <Style x:Key="PurpleButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#9B59B6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#8E44AD"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#D5C4DF"/>
                    <Setter Property="Foreground" Value="#A0A0A0"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="3"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 보라색 악센트 바 (3px) -->
        <Border Grid.Row="0" Background="#9B59B6"/>

        <!-- 헤더: 타이틀 + 필터 -->
        <Border Grid.Row="1" Background="#F8F9FA" Padding="15,12" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="구매 관리"
                           FontSize="20" FontWeight="Bold"
                           Foreground="#2C3E50"
                           VerticalAlignment="Center"/>

                <!-- 상태 필터 -->
                <TextBlock Grid.Column="2" Text="상태:"
                           VerticalAlignment="Center" FontSize="14"
                           Margin="0,0,8,0" Foreground="#555"/>
                <ComboBox Grid.Column="3"
                          SelectedItem="{Binding StateFilter}"
                          Height="32" Width="140"
                          Padding="8,5" FontSize="13"
                          Margin="0,0,15,0"
                          xmlns:sys="clr-namespace:System;assembly=System.Runtime">
                    <sys:String>전체</sys:String>
                    <sys:String>입고대기</sys:String>
                    <sys:String>부분입고</sys:String>
                    <sys:String>입고완료</sys:String>
                </ComboBox>
            </Grid>
        </Border>

        <!-- 마스터: 구매 목록 DataGrid -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Purchases}"
                  SelectedItem="{Binding SelectedPurchase}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  Background="White"
                  RowHeight="40"
                  BorderThickness="0"
                  Margin="15,10"
                  ColumnHeaderStyle="{StaticResource PurchaseColumnHeaderStyle}"
                  CellStyle="{StaticResource PurchaseCellStyle}"
                  VirtualizingStackPanel.IsVirtualizing="True"
                  VirtualizingStackPanel.VirtualizationMode="Recycling">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="BorderThickness" Value="3,0,0,0"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#F9F4FC"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#FAFAFA"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.Columns>
                <!-- 구매번호 -->
                <DataGridTextColumn Header="구매번호" Binding="{Binding PurchaseId}" Width="130"/>

                <!-- 발주번호 -->
                <DataGridTextColumn Header="발주번호" Binding="{Binding OrderId}" Width="130"/>

                <!-- 거래처 -->
                <DataGridTextColumn Header="거래처" Binding="{Binding Company.CompanyName}" Width="150"/>

                <!-- 상태 (색상 배지) -->
                <DataGridTemplateColumn Header="상태" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="6"
                                    Padding="10,4"
                                    HorizontalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#F0F0F0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding State}" Value="PendingDelivery">
                                                <Setter Property="Background" Value="#FFF4E5"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="PartiallyDelivered">
                                                <Setter Property="Background" Value="#E8F1FF"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="Delivered">
                                                <Setter Property="Background" Value="#E6F4EA"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="Cancelled">
                                                <Setter Property="Background" Value="#FFE5E5"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontSize="12"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="알 수 없음"/>
                                            <Setter Property="Foreground" Value="#555555"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding State}" Value="PendingDelivery">
                                                    <Setter Property="Text" Value="입고대기"/>
                                                    <Setter Property="Foreground" Value="#E67700"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="PartiallyDelivered">
                                                    <Setter Property="Text" Value="부분입고"/>
                                                    <Setter Property="Foreground" Value="#1E5EFF"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Delivered">
                                                    <Setter Property="Text" Value="입고완료"/>
                                                    <Setter Property="Foreground" Value="#1E7F34"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Cancelled">
                                                    <Setter Property="Text" Value="취소"/>
                                                    <Setter Property="Foreground" Value="#C92A2A"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- 금액 -->
                <DataGridTextColumn Header="금액" Binding="{Binding TotalAmount, StringFormat=₩{0:N0}}" Width="130">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource RightAlignTextStyle}">
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 일자 -->
                <DataGridTextColumn Header="구매일자" Binding="{Binding PurchaseDate, StringFormat=yyyy-MM-dd}" Width="110"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- GridSplitter -->
        <GridSplitter Grid.Row="3"
                      Height="5"
                      HorizontalAlignment="Stretch"
                      Background="#E0E0E0"
                      ResizeDirection="Rows"
                      ShowsPreview="True"/>

        <!-- 디테일: 입고 상세 -->
        <Border Grid.Row="4" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <Grid Margin="15,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 디테일 없을 때 안내 -->
                <TextBlock Grid.Row="0" Grid.RowSpan="3"
                           Text="구매 건을 선택하면 입고 상세 내역을 확인할 수 있습니다."
                           Foreground="#95A5A6" FontSize="14"
                           HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedPurchase}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- 디테일 내용 (SelectedPurchase가 있을 때만 표시) -->
                <Grid Grid.Row="0" Grid.RowSpan="3">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedPurchase}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 디테일 헤더 -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Background="#9B59B6" CornerRadius="3" Padding="8,4" Margin="0,0,10,0">
                            <TextBlock Text="입고 상세" Foreground="White" FontSize="13" FontWeight="Bold"/>
                        </Border>
                        <TextBlock Text="{Binding SelectedPurchase.PurchaseId, StringFormat=({0})}"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="#2C3E50"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- 입고 상세 DataGrid (편집 가능) -->
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding SelectedPurchaseItems}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              RowHeaderWidth="0"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              Background="White"
                              RowHeight="38"
                              BorderBrush="#E0E0E0"
                              BorderThickness="1"
                              ColumnHeaderStyle="{StaticResource PurchaseColumnHeaderStyle}"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling">
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="10,5"/>
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="BorderBrush" Value="#F0F0F0"/>
                                <Setter Property="BorderThickness" Value="0,0,1,0"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#F3E8FF"/>
                                        <Setter Property="Foreground" Value="#000"/>
                                    </Trigger>
                                    <Trigger Property="IsEditing" Value="True">
                                        <Setter Property="Background" Value="#FFF9E6"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>

                        <DataGrid.Columns>
                            <!-- 품목명 (읽기전용) -->
                            <DataGridTextColumn Header="품목명" Binding="{Binding ProductName}" Width="2*" IsReadOnly="True"/>

                            <!-- 발주수량 (읽기전용) -->
                            <DataGridTextColumn Header="발주수량" Binding="{Binding OrderedQuantity}" Width="100" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource RightAlignTextStyle}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- 입고수량 (편집 가능) -->
                            <DataGridTextColumn Header="입고수량" Binding="{Binding ReceivedQuantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100" IsReadOnly="False">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Right"/>
                                        <Setter Property="Padding" Value="0,0,5,0"/>
                                        <Setter Property="Foreground" Value="#1E90FF"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Background" Value="#FFF9E6"/>
                                        <Setter Property="BorderBrush" Value="#9B59B6"/>
                                        <Setter Property="Padding" Value="4,2"/>
                                    </Style>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>

                            <!-- 불량수량 (편집 가능) -->
                            <DataGridTextColumn Header="불량" Binding="{Binding DefectQuantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="80" IsReadOnly="False">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Right"/>
                                        <Setter Property="Padding" Value="0,0,5,0"/>
                                        <Setter Property="Foreground" Value="#E74C3C"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Background" Value="#FFF0F0"/>
                                        <Setter Property="BorderBrush" Value="#E74C3C"/>
                                        <Setter Property="Padding" Value="4,2"/>
                                    </Style>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>

                            <!-- 단가 (읽기전용) -->
                            <DataGridTextColumn Header="단가" Binding="{Binding UnitPrice, StringFormat=₩{0:N0}}" Width="110" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource RightAlignTextStyle}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- 금액 (읽기전용, 계산) -->
                            <DataGridTextColumn Header="금액" Binding="{Binding LineAmount, StringFormat=₩{0:N0}}" Width="130" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Right"/>
                                        <Setter Property="Padding" Value="0,0,5,0"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#9B59B6"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- 하단: 합계 + 버튼 -->
                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- 합계 금액 -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="합계 금액:" FontSize="14" FontWeight="Bold" Foreground="#555"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding SelectedPurchase.TotalAmount, StringFormat=₩{0:N0}}"
                                       FontSize="18" FontWeight="Bold" Foreground="#9B59B6"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- F5 입고 확정 버튼 -->
                        <Button Grid.Column="1"
                                Content="F5 입고 확정"
                                Command="{Binding ConfirmDeliveryCommand}"
                                Style="{StaticResource PurpleButtonStyle}"/>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
