<Window x:Class="Tran.Desktop.Views.ProductSelectionPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Tran.Desktop.Views"
        mc:Ignorable="d"
        Title="품목 선택"
        Width="600" Height="700"
        WindowStyle="ToolWindow"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Tran.Surface.Background}"
        ResizeMode="CanResizeWithGrip"
        FontFamily="{StaticResource Tran.FontFamily}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
        <KeyBinding Key="F" Modifiers="Ctrl" Command="{Binding FocusSearchCommand}"/>
        <KeyBinding Key="Return" Command="{Binding ConfirmCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 헤더 (피플카 스타일: 다크 네이비 배경) -->
        <Border Grid.Row="0" Background="{StaticResource Tran.Primary.900}" Padding="15,12"
                BorderBrush="{StaticResource Tran.Primary.800}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="품목 선택"
                           FontSize="16" FontWeight="Bold"
                           Foreground="White" VerticalAlignment="Center"/>

                <Button Grid.Column="1" Content="X 닫기"
                        Command="{Binding CancelCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        Height="28" Padding="10,0"
                        FontSize="12"
                        Style="{StaticResource Tran.SecondaryButton}"/>
            </Grid>
        </Border>

        <!-- 검색 바 -->
        <Border Grid.Row="1" Padding="15,10"
                BorderBrush="{StaticResource Tran.Neutral.200}" BorderThickness="0,0,0,1">
            <Border BorderBrush="{StaticResource Tran.Neutral.200}" BorderThickness="1"
                    CornerRadius="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="&#x1F50D;"
                               VerticalAlignment="Center"
                               Margin="10,0,5,0" FontSize="14" Foreground="{StaticResource Tran.Neutral.400}"/>
                    <TextBox Grid.Column="1" Name="SearchTextBox"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             BorderThickness="0" Padding="5,8"
                             FontSize="14" VerticalContentAlignment="Center"
                             Background="Transparent"/>
                </Grid>
            </Border>
        </Border>

        <!-- 품목 체크박스 리스트 -->
        <ListView Grid.Row="2"
                  ItemsSource="{Binding FilteredProducts}"
                  BorderThickness="0"
                  Margin="0"
                  VirtualizingStackPanel.IsVirtualizing="True"
                  VirtualizingStackPanel.VirtualizationMode="Recycling"
                  ScrollViewer.CanContentScroll="True"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="10,8"
                            BorderBrush="{StaticResource Tran.Neutral.100}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- 체크박스 -->
                            <CheckBox Grid.Column="0"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,10,0"/>

                            <!-- 품목 정보 -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ProductName}"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource Tran.Neutral.800}"/>
                                <TextBlock Text="{Binding ProductCode}"
                                           FontSize="11" Foreground="{StaticResource Tran.Neutral.400}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- 단가 -->
                            <TextBlock Grid.Column="2"
                                       FontSize="13" Foreground="{StaticResource Tran.Primary.600}"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Margin="0,0,15,0">
                                <Run Text="&#x20A9;"/>
                                <Run Text="{Binding DefaultPrice, StringFormat=\{0:N0\}, Mode=OneWay}"/>
                            </TextBlock>

                            <!-- 단위 -->
                            <TextBlock Grid.Column="3"
                                       FontSize="12" Foreground="{StaticResource Tran.Neutral.400}"
                                       VerticalAlignment="Center"
                                       Text="{Binding Unit}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="5,0"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource Tran.Neutral.50}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>

        <!-- 선택 품목 수량 입력 섹션 헤더 -->
        <Border Grid.Row="3" Padding="15,10" Background="{StaticResource Tran.Neutral.50}"
                BorderBrush="{StaticResource Tran.Neutral.200}" BorderThickness="0,1,0,0"
                Visibility="{Binding HasSelectedProducts, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock FontSize="14" FontWeight="Bold" Foreground="{StaticResource Tran.Neutral.800}">
                <Run Text="선택 품목 수량 입력 ("/>
                <Run Text="{Binding SelectedProductCount, Mode=OneWay}"/>
                <Run Text="개)"/>
            </TextBlock>
        </Border>

        <!-- 선택된 품목 수량 입력 DataGrid -->
        <DataGrid Grid.Row="4"
                  ItemsSource="{Binding SelectedProducts}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  RowHeaderWidth="0"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  Background="White"
                  RowHeight="35"
                  BorderBrush="{StaticResource Tran.Neutral.200}"
                  BorderThickness="0,0,0,1"
                  MaxHeight="200"
                  VirtualizingStackPanel.IsVirtualizing="True"
                  Visibility="{Binding HasSelectedProducts, Converter={StaticResource BoolToVisibilityConverter}}">

            <DataGrid.Columns>
                <!-- 품목명 -->
                <DataGridTextColumn Header="품목" Binding="{Binding ProductName}" Width="*" IsReadOnly="True"/>

                <!-- 단가 -->
                <DataGridTextColumn Header="단가" Binding="{Binding UnitPrice, StringFormat=\{0:N0\}}" Width="100" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Right"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 수량 (편집 가능) -->
                <DataGridTextColumn Header="수량" Binding="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="80">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Right"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                    <DataGridTextColumn.EditingElementStyle>
                        <Style TargetType="TextBox">
                            <Setter Property="TextAlignment" Value="Right"/>
                            <Setter Property="Padding" Value="5,2"/>
                        </Style>
                    </DataGridTextColumn.EditingElementStyle>
                </DataGridTextColumn>

                <!-- 금액 (자동 계산) -->
                <DataGridTextColumn Header="금액" Binding="{Binding LineAmount, StringFormat=\{0:N0\}, Mode=OneWay}" Width="120" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Right"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Foreground" Value="{StaticResource Tran.Primary.600}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 하단: 합계 + 버튼 -->
        <Border Grid.Row="5" Background="{StaticResource Tran.Neutral.50}" Padding="15,12"
                BorderBrush="{StaticResource Tran.Neutral.200}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 합계 표시 -->
                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                           FontSize="14" FontWeight="Bold" Foreground="{StaticResource Tran.Neutral.800}">
                    <Run Text="합계: "/>
                    <Run Text="&#x20A9;" Foreground="{StaticResource Tran.Primary.600}"/>
                    <Run Text="{Binding TotalAmount, StringFormat=\{0:N0\}, Mode=OneWay, FallbackValue='0'}"
                         FontSize="18" Foreground="{StaticResource Tran.Primary.600}"/>
                </TextBlock>

                <!-- 취소 버튼 -->
                <Button Grid.Column="1"
                        Content="취소"
                        Command="{Binding CancelCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        Height="36" Padding="20,0"
                        FontSize="14"
                        Style="{StaticResource Tran.GhostButton}"
                        Margin="0,0,10,0"/>

                <!-- 추가 버튼 -->
                <Button Grid.Column="2"
                        Content="추가"
                        Command="{Binding ConfirmCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        Height="36" Padding="25,0"
                        FontSize="14" FontWeight="Bold"
                        Style="{StaticResource Tran.PrimaryButton}"
                        IsEnabled="{Binding HasSelectedProducts}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
