@page "/partners"
@inject IDbContextFactory<TranDbContext> DbFactory

<PageTitle>거래처 관리 - Tran ERP</PageTitle>

<div class="page-header">
    <div>
        <h1 class="page-title">거래처 관리</h1>
        <p class="page-description">거래처 정보를 등록하고 관리합니다</p>
    </div>
    <button class="btn btn-primary" @onclick="ShowCreateDialog">+ 새 거래처</button>
</div>

<div class="card" style="margin-bottom:16px;">
    <div class="card-body">
        <div class="filter-bar">
            <input type="text" class="form-control" placeholder="거래처명 또는 사업자번호 검색..." @bind="searchText" @bind:event="oninput" />
            <label style="display:flex;align-items:center;gap:6px;font-size:14px;">
                <input type="checkbox" @bind="showInactive" /> 비활성 포함
            </label>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body" style="padding:0;">
        @if (isLoading)
        {
            <div class="loading-spinner"><div class="spinner"></div></div>
        }
        else
        {
            <table class="data-table">
                <thead>
                    <tr>
                        <th>거래처코드</th>
                        <th>거래처명</th>
                        <th>사업자번호</th>
                        <th>대표자</th>
                        <th>연락처</th>
                        <th>담당자</th>
                        <th>상태</th>
                        <th>작업</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var company in filteredCompanies)
                    {
                        <tr>
                            <td><strong>@company.CompanyId</strong></td>
                            <td>@company.CompanyName</td>
                            <td>@company.BusinessNumber</td>
                            <td>@(company.Representative ?? "-")</td>
                            <td>@(company.Contact ?? "-")</td>
                            <td>@(company.ContactName ?? "-")</td>
                            <td><span class="pill @(company.IsActive ? "pill-confirmed" : "pill-cancelled")">@(company.IsActive ? "활성" : "비활성")</span></td>
                            <td>
                                <button class="btn btn-sm btn-secondary" @onclick="() => EditCompany(company)">편집</button>
                            </td>
                        </tr>
                    }
                    @if (!filteredCompanies.Any())
                    {
                        <tr><td colspan="8"><div class="empty-state"><div class="empty-state-icon">🏢</div><div class="empty-state-text">거래처가 없습니다</div></div></td></tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@if (showModal)
{
    <div class="modal-backdrop" @onclick="() => showModal = false">
        <div class="modal-dialog" @onclick:stopPropagation="true" style="max-width:720px;">
            <div class="modal-header">
                <h3 class="modal-title">@(isEditing ? "거래처 편집" : "새 거래처 등록")</h3>
                <button class="modal-close" @onclick="() => showModal = false">&times;</button>
            </div>
            <div class="modal-body">
                <div class="grid-2">
                    <div class="form-group">
                        <label class="form-label">거래처코드</label>
                        <input type="text" class="form-control" @bind="editCompany.CompanyId" disabled="@isEditing" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">거래처명</label>
                        <input type="text" class="form-control" @bind="editCompany.CompanyName" />
                    </div>
                </div>
                <div class="grid-2">
                    <div class="form-group">
                        <label class="form-label">사업자번호</label>
                        <input type="text" class="form-control" @bind="editCompany.BusinessNumber" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">대표자</label>
                        <input type="text" class="form-control" @bind="editCompany.Representative" />
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label">주소</label>
                    <input type="text" class="form-control" @bind="editCompany.Address" />
                </div>
                <div class="grid-2">
                    <div class="form-group">
                        <label class="form-label">연락처</label>
                        <input type="text" class="form-control" @bind="editCompany.Contact" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">담당자명</label>
                        <input type="text" class="form-control" @bind="editCompany.ContactName" />
                    </div>
                </div>
                <div class="grid-2">
                    <div class="form-group">
                        <label class="form-label">담당자 이메일</label>
                        <input type="email" class="form-control" @bind="editCompany.ContactEmail" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">담당자 전화</label>
                        <input type="text" class="form-control" @bind="editCompany.ContactPhone" />
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label">
                        <input type="checkbox" @bind="editCompany.IsActive" /> 활성 상태
                    </label>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="() => showModal = false">취소</button>
                <button class="btn btn-primary" @onclick="SaveCompany">저장</button>
            </div>
        </div>
    </div>
}

@code {
    private bool isLoading = true;
    private List<Company> companies = new();
    private string searchText = "";
    private bool showInactive = false;

    private bool showModal;
    private bool isEditing;
    private Company editCompany = new();

    private IEnumerable<Company> filteredCompanies => companies
        .Where(c => showInactive || c.IsActive)
        .Where(c => string.IsNullOrEmpty(searchText) ||
            c.CompanyName.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
            c.BusinessNumber.Contains(searchText, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync() => await LoadCompanies();

    private async Task LoadCompanies()
    {
        isLoading = true;
        using var context = await DbFactory.CreateDbContextAsync();
        companies = await context.Companies.OrderBy(c => c.CompanyName).ToListAsync();
        isLoading = false;
    }

    private void ShowCreateDialog()
    {
        editCompany = new Company { IsActive = true };
        isEditing = false;
        showModal = true;
    }

    private void EditCompany(Company company)
    {
        editCompany = new Company
        {
            CompanyId = company.CompanyId,
            CompanyName = company.CompanyName,
            BusinessNumber = company.BusinessNumber,
            Representative = company.Representative,
            Address = company.Address,
            Contact = company.Contact,
            ContactName = company.ContactName,
            ContactEmail = company.ContactEmail,
            ContactPhone = company.ContactPhone,
            IsActive = company.IsActive
        };
        isEditing = true;
        showModal = true;
    }

    private async Task SaveCompany()
    {
        if (string.IsNullOrEmpty(editCompany.CompanyName) || string.IsNullOrEmpty(editCompany.BusinessNumber)) return;

        using var context = await DbFactory.CreateDbContextAsync();

        if (isEditing)
        {
            var existing = await context.Companies.FindAsync(editCompany.CompanyId);
            if (existing != null)
            {
                existing.CompanyName = editCompany.CompanyName;
                existing.BusinessNumber = editCompany.BusinessNumber;
                existing.Representative = editCompany.Representative;
                existing.Address = editCompany.Address;
                existing.Contact = editCompany.Contact;
                existing.ContactName = editCompany.ContactName;
                existing.ContactEmail = editCompany.ContactEmail;
                existing.ContactPhone = editCompany.ContactPhone;
                existing.IsActive = editCompany.IsActive;
            }
        }
        else
        {
            if (string.IsNullOrEmpty(editCompany.CompanyId))
            {
                var count = await context.Companies.CountAsync() + 1;
                editCompany.CompanyId = $"COMP{count:D3}";
            }
            editCompany.CreatedAt = DateTime.UtcNow;
            context.Companies.Add(editCompany);
        }

        await context.SaveChangesAsync();
        showModal = false;
        await LoadCompanies();
    }
}
