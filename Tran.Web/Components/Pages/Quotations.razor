@page "/quotations"
@inject IDbContextFactory<TranDbContext> DbFactory
@inject AppStateService AppState

<PageTitle>견적 관리 - Tran ERP</PageTitle>

<div class="page-header">
    <div>
        <h1 class="page-title">견적 관리</h1>
        <p class="page-description">견적서를 작성하고 관리합니다</p>
    </div>
    <button class="btn btn-primary" @onclick="ShowCreateDialog">+ 새 견적</button>
</div>

<div class="card" style="margin-bottom:16px;">
    <div class="card-body">
        <div class="filter-bar">
            <select class="form-control form-select" @bind="filterState">
                <option value="">전체 상태</option>
                <option value="Draft">작성중</option>
                <option value="Sent">발송됨</option>
                <option value="Confirmed">확정</option>
                <option value="Expired">만료</option>
            </select>
            <input type="text" class="form-control" placeholder="거래처 검색..." @bind="searchText" @bind:event="oninput" />
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body" style="padding:0;">
        @if (isLoading)
        {
            <div class="loading-spinner"><div class="spinner"></div></div>
        }
        else
        {
            <table class="data-table">
                <thead>
                    <tr>
                        <th>상태</th>
                        <th>견적번호</th>
                        <th>거래처</th>
                        <th>견적일</th>
                        <th>유효기한</th>
                        <th class="text-right">총금액</th>
                        <th>작업</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var q in filteredQuotations)
                    {
                        <tr>
                            <td><span class="pill @GetPillClass(q.State)">@GetDisplayName(q.State)</span></td>
                            <td><strong>@q.QuotationId</strong></td>
                            <td>@GetCompanyName(q.CompanyId)</td>
                            <td>@q.QuotationDate.ToString("yyyy-MM-dd")</td>
                            <td>@(q.ValidUntil?.ToString("yyyy-MM-dd") ?? "-")</td>
                            <td class="text-right amount">@q.TotalAmount.ToString("N0")원</td>
                            <td>
                                <button class="btn btn-sm btn-secondary" @onclick="() => ViewQuotation(q)">상세</button>
                            </td>
                        </tr>
                    }
                    @if (!filteredQuotations.Any())
                    {
                        <tr><td colspan="7"><div class="empty-state"><div class="empty-state-icon">📝</div><div class="empty-state-text">견적 데이터가 없습니다</div></div></td></tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@if (showDetailModal && selectedQuotation != null)
{
    <div class="modal-backdrop" @onclick="() => showDetailModal = false">
        <div class="modal-dialog" @onclick:stopPropagation="true" style="max-width:720px;">
            <div class="modal-header">
                <h3 class="modal-title">견적 상세 - #@selectedQuotation.QuotationId</h3>
                <button class="modal-close" @onclick="() => showDetailModal = false">&times;</button>
            </div>
            <div class="modal-body">
                <div class="detail-grid">
                    <span class="detail-label">상태</span>
                    <span class="detail-value"><span class="pill @GetPillClass(selectedQuotation.State)">@GetDisplayName(selectedQuotation.State)</span></span>
                    <span class="detail-label">거래처</span>
                    <span class="detail-value">@GetCompanyName(selectedQuotation.CompanyId)</span>
                    <span class="detail-label">견적일</span>
                    <span class="detail-value">@selectedQuotation.QuotationDate.ToString("yyyy-MM-dd")</span>
                    <span class="detail-label">유효기한</span>
                    <span class="detail-value">@(selectedQuotation.ValidUntil?.ToString("yyyy-MM-dd") ?? "-")</span>
                    <span class="detail-label">총금액</span>
                    <span class="detail-value amount">@selectedQuotation.TotalAmount.ToString("N0")원</span>
                </div>
                @if (quotationItems.Any())
                {
                    <h4 style="margin:16px 0 8px;font-size:15px;font-weight:600;">견적 품목</h4>
                    <table class="data-table">
                        <thead><tr><th>품목명</th><th class="text-right">수량</th><th class="text-right">단가</th><th class="text-right">금액</th></tr></thead>
                        <tbody>
                            @foreach (var item in quotationItems)
                            {
                                <tr>
                                    <td>@item.ProductName</td>
                                    <td class="text-right">@item.Quantity.ToString("N0")</td>
                                    <td class="text-right">@item.UnitPrice.ToString("N0")원</td>
                                    <td class="text-right amount">@item.LineAmount.ToString("N0")원</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="() => showDetailModal = false">닫기</button>
            </div>
        </div>
    </div>
}

@if (showCreateModal)
{
    <div class="modal-backdrop" @onclick="() => showCreateModal = false">
        <div class="modal-dialog" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3 class="modal-title">새 견적 작성</h3>
                <button class="modal-close" @onclick="() => showCreateModal = false">&times;</button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label class="form-label">거래처</label>
                    <select class="form-control form-select" @bind="newCompanyId">
                        <option value="">거래처 선택</option>
                        @foreach (var c in companies)
                        {
                            <option value="@c.CompanyId">@c.CompanyName</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">견적일</label>
                    <input type="date" class="form-control" @bind="newQuotationDate" />
                </div>
                <div class="form-group">
                    <label class="form-label">유효기한</label>
                    <input type="date" class="form-control" @bind="newValidUntil" />
                </div>
                <div class="form-group">
                    <label class="form-label">메모</label>
                    <textarea class="form-control" rows="3" @bind="newMemo"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="() => showCreateModal = false">취소</button>
                <button class="btn btn-primary" @onclick="CreateQuotation" disabled="@isSaving">저장</button>
            </div>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(alertMessage))
{
    <div class="toast-container">
        <div class="toast @alertClass">@alertMessage</div>
    </div>
}

@code {
    private bool isLoading = true;
    private List<Quotation> quotations = new();
    private List<Company> companies = new();
    private Dictionary<string, string> companyNames = new();
    private string filterState = "";
    private string searchText = "";

    private bool showDetailModal;
    private Quotation? selectedQuotation;
    private List<QuotationItem> quotationItems = new();

    private bool showCreateModal;
    private string newCompanyId = "";
    private DateTime newQuotationDate = DateTime.Today;
    private DateTime newValidUntil = DateTime.Today.AddDays(30);
    private string newMemo = "";

    private bool isSaving;
    private string alertMessage = "";
    private string alertClass = "";

    private IEnumerable<Quotation> filteredQuotations => quotations
        .Where(q => string.IsNullOrEmpty(filterState) || q.State.ToString() == filterState)
        .Where(q => string.IsNullOrEmpty(searchText) ||
            GetCompanyName(q.CompanyId).Contains(searchText, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            using var context = await DbFactory.CreateDbContextAsync();
            companies = await context.Companies.Where(c => c.IsActive).ToListAsync();
            companyNames = companies.ToDictionary(c => c.CompanyId, c => c.CompanyName);
            await LoadQuotations();
        }
        catch (Exception ex)
        {
            ShowAlert($"데이터 로드 실패: {ex.Message}", "alert-error");
        }
    }

    private async Task LoadQuotations()
    {
        try
        {
            isLoading = true;
            using var context = await DbFactory.CreateDbContextAsync();
            quotations = await context.Quotations
                .Where(q => q.OwnerCompanyId == AppState.CurrentCompanyId)
                .OrderByDescending(q => q.QuotationDate)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            ShowAlert($"견적 목록 로드 실패: {ex.Message}", "alert-error");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ViewQuotation(Quotation q)
    {
        try
        {
            selectedQuotation = q;
            using var context = await DbFactory.CreateDbContextAsync();
            quotationItems = await context.QuotationItems.Where(i => i.QuotationId == q.QuotationId).ToListAsync();
            showDetailModal = true;
        }
        catch (Exception ex)
        {
            ShowAlert($"견적 상세 로드 실패: {ex.Message}", "alert-error");
        }
    }

    private void ShowCreateDialog()
    {
        newCompanyId = "";
        newQuotationDate = DateTime.Today;
        newValidUntil = DateTime.Today.AddDays(30);
        newMemo = "";
        showCreateModal = true;
    }

    private async Task CreateQuotation()
    {
        if (string.IsNullOrEmpty(newCompanyId))
        {
            ShowAlert("거래처를 선택해주세요.", "alert-warning");
            return;
        }
        if (newValidUntil < newQuotationDate)
        {
            ShowAlert("유효기간은 견적일 이후여야 합니다.", "alert-warning");
            return;
        }
        isSaving = true;
        try
        {
            using var context = await DbFactory.CreateDbContextAsync();
            var quotation = new Quotation
            {
                OwnerCompanyId = AppState.CurrentCompanyId,
                CompanyId = newCompanyId,
                QuotationDate = newQuotationDate,
                ValidUntil = newValidUntil,
                State = QuotationState.Draft,
                Memo = string.IsNullOrEmpty(newMemo) ? null : newMemo,
                CreatedAt = DateTime.UtcNow
            };
            context.Quotations.Add(quotation);
            await context.SaveChangesAsync();
            showCreateModal = false;
            await LoadQuotations();
        }
        catch (Exception ex)
        {
            ShowAlert($"저장 실패: {ex.Message}", "alert-error");
        }
        finally
        {
            isSaving = false;
        }
    }

    private string GetCompanyName(string id) => companyNames.TryGetValue(id, out var n) ? n : id;

    private string GetPillClass(QuotationState s) => s switch
    {
        QuotationState.Draft => "pill-draft",
        QuotationState.Sent => "pill-sent",
        QuotationState.Confirmed => "pill-confirmed",
        QuotationState.Expired => "pill-expired",
        _ => "pill-draft"
    };

    private string GetDisplayName(QuotationState s) => s switch
    {
        QuotationState.Draft => "작성중",
        QuotationState.Sent => "발송됨",
        QuotationState.UnderReview => "검토중",
        QuotationState.Confirmed => "확정",
        QuotationState.RevisionRequested => "수정요청",
        QuotationState.Expired => "만료",
        _ => s.ToString()
    };

    private void ShowAlert(string message, string cssClass)
    {
        alertMessage = message;
        alertClass = cssClass;
        _ = InvokeAsync(async () =>
        {
            await Task.Delay(3000);
            alertMessage = "";
            StateHasChanged();
        });
    }
}
