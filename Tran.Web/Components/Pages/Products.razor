@page "/products"
@inject IDbContextFactory<TranDbContext> DbFactory

<PageTitle>품목 관리 - Tran ERP</PageTitle>

<div class="page-header">
    <div>
        <h1 class="page-title">품목 관리</h1>
        <p class="page-description">품목(제품)을 등록하고 관리합니다</p>
    </div>
    <button class="btn btn-primary" @onclick="ShowCreateDialog">+ 새 품목</button>
</div>

<div class="card" style="margin-bottom:16px;">
    <div class="card-body">
        <div class="filter-bar">
            <select class="form-control form-select" @bind="filterCategory">
                <option value="">전체 카테고리</option>
                @foreach (var cat in categories)
                {
                    <option value="@cat">@cat</option>
                }
            </select>
            <input type="text" class="form-control" placeholder="품목명 또는 코드 검색..." @bind="searchText" @bind:event="oninput" />
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body" style="padding:0;">
        @if (isLoading)
        {
            <div class="loading-spinner"><div class="spinner"></div></div>
        }
        else
        {
            <table class="data-table">
                <thead>
                    <tr>
                        <th>품목코드</th>
                        <th>품목명</th>
                        <th>카테고리</th>
                        <th>단위</th>
                        <th class="text-right">기본단가</th>
                        <th>상태</th>
                        <th>작업</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in filteredProducts)
                    {
                        <tr>
                            <td><strong>@(product.ProductCode ?? "-")</strong></td>
                            <td>@product.ProductName</td>
                            <td>@(product.Category ?? "-")</td>
                            <td>@product.Unit</td>
                            <td class="text-right amount">@product.DefaultPrice.ToString("N0")원</td>
                            <td><span class="pill @(product.IsActive ? "pill-confirmed" : "pill-cancelled")">@(product.IsActive ? "활성" : "비활성")</span></td>
                            <td>
                                <button class="btn btn-sm btn-secondary" @onclick="() => EditProduct(product)">편집</button>
                            </td>
                        </tr>
                    }
                    @if (!filteredProducts.Any())
                    {
                        <tr><td colspan="7"><div class="empty-state"><div class="empty-state-icon">📦</div><div class="empty-state-text">품목이 없습니다</div></div></td></tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@if (showModal)
{
    <div class="modal-backdrop" @onclick="() => showModal = false">
        <div class="modal-dialog" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3 class="modal-title">@(isEditing ? "품목 편집" : "새 품목 등록")</h3>
                <button class="modal-close" @onclick="() => showModal = false">&times;</button>
            </div>
            <div class="modal-body">
                <div class="grid-2">
                    <div class="form-group">
                        <label class="form-label">품목코드</label>
                        <input type="text" class="form-control" @bind="editProduct.ProductCode" disabled="@isEditing" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">품목명</label>
                        <input type="text" class="form-control" @bind="editProduct.ProductName" />
                    </div>
                </div>
                <div class="grid-2">
                    <div class="form-group">
                        <label class="form-label">카테고리</label>
                        <input type="text" class="form-control" @bind="editProduct.Category" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">단위</label>
                        <input type="text" class="form-control" @bind="editProduct.Unit" />
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label">기본단가</label>
                    <input type="number" class="form-control" @bind="editProduct.DefaultPrice" />
                </div>
                <div class="form-group">
                    <label class="form-label">
                        <input type="checkbox" @bind="editProduct.IsActive" /> 활성 상태
                    </label>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="() => showModal = false">취소</button>
                <button class="btn btn-primary" @onclick="SaveProduct" disabled="@isSaving">저장</button>
            </div>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(alertMessage))
{
    <div class="toast-container">
        <div class="toast @alertClass">@alertMessage</div>
    </div>
}

@code {
    private bool isLoading = true;
    private List<Product> products = new();
    private List<string> categories = new();
    private string filterCategory = "";
    private string searchText = "";

    private bool showModal;
    private bool isEditing;
    private Product editProduct = new();
    private bool isSaving;

    private string alertMessage = "";
    private string alertClass = "";

    private IEnumerable<Product> filteredProducts => products
        .Where(p => string.IsNullOrEmpty(filterCategory) || p.Category == filterCategory)
        .Where(p => string.IsNullOrEmpty(searchText) ||
            p.ProductName.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
            (p.ProductCode ?? "").Contains(searchText, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadProducts();
        }
        catch (Exception ex)
        {
            ShowAlert($"초기화 오류: {ex.Message}", "toast-error");
        }
    }

    private async Task LoadProducts()
    {
        try
        {
            isLoading = true;
            using var context = await DbFactory.CreateDbContextAsync();
            products = await context.Products.OrderBy(p => p.ProductName).ToListAsync();
            categories = products.Where(p => !string.IsNullOrEmpty(p.Category))
                .Select(p => p.Category!).Distinct().OrderBy(c => c).ToList();
        }
        catch (Exception ex)
        {
            ShowAlert($"품목 로드 오류: {ex.Message}", "toast-error");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ShowCreateDialog()
    {
        editProduct = new Product { IsActive = true, Unit = "개" };
        isEditing = false;
        showModal = true;
    }

    private void EditProduct(Product product)
    {
        editProduct = new Product
        {
            ProductId = product.ProductId,
            ProductCode = product.ProductCode,
            ProductName = product.ProductName,
            Category = product.Category,
            Unit = product.Unit,
            DefaultPrice = product.DefaultPrice,
            IsActive = product.IsActive
        };
        isEditing = true;
        showModal = true;
    }

    private async Task SaveProduct()
    {
        if (isSaving) return;
        if (string.IsNullOrEmpty(editProduct.ProductName))
        {
            ShowAlert("품목명을 입력해주세요.", "toast-error");
            return;
        }
        if (string.IsNullOrEmpty(editProduct.Unit))
        {
            ShowAlert("단위를 입력해주세요.", "toast-error");
            return;
        }
        if (editProduct.DefaultPrice < 0)
        {
            ShowAlert("기본단가는 0 이상이어야 합니다.", "toast-error");
            return;
        }

        try
        {
            isSaving = true;
            using var context = await DbFactory.CreateDbContextAsync();

            if (isEditing)
            {
                var existing = await context.Products.FindAsync(editProduct.ProductId);
                if (existing != null)
                {
                    existing.ProductName = editProduct.ProductName;
                    existing.Category = editProduct.Category;
                    existing.Unit = editProduct.Unit;
                    existing.DefaultPrice = editProduct.DefaultPrice;
                    existing.IsActive = editProduct.IsActive;
                }
            }
            else
            {
                if (string.IsNullOrEmpty(editProduct.ProductCode))
                {
                    editProduct.ProductCode = $"PROD-{Guid.NewGuid().ToString("N")[..6].ToUpper()}";
                }
                editProduct.CreatedAt = DateTime.UtcNow;
                context.Products.Add(editProduct);
            }

            await context.SaveChangesAsync();
            showModal = false;
            await LoadProducts();
            ShowAlert("품목이 저장되었습니다.", "toast-success");
        }
        catch (Exception ex)
        {
            ShowAlert($"저장 오류: {ex.Message}", "toast-error");
        }
        finally
        {
            isSaving = false;
        }
    }

    private void ShowAlert(string message, string cssClass)
    {
        alertMessage = message;
        alertClass = cssClass;
        _ = InvokeAsync(async () =>
        {
            await Task.Delay(3000);
            alertMessage = "";
            StateHasChanged();
        });
    }
}
