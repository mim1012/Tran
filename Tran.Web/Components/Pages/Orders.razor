@page "/orders"
@inject IOrderService OrderService
@inject IDbContextFactory<TranDbContext> DbFactory
@inject AppStateService AppState

<PageTitle>발주 관리 - Tran ERP</PageTitle>

<div class="page-header">
    <div>
        <h1 class="page-title">발주 관리</h1>
        <p class="page-description">발주를 작성하고 관리합니다</p>
    </div>
    <button class="btn btn-primary" @onclick="ShowCreateDialog">+ 새 발주</button>
</div>

<div class="card" style="margin-bottom:16px;">
    <div class="card-body">
        <div class="filter-bar">
            <select class="form-control form-select" @bind="filterState">
                <option value="">전체 상태</option>
                <option value="Draft">작성중</option>
                <option value="Completed">발주완료</option>
                <option value="Cancelled">취소</option>
            </select>
            <input type="text" class="form-control" placeholder="거래처 검색..." @bind="searchText" @bind:event="oninput" />
            <button class="btn btn-secondary" @onclick="LoadOrders">검색</button>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body" style="padding:0;">
        @if (isLoading)
        {
            <div class="loading-spinner"><div class="spinner"></div></div>
        }
        else
        {
            <table class="data-table">
                <thead>
                    <tr>
                        <th>상태</th>
                        <th>발주번호</th>
                        <th>거래처</th>
                        <th>발주일</th>
                        <th class="text-right">총금액</th>
                        <th>메모</th>
                        <th>작업</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in filteredOrders)
                    {
                        <tr>
                            <td><span class="pill @GetPillClass(order.State)">@GetDisplayName(order.State)</span></td>
                            <td><strong>@order.OrderId</strong></td>
                            <td>@GetCompanyName(order.CompanyId)</td>
                            <td>@order.OrderDate.ToString("yyyy-MM-dd")</td>
                            <td class="text-right amount">@order.TotalAmount.ToString("N0")원</td>
                            <td>@(order.Memo ?? "-")</td>
                            <td>
                                <button class="btn btn-sm btn-secondary" @onclick="() => ViewOrder(order)">상세</button>
                            </td>
                        </tr>
                    }
                    @if (!filteredOrders.Any())
                    {
                        <tr>
                            <td colspan="7">
                                <div class="empty-state">
                                    <div class="empty-state-icon">📋</div>
                                    <div class="empty-state-text">발주 데이터가 없습니다</div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@if (showDetailModal && selectedOrder != null)
{
    <div class="modal-backdrop" @onclick="() => showDetailModal = false">
        <div class="modal-dialog" @onclick:stopPropagation="true" style="max-width:720px;">
            <div class="modal-header">
                <h3 class="modal-title">발주 상세 - #@selectedOrder.OrderId</h3>
                <button class="modal-close" @onclick="() => showDetailModal = false">&times;</button>
            </div>
            <div class="modal-body">
                <div class="detail-grid">
                    <span class="detail-label">상태</span>
                    <span class="detail-value"><span class="pill @GetPillClass(selectedOrder.State)">@GetDisplayName(selectedOrder.State)</span></span>
                    <span class="detail-label">거래처</span>
                    <span class="detail-value">@GetCompanyName(selectedOrder.CompanyId)</span>
                    <span class="detail-label">발주일</span>
                    <span class="detail-value">@selectedOrder.OrderDate.ToString("yyyy-MM-dd")</span>
                    <span class="detail-label">총금액</span>
                    <span class="detail-value amount">@selectedOrder.TotalAmount.ToString("N0")원</span>
                </div>

                @if (orderItems.Any())
                {
                    <h4 style="margin:16px 0 8px;font-size:15px;font-weight:600;">발주 품목</h4>
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>품목명</th>
                                <th class="text-right">수량</th>
                                <th class="text-right">단가</th>
                                <th class="text-right">금액</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in orderItems)
                            {
                                <tr>
                                    <td>@item.ProductName</td>
                                    <td class="text-right">@item.Quantity.ToString("N0")</td>
                                    <td class="text-right">@item.UnitPrice.ToString("N0")원</td>
                                    <td class="text-right amount">@item.LineAmount.ToString("N0")원</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="() => showDetailModal = false">닫기</button>
            </div>
        </div>
    </div>
}

@if (showCreateModal)
{
    <div class="modal-backdrop" @onclick="() => showCreateModal = false">
        <div class="modal-dialog" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3 class="modal-title">새 발주 작성</h3>
                <button class="modal-close" @onclick="() => showCreateModal = false">&times;</button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label class="form-label">거래처</label>
                    <select class="form-control form-select" @bind="newOrder.CompanyId">
                        <option value="">거래처 선택</option>
                        @foreach (var c in companies)
                        {
                            <option value="@c.CompanyId">@c.CompanyName</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">발주일</label>
                    <input type="date" class="form-control" @bind="newOrder.OrderDate" />
                </div>
                <div class="form-group">
                    <label class="form-label">메모</label>
                    <textarea class="form-control" rows="3" @bind="newOrder.Memo"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="() => showCreateModal = false">취소</button>
                <button class="btn btn-primary" @onclick="CreateOrder">저장</button>
            </div>
        </div>
    </div>
}

@code {
    private bool isLoading = true;
    private List<Order> orders = new();
    private List<Company> companies = new();
    private Dictionary<string, string> companyNames = new();
    private string filterState = "";
    private string searchText = "";

    private bool showDetailModal;
    private Order? selectedOrder;
    private List<OrderItem> orderItems = new();

    private bool showCreateModal;
    private Order newOrder = new() { OrderDate = DateTime.Today };

    private IEnumerable<Order> filteredOrders => orders
        .Where(o => string.IsNullOrEmpty(filterState) || o.State.ToString() == filterState)
        .Where(o => string.IsNullOrEmpty(searchText) ||
            GetCompanyName(o.CompanyId).Contains(searchText, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        using var context = await DbFactory.CreateDbContextAsync();
        companies = await context.Companies.Where(c => c.IsActive).ToListAsync();
        companyNames = companies.ToDictionary(c => c.CompanyId, c => c.CompanyName);
        await LoadOrders();
    }

    private async Task LoadOrders()
    {
        isLoading = true;
        using var context = await DbFactory.CreateDbContextAsync();
        orders = await context.Orders
            .OrderByDescending(o => o.OrderDate)
            .ToListAsync();
        isLoading = false;
    }

    private async Task ViewOrder(Order order)
    {
        selectedOrder = order;
        using var context = await DbFactory.CreateDbContextAsync();
        orderItems = await context.OrderItems
            .Where(i => i.OrderId == order.OrderId)
            .ToListAsync();
        showDetailModal = true;
    }

    private void ShowCreateDialog()
    {
        newOrder = new Order { OrderDate = DateTime.Today };
        showCreateModal = true;
    }

    private async Task CreateOrder()
    {
        if (string.IsNullOrEmpty(newOrder.CompanyId)) return;

        using var context = await DbFactory.CreateDbContextAsync();
        newOrder.State = OrderState.Draft;
        newOrder.CreatedAt = DateTime.UtcNow;
        context.Orders.Add(newOrder);
        await context.SaveChangesAsync();

        showCreateModal = false;
        await LoadOrders();
    }

    private string GetCompanyName(string companyId) =>
        companyNames.TryGetValue(companyId, out var name) ? name : companyId;

    private string GetPillClass(OrderState state) => state switch
    {
        OrderState.Draft => "pill-draft",
        OrderState.Completed => "pill-completed",
        OrderState.Cancelled => "pill-cancelled",
        _ => "pill-draft"
    };

    private string GetDisplayName(OrderState state) => state switch
    {
        OrderState.Draft => "작성중",
        OrderState.Completed => "발주완료",
        OrderState.Cancelled => "취소",
        _ => state.ToString()
    };
}
