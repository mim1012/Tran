@page "/statistics"
@inject IDbContextFactory<TranDbContext> DbFactory

<PageTitle>매출 통계 - Tran ERP</PageTitle>

<div class="page-header">
    <div>
        <h1 class="page-title">매출 통계</h1>
        <p class="page-description">판매 및 구매 통계를 확인합니다</p>
    </div>
</div>

<div class="card" style="margin-bottom:16px;">
    <div class="card-body">
        <div class="filter-bar">
            <div class="form-group" style="margin-bottom:0;">
                <label class="form-label">기간</label>
                <div style="display:flex;gap:8px;align-items:center;">
                    <input type="date" class="form-control" @bind="startDate" />
                    <span>~</span>
                    <input type="date" class="form-control" @bind="endDate" />
                    <button class="btn btn-primary" @onclick="LoadStatistics">조회</button>
                </div>
            </div>
        </div>
    </div>
</div>

@if (isLoading)
{
    <div class="loading-spinner"><div class="spinner"></div></div>
}
else
{
    <div class="stat-grid">
        <div class="stat-card">
            <div class="stat-label">총 판매액</div>
            <div class="stat-value">@totalSales.ToString("N0")<span class="stat-unit">원</span></div>
        </div>
        <div class="stat-card">
            <div class="stat-label">총 구매액</div>
            <div class="stat-value">@totalPurchases.ToString("N0")<span class="stat-unit">원</span></div>
        </div>
        <div class="stat-card">
            <div class="stat-label">매출이익</div>
            <div class="stat-value" style="color:@(totalSales - totalPurchases >= 0 ? "var(--tran-accent-green)" : "var(--tran-accent-red)")">
                @((totalSales - totalPurchases).ToString("N0"))<span class="stat-unit">원</span>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-label">판매 건수</div>
            <div class="stat-value">@salesCount<span class="stat-unit">건</span></div>
        </div>
    </div>

    <div class="grid-2">
        <div class="card">
            <div class="card-header">
                <span class="card-title">거래처별 판매 현황</span>
            </div>
            <div class="card-body" style="padding:0;">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>거래처</th>
                            <th class="text-right">판매액</th>
                            <th class="text-right">건수</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in salesByCompany)
                        {
                            <tr>
                                <td>@item.CompanyName</td>
                                <td class="text-right amount">@item.Amount.ToString("N0")원</td>
                                <td class="text-right">@(item.Count)건</td>
                            </tr>
                        }
                        @if (!salesByCompany.Any())
                        {
                            <tr><td colspan="3" class="text-center" style="padding:24px;color:var(--tran-text-secondary);">데이터가 없습니다</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <span class="card-title">품목별 판매 현황</span>
            </div>
            <div class="card-body" style="padding:0;">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>품목</th>
                            <th class="text-right">판매액</th>
                            <th class="text-right">수량</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in salesByProduct)
                        {
                            <tr>
                                <td>@item.ProductName</td>
                                <td class="text-right amount">@item.Amount.ToString("N0")원</td>
                                <td class="text-right">@item.Quantity.ToString("N0")</td>
                            </tr>
                        }
                        @if (!salesByProduct.Any())
                        {
                            <tr><td colspan="3" class="text-center" style="padding:24px;color:var(--tran-text-secondary);">데이터가 없습니다</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(alertMessage))
{
    <div class="toast-container">
        <div class="toast @alertClass">@alertMessage</div>
    </div>
}

@code {
    private bool isLoading = true;
    private DateTime startDate = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime endDate = DateTime.Today;

    private decimal totalSales;
    private decimal totalPurchases;
    private int salesCount;
    private List<CompanyStat> salesByCompany = new();
    private List<ProductStat> salesByProduct = new();

    private string alertMessage = "";
    private string alertClass = "";

    private void ShowAlert(string message, string cssClass)
    {
        alertMessage = message;
        alertClass = cssClass;
        _ = InvokeAsync(async () =>
        {
            await Task.Delay(3000);
            alertMessage = "";
            StateHasChanged();
        });
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadStatistics();
        }
        catch (Exception ex)
        {
            ShowAlert($"초기화 실패: {ex.Message}", "toast-error");
            isLoading = false;
        }
    }

    private async Task LoadStatistics()
    {
        try
        {
            isLoading = true;
            using var context = await DbFactory.CreateDbContextAsync();

            var confirmedSales = await context.Sales
                .Where(s => s.SaleDate >= startDate && s.SaleDate <= endDate && s.State == SaleState.Confirmed)
                .ToListAsync();

            var deliveredPurchases = await context.Purchases
                .Where(p => p.PurchaseDate >= startDate && p.PurchaseDate <= endDate && p.State == PurchaseState.Delivered)
                .ToListAsync();

            totalSales = confirmedSales.Sum(s => s.TotalAmount);
            totalPurchases = deliveredPurchases.Sum(p => p.TotalAmount);
            salesCount = confirmedSales.Count;

            var companyNames = await context.Companies.ToDictionaryAsync(c => c.CompanyId, c => c.CompanyName);

            salesByCompany = confirmedSales
                .GroupBy(s => s.CompanyId)
                .Select(g => new CompanyStat
                {
                    CompanyName = companyNames.TryGetValue(g.Key, out var n) ? n : g.Key,
                    Amount = g.Sum(s => s.TotalAmount),
                    Count = g.Count()
                })
                .OrderByDescending(x => x.Amount)
                .Take(10)
                .ToList();

            var saleIds = confirmedSales.Select(s => s.SaleId).ToList();
            var saleItems = await context.SaleItems
                .Where(i => saleIds.Contains(i.SaleId))
                .ToListAsync();

            salesByProduct = saleItems
                .GroupBy(i => i.ProductName)
                .Select(g => new ProductStat
                {
                    ProductName = g.Key,
                    Amount = g.Sum(i => i.LineAmount),
                    Quantity = g.Sum(i => i.Quantity)
                })
                .OrderByDescending(x => x.Amount)
                .Take(10)
                .ToList();

            isLoading = false;
        }
        catch (Exception ex)
        {
            ShowAlert($"통계 로드 실패: {ex.Message}", "toast-error");
            isLoading = false;
        }
    }

    private class CompanyStat
    {
        public string CompanyName { get; set; } = "";
        public decimal Amount { get; set; }
        public int Count { get; set; }
    }

    private class ProductStat
    {
        public string ProductName { get; set; } = "";
        public decimal Amount { get; set; }
        public decimal Quantity { get; set; }
    }
}
