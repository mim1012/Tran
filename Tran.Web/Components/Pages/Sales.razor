@page "/sales"
@inject IDbContextFactory<TranDbContext> DbFactory
@inject AppStateService AppState

<PageTitle>판매 관리 - Tran ERP</PageTitle>

<div class="page-header">
    <div>
        <h1 class="page-title">판매 관리</h1>
        <p class="page-description">판매 내역을 관리합니다</p>
    </div>
    <button class="btn btn-primary" @onclick="ShowCreateDialog">+ 새 판매</button>
</div>

<div class="card" style="margin-bottom:16px;">
    <div class="card-body">
        <div class="filter-bar">
            <select class="form-control form-select" @bind="filterState">
                <option value="">전체 상태</option>
                <option value="Draft">작성중</option>
                <option value="Confirmed">판매확정</option>
                <option value="Cancelled">취소</option>
            </select>
            <input type="text" class="form-control" placeholder="거래처 검색..." @bind="searchText" @bind:event="oninput" />
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body" style="padding:0;">
        @if (isLoading)
        {
            <div class="loading-spinner"><div class="spinner"></div></div>
        }
        else
        {
            <table class="data-table">
                <thead>
                    <tr>
                        <th>상태</th>
                        <th>판매번호</th>
                        <th>거래처</th>
                        <th>판매일</th>
                        <th class="text-right">총금액</th>
                        <th>작업</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var sale in filteredSales)
                    {
                        <tr>
                            <td><span class="pill @GetPillClass(sale.State)">@GetDisplayName(sale.State)</span></td>
                            <td><strong>@sale.SaleId</strong></td>
                            <td>@GetCompanyName(sale.CompanyId)</td>
                            <td>@sale.SaleDate.ToString("yyyy-MM-dd")</td>
                            <td class="text-right amount">@sale.TotalAmount.ToString("N0")원</td>
                            <td>
                                <button class="btn btn-sm btn-secondary" @onclick="() => ViewSale(sale)">상세</button>
                            </td>
                        </tr>
                    }
                    @if (!filteredSales.Any())
                    {
                        <tr><td colspan="6"><div class="empty-state"><div class="empty-state-icon">📤</div><div class="empty-state-text">판매 데이터가 없습니다</div></div></td></tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@if (showDetailModal && selectedSale != null)
{
    <div class="modal-backdrop" @onclick="() => showDetailModal = false">
        <div class="modal-dialog" @onclick:stopPropagation="true" style="max-width:720px;">
            <div class="modal-header">
                <h3 class="modal-title">판매 상세 - #@selectedSale.SaleId</h3>
                <button class="modal-close" @onclick="() => showDetailModal = false">&times;</button>
            </div>
            <div class="modal-body">
                <div class="detail-grid">
                    <span class="detail-label">상태</span>
                    <span class="detail-value"><span class="pill @GetPillClass(selectedSale.State)">@GetDisplayName(selectedSale.State)</span></span>
                    <span class="detail-label">거래처</span>
                    <span class="detail-value">@GetCompanyName(selectedSale.CompanyId)</span>
                    <span class="detail-label">판매일</span>
                    <span class="detail-value">@selectedSale.SaleDate.ToString("yyyy-MM-dd")</span>
                    <span class="detail-label">총금액</span>
                    <span class="detail-value amount">@selectedSale.TotalAmount.ToString("N0")원</span>
                </div>
                @if (saleItems.Any())
                {
                    <h4 style="margin:16px 0 8px;font-size:15px;font-weight:600;">판매 품목</h4>
                    <table class="data-table">
                        <thead><tr><th>품목명</th><th class="text-right">수량</th><th class="text-right">단가</th><th class="text-right">금액</th></tr></thead>
                        <tbody>
                            @foreach (var item in saleItems)
                            {
                                <tr>
                                    <td>@item.ProductName</td>
                                    <td class="text-right">@item.Quantity.ToString("N0")</td>
                                    <td class="text-right">@item.UnitPrice.ToString("N0")원</td>
                                    <td class="text-right amount">@item.LineAmount.ToString("N0")원</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="() => showDetailModal = false">닫기</button>
            </div>
        </div>
    </div>
}

@if (showCreateModal)
{
    <div class="modal-backdrop" @onclick="() => showCreateModal = false">
        <div class="modal-dialog" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3 class="modal-title">새 판매 등록</h3>
                <button class="modal-close" @onclick="() => showCreateModal = false">&times;</button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label class="form-label">거래처</label>
                    <select class="form-control form-select" @bind="newSale.CompanyId">
                        <option value="">거래처 선택</option>
                        @foreach (var c in companies)
                        {
                            <option value="@c.CompanyId">@c.CompanyName</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">판매일</label>
                    <input type="date" class="form-control" @bind="newSale.SaleDate" />
                </div>
                <div class="form-group">
                    <label class="form-label">메모</label>
                    <textarea class="form-control" rows="3" @bind="newSale.Memo"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="() => showCreateModal = false">취소</button>
                <button class="btn btn-primary" @onclick="CreateSale" disabled="@isSaving">저장</button>
            </div>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(alertMessage))
{
    <div class="toast-container">
        <div class="toast @alertClass">@alertMessage</div>
    </div>
}

@code {
    private bool isLoading = true;
    private List<Sale> sales = new();
    private List<Company> companies = new();
    private Dictionary<string, string> companyNames = new();
    private string filterState = "";
    private string searchText = "";

    private bool showDetailModal;
    private Sale? selectedSale;
    private List<SaleItem> saleItems = new();

    private bool showCreateModal;
    private Sale newSale = new() { SaleDate = DateTime.Today };

    private bool isSaving;
    private string alertMessage = "";
    private string alertClass = "";

    private IEnumerable<Sale> filteredSales => sales
        .Where(s => string.IsNullOrEmpty(filterState) || s.State.ToString() == filterState)
        .Where(s => string.IsNullOrEmpty(searchText) ||
            GetCompanyName(s.CompanyId).Contains(searchText, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            using var context = await DbFactory.CreateDbContextAsync();
            companies = await context.Companies.Where(c => c.IsActive).ToListAsync();
            companyNames = companies.ToDictionary(c => c.CompanyId, c => c.CompanyName);
            await LoadSales();
        }
        catch (Exception ex)
        {
            ShowAlert($"데이터 로드 실패: {ex.Message}", "alert-error");
        }
    }

    private async Task LoadSales()
    {
        try
        {
            isLoading = true;
            using var context = await DbFactory.CreateDbContextAsync();
            sales = await context.Sales
                .Where(s => s.OwnerCompanyId == AppState.CurrentCompanyId)
                .OrderByDescending(s => s.SaleDate)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            ShowAlert($"판매 목록 로드 실패: {ex.Message}", "alert-error");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ViewSale(Sale sale)
    {
        try
        {
            selectedSale = sale;
            using var context = await DbFactory.CreateDbContextAsync();
            saleItems = await context.SaleItems.Where(i => i.SaleId == sale.SaleId).ToListAsync();
            showDetailModal = true;
        }
        catch (Exception ex)
        {
            ShowAlert($"판매 상세 로드 실패: {ex.Message}", "alert-error");
        }
    }

    private void ShowCreateDialog()
    {
        newSale = new Sale { SaleDate = DateTime.Today };
        showCreateModal = true;
    }

    private async Task CreateSale()
    {
        if (string.IsNullOrEmpty(newSale.CompanyId))
        {
            ShowAlert("거래처를 선택해주세요.", "alert-warning");
            return;
        }
        isSaving = true;
        try
        {
            using var context = await DbFactory.CreateDbContextAsync();
            newSale.OwnerCompanyId = AppState.CurrentCompanyId;
            newSale.State = SaleState.Draft;
            newSale.CreatedAt = DateTime.UtcNow;
            context.Sales.Add(newSale);
            await context.SaveChangesAsync();
            showCreateModal = false;
            await LoadSales();
        }
        catch (Exception ex)
        {
            ShowAlert($"저장 실패: {ex.Message}", "alert-error");
        }
        finally
        {
            isSaving = false;
        }
    }

    private string GetCompanyName(string id) => companyNames.TryGetValue(id, out var n) ? n : id;

    private string GetPillClass(SaleState s) => s switch
    {
        SaleState.Draft => "pill-draft",
        SaleState.Confirmed => "pill-confirmed",
        SaleState.Cancelled => "pill-cancelled",
        _ => "pill-draft"
    };

    private string GetDisplayName(SaleState s) => s switch
    {
        SaleState.Draft => "작성중",
        SaleState.Confirmed => "판매확정",
        SaleState.Cancelled => "취소",
        _ => s.ToString()
    };

    private void ShowAlert(string message, string cssClass)
    {
        alertMessage = message;
        alertClass = cssClass;
        _ = InvokeAsync(async () =>
        {
            await Task.Delay(3000);
            alertMessage = "";
            StateHasChanged();
        });
    }
}
