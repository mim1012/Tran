@page "/"
@inject IDbContextFactory<TranDbContext> DbFactory
@inject AppStateService AppState

<PageTitle>대시보드 - Tran ERP</PageTitle>

<div class="page-header">
    <div>
        <h1 class="page-title">대시보드</h1>
        <p class="page-description">거래 관리 현황을 한눈에 확인하세요</p>
    </div>
</div>

@if (isLoading)
{
    <div class="loading-spinner"><div class="spinner"></div></div>
}
else
{
    <div class="stat-grid">
        <div class="stat-card">
            <div class="stat-label">거래처 수</div>
            <div class="stat-value">@companyCount<span class="stat-unit">개</span></div>
        </div>
        <div class="stat-card">
            <div class="stat-label">품목 수</div>
            <div class="stat-value">@productCount<span class="stat-unit">개</span></div>
        </div>
        <div class="stat-card">
            <div class="stat-label">이번 달 판매</div>
            <div class="stat-value">@monthlySalesAmount.ToString("N0")<span class="stat-unit">원</span></div>
        </div>
        <div class="stat-card">
            <div class="stat-label">이번 달 구매</div>
            <div class="stat-value">@monthlyPurchaseAmount.ToString("N0")<span class="stat-unit">원</span></div>
        </div>
    </div>

    <div class="grid-2">
        <!-- 최근 거래명세표 -->
        <div class="card">
            <div class="card-header">
                <span class="card-title">최근 거래명세표</span>
                <a href="documents" class="btn btn-sm btn-secondary">전체보기</a>
            </div>
            <div class="card-body" style="padding:0;">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>상태</th>
                            <th>문서번호</th>
                            <th>거래처</th>
                            <th class="text-right">금액</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var doc in recentDocuments)
                        {
                            <tr>
                                <td><span class="pill @GetDocStatePillClass(doc.State)">@GetDocStateDisplayName(doc.State)</span></td>
                                <td>@doc.DocumentId</td>
                                <td>@doc.ToCompanyId</td>
                                <td class="text-right amount">@doc.TotalAmount.ToString("N0")원</td>
                            </tr>
                        }
                        @if (!recentDocuments.Any())
                        {
                            <tr><td colspan="4" class="text-center" style="padding:24px;color:var(--tran-text-secondary);">데이터가 없습니다</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- 최근 발주 -->
        <div class="card">
            <div class="card-header">
                <span class="card-title">최근 발주</span>
                <a href="orders" class="btn btn-sm btn-secondary">전체보기</a>
            </div>
            <div class="card-body" style="padding:0;">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>상태</th>
                            <th>거래처</th>
                            <th>발주일</th>
                            <th class="text-right">금액</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in recentOrders)
                        {
                            <tr>
                                <td><span class="pill @GetOrderStatePillClass(order.State)">@GetOrderStateDisplayName(order.State)</span></td>
                                <td>@order.CompanyId</td>
                                <td>@order.OrderDate.ToString("yyyy-MM-dd")</td>
                                <td class="text-right amount">@order.TotalAmount.ToString("N0")원</td>
                            </tr>
                        }
                        @if (!recentOrders.Any())
                        {
                            <tr><td colspan="4" class="text-center" style="padding:24px;color:var(--tran-text-secondary);">데이터가 없습니다</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="grid-2" style="margin-top:16px;">
        <!-- 최근 판매 -->
        <div class="card">
            <div class="card-header">
                <span class="card-title">최근 판매</span>
                <a href="sales" class="btn btn-sm btn-secondary">전체보기</a>
            </div>
            <div class="card-body" style="padding:0;">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>상태</th>
                            <th>거래처</th>
                            <th>판매일</th>
                            <th class="text-right">금액</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sale in recentSales)
                        {
                            <tr>
                                <td><span class="pill @GetSaleStatePillClass(sale.State)">@GetSaleStateDisplayName(sale.State)</span></td>
                                <td>@sale.CompanyId</td>
                                <td>@sale.SaleDate.ToString("yyyy-MM-dd")</td>
                                <td class="text-right amount">@sale.TotalAmount.ToString("N0")원</td>
                            </tr>
                        }
                        @if (!recentSales.Any())
                        {
                            <tr><td colspan="4" class="text-center" style="padding:24px;color:var(--tran-text-secondary);">데이터가 없습니다</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- 최근 구매 -->
        <div class="card">
            <div class="card-header">
                <span class="card-title">최근 구매</span>
                <a href="purchases" class="btn btn-sm btn-secondary">전체보기</a>
            </div>
            <div class="card-body" style="padding:0;">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>상태</th>
                            <th>거래처</th>
                            <th>구매일</th>
                            <th class="text-right">금액</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var purchase in recentPurchases)
                        {
                            <tr>
                                <td><span class="pill @GetPurchaseStatePillClass(purchase.State)">@GetPurchaseStateDisplayName(purchase.State)</span></td>
                                <td>@purchase.CompanyId</td>
                                <td>@purchase.PurchaseDate.ToString("yyyy-MM-dd")</td>
                                <td class="text-right amount">@purchase.TotalAmount.ToString("N0")원</td>
                            </tr>
                        }
                        @if (!recentPurchases.Any())
                        {
                            <tr><td colspan="4" class="text-center" style="padding:24px;color:var(--tran-text-secondary);">데이터가 없습니다</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@code {
    private bool isLoading = true;
    private int companyCount;
    private int productCount;
    private decimal monthlySalesAmount;
    private decimal monthlyPurchaseAmount;
    private List<Document> recentDocuments = new();
    private List<Order> recentOrders = new();
    private List<Sale> recentSales = new();
    private List<Purchase> recentPurchases = new();

    protected override async Task OnInitializedAsync()
    {
        using var context = await DbFactory.CreateDbContextAsync();
        var monthStart = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);

        companyCount = await context.Companies.CountAsync(c => c.IsActive);
        productCount = await context.Products.CountAsync(p => p.IsActive);

        monthlySalesAmount = await context.Sales
            .Where(s => s.SaleDate >= monthStart && s.State == SaleState.Confirmed)
            .SumAsync(s => s.TotalAmount);

        monthlyPurchaseAmount = await context.Purchases
            .Where(p => p.PurchaseDate >= monthStart && p.State == PurchaseState.Delivered)
            .SumAsync(p => p.TotalAmount);

        recentDocuments = await context.Documents
            .OrderByDescending(d => d.CreatedAt)
            .Take(5)
            .ToListAsync();

        recentOrders = await context.Orders
            .OrderByDescending(o => o.OrderDate)
            .Take(5)
            .ToListAsync();

        recentSales = await context.Sales
            .OrderByDescending(s => s.SaleDate)
            .Take(5)
            .ToListAsync();

        recentPurchases = await context.Purchases
            .OrderByDescending(p => p.PurchaseDate)
            .Take(5)
            .ToListAsync();

        isLoading = false;
    }

    private string GetDocStatePillClass(DocumentState state) => state switch
    {
        DocumentState.Draft => "pill-draft",
        DocumentState.Sent => "pill-sent",
        DocumentState.Received => "pill-pending",
        DocumentState.Confirmed => "pill-confirmed",
        DocumentState.Cancelled => "pill-cancelled",
        DocumentState.Superseded => "pill-expired",
        DocumentState.RevisionRequested => "pill-pending",
        _ => "pill-draft"
    };

    private string GetDocStateDisplayName(DocumentState state) => state switch
    {
        DocumentState.Draft => "작성중",
        DocumentState.Sent => "발송됨",
        DocumentState.Received => "수신됨",
        DocumentState.Confirmed => "확정",
        DocumentState.Cancelled => "취소",
        DocumentState.Superseded => "대체됨",
        DocumentState.RevisionRequested => "수정요청",
        _ => state.ToString()
    };

    private string GetOrderStatePillClass(OrderState state) => state switch
    {
        OrderState.Draft => "pill-draft",
        OrderState.Completed => "pill-completed",
        OrderState.Cancelled => "pill-cancelled",
        _ => "pill-draft"
    };

    private string GetOrderStateDisplayName(OrderState state) => state switch
    {
        OrderState.Draft => "작성중",
        OrderState.Completed => "발주완료",
        OrderState.Cancelled => "취소",
        _ => state.ToString()
    };

    private string GetSaleStatePillClass(SaleState state) => state switch
    {
        SaleState.Draft => "pill-draft",
        SaleState.Confirmed => "pill-confirmed",
        SaleState.Cancelled => "pill-cancelled",
        _ => "pill-draft"
    };

    private string GetSaleStateDisplayName(SaleState state) => state switch
    {
        SaleState.Draft => "작성중",
        SaleState.Confirmed => "판매확정",
        SaleState.Cancelled => "취소",
        _ => state.ToString()
    };

    private string GetPurchaseStatePillClass(PurchaseState state) => state switch
    {
        PurchaseState.PendingDelivery => "pill-pending",
        PurchaseState.PartiallyDelivered => "pill-sent",
        PurchaseState.Delivered => "pill-delivered",
        PurchaseState.Cancelled => "pill-cancelled",
        _ => "pill-draft"
    };

    private string GetPurchaseStateDisplayName(PurchaseState state) => state switch
    {
        PurchaseState.PendingDelivery => "입고대기",
        PurchaseState.PartiallyDelivered => "부분입고",
        PurchaseState.Delivered => "입고완료",
        PurchaseState.Cancelled => "취소",
        _ => state.ToString()
    };
}
