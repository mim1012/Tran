@page "/purchases"
@inject IDbContextFactory<TranDbContext> DbFactory
@inject AppStateService AppState

<PageTitle>구매 관리 - Tran ERP</PageTitle>

<div class="page-header">
    <div>
        <h1 class="page-title">구매 관리</h1>
        <p class="page-description">구매/매입 내역을 관리합니다</p>
    </div>
    <button class="btn btn-primary" @onclick="ShowCreateDialog">+ 새 구매</button>
</div>

<div class="card" style="margin-bottom:16px;">
    <div class="card-body">
        <div class="filter-bar">
            <select class="form-control form-select" @bind="filterState">
                <option value="">전체 상태</option>
                <option value="PendingDelivery">입고대기</option>
                <option value="PartiallyDelivered">부분입고</option>
                <option value="Delivered">입고완료</option>
                <option value="Cancelled">취소</option>
            </select>
            <input type="text" class="form-control" placeholder="거래처 검색..." @bind="searchText" @bind:event="oninput" />
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body" style="padding:0;">
        @if (isLoading)
        {
            <div class="loading-spinner"><div class="spinner"></div></div>
        }
        else
        {
            <table class="data-table">
                <thead>
                    <tr>
                        <th>상태</th>
                        <th>구매번호</th>
                        <th>거래처</th>
                        <th>구매일</th>
                        <th class="text-right">총금액</th>
                        <th>작업</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in filteredPurchases)
                    {
                        <tr>
                            <td><span class="pill @GetPillClass(p.State)">@GetDisplayName(p.State)</span></td>
                            <td><strong>@p.PurchaseId</strong></td>
                            <td>@GetCompanyName(p.CompanyId)</td>
                            <td>@p.PurchaseDate.ToString("yyyy-MM-dd")</td>
                            <td class="text-right amount">@p.TotalAmount.ToString("N0")원</td>
                            <td>
                                <button class="btn btn-sm btn-secondary" @onclick="() => ViewPurchase(p)">상세</button>
                            </td>
                        </tr>
                    }
                    @if (!filteredPurchases.Any())
                    {
                        <tr><td colspan="6"><div class="empty-state"><div class="empty-state-icon">📥</div><div class="empty-state-text">구매 데이터가 없습니다</div></div></td></tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@if (showDetailModal && selectedPurchase != null)
{
    <div class="modal-backdrop" @onclick="() => showDetailModal = false">
        <div class="modal-dialog" @onclick:stopPropagation="true" style="max-width:720px;">
            <div class="modal-header">
                <h3 class="modal-title">구매 상세 - #@selectedPurchase.PurchaseId</h3>
                <button class="modal-close" @onclick="() => showDetailModal = false">&times;</button>
            </div>
            <div class="modal-body">
                <div class="detail-grid">
                    <span class="detail-label">상태</span>
                    <span class="detail-value"><span class="pill @GetPillClass(selectedPurchase.State)">@GetDisplayName(selectedPurchase.State)</span></span>
                    <span class="detail-label">거래처</span>
                    <span class="detail-value">@GetCompanyName(selectedPurchase.CompanyId)</span>
                    <span class="detail-label">구매일</span>
                    <span class="detail-value">@selectedPurchase.PurchaseDate.ToString("yyyy-MM-dd")</span>
                    <span class="detail-label">총금액</span>
                    <span class="detail-value amount">@selectedPurchase.TotalAmount.ToString("N0")원</span>
                </div>
                @if (purchaseItems.Any())
                {
                    <h4 style="margin:16px 0 8px;font-size:15px;font-weight:600;">구매 품목</h4>
                    <table class="data-table">
                        <thead><tr><th>품목명</th><th class="text-right">발주수량</th><th class="text-right">입고수량</th><th class="text-right">단가</th><th class="text-right">금액</th></tr></thead>
                        <tbody>
                            @foreach (var item in purchaseItems)
                            {
                                <tr>
                                    <td>@item.ProductName</td>
                                    <td class="text-right">@item.OrderedQuantity.ToString("N0")</td>
                                    <td class="text-right">@item.ReceivedQuantity.ToString("N0")</td>
                                    <td class="text-right">@item.UnitPrice.ToString("N0")원</td>
                                    <td class="text-right amount">@item.LineAmount.ToString("N0")원</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="() => showDetailModal = false">닫기</button>
            </div>
        </div>
    </div>
}

@if (showCreateModal)
{
    <div class="modal-backdrop" @onclick="() => showCreateModal = false">
        <div class="modal-dialog" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3 class="modal-title">새 구매 등록</h3>
                <button class="modal-close" @onclick="() => showCreateModal = false">&times;</button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label class="form-label">거래처</label>
                    <select class="form-control form-select" @bind="newPurchase.CompanyId">
                        <option value="">거래처 선택</option>
                        @foreach (var c in companies)
                        {
                            <option value="@c.CompanyId">@c.CompanyName</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">구매일</label>
                    <input type="date" class="form-control" @bind="newPurchase.PurchaseDate" />
                </div>
                <div class="form-group">
                    <label class="form-label">메모</label>
                    <textarea class="form-control" rows="3" @bind="newPurchase.Memo"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="() => showCreateModal = false">취소</button>
                <button class="btn btn-primary" @onclick="CreatePurchase" disabled="@isSaving">저장</button>
            </div>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(alertMessage))
{
    <div class="toast-container">
        <div class="toast @alertClass">@alertMessage</div>
    </div>
}

@code {
    private bool isLoading = true;
    private List<Purchase> purchases = new();
    private List<Company> companies = new();
    private Dictionary<string, string> companyNames = new();
    private string filterState = "";
    private string searchText = "";

    private bool showDetailModal;
    private Purchase? selectedPurchase;
    private List<PurchaseItem> purchaseItems = new();

    private bool showCreateModal;
    private Purchase newPurchase = new() { PurchaseDate = DateTime.Today };

    private bool isSaving;
    private string alertMessage = "";
    private string alertClass = "";

    private IEnumerable<Purchase> filteredPurchases => purchases
        .Where(p => string.IsNullOrEmpty(filterState) || p.State.ToString() == filterState)
        .Where(p => string.IsNullOrEmpty(searchText) ||
            GetCompanyName(p.CompanyId).Contains(searchText, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            using var context = await DbFactory.CreateDbContextAsync();
            companies = await context.Companies.Where(c => c.IsActive).ToListAsync();
            companyNames = companies.ToDictionary(c => c.CompanyId, c => c.CompanyName);
            await LoadPurchases();
        }
        catch (Exception ex)
        {
            ShowAlert($"데이터 로드 실패: {ex.Message}", "alert-error");
        }
    }

    private async Task LoadPurchases()
    {
        try
        {
            isLoading = true;
            using var context = await DbFactory.CreateDbContextAsync();
            purchases = await context.Purchases
                .Where(p => p.OwnerCompanyId == AppState.CurrentCompanyId)
                .OrderByDescending(p => p.PurchaseDate)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            ShowAlert($"구매 목록 로드 실패: {ex.Message}", "alert-error");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ViewPurchase(Purchase p)
    {
        try
        {
            selectedPurchase = p;
            using var context = await DbFactory.CreateDbContextAsync();
            purchaseItems = await context.PurchaseItems.Where(i => i.PurchaseId == p.PurchaseId).ToListAsync();
            showDetailModal = true;
        }
        catch (Exception ex)
        {
            ShowAlert($"구매 상세 로드 실패: {ex.Message}", "alert-error");
        }
    }

    private void ShowCreateDialog()
    {
        newPurchase = new Purchase { PurchaseDate = DateTime.Today };
        showCreateModal = true;
    }

    private async Task CreatePurchase()
    {
        if (string.IsNullOrEmpty(newPurchase.CompanyId))
        {
            ShowAlert("거래처를 선택해주세요.", "alert-warning");
            return;
        }
        isSaving = true;
        try
        {
            using var context = await DbFactory.CreateDbContextAsync();
            newPurchase.OwnerCompanyId = AppState.CurrentCompanyId;
            newPurchase.State = PurchaseState.PendingDelivery;
            newPurchase.CreatedAt = DateTime.UtcNow;
            context.Purchases.Add(newPurchase);
            await context.SaveChangesAsync();
            showCreateModal = false;
            await LoadPurchases();
        }
        catch (Exception ex)
        {
            ShowAlert($"저장 실패: {ex.Message}", "alert-error");
        }
        finally
        {
            isSaving = false;
        }
    }

    private string GetCompanyName(string id) => companyNames.TryGetValue(id, out var n) ? n : id;

    private string GetPillClass(PurchaseState s) => s switch
    {
        PurchaseState.PendingDelivery => "pill-pending",
        PurchaseState.PartiallyDelivered => "pill-sent",
        PurchaseState.Delivered => "pill-delivered",
        PurchaseState.Cancelled => "pill-cancelled",
        _ => "pill-draft"
    };

    private string GetDisplayName(PurchaseState s) => s switch
    {
        PurchaseState.PendingDelivery => "입고대기",
        PurchaseState.PartiallyDelivered => "부분입고",
        PurchaseState.Delivered => "입고완료",
        PurchaseState.Cancelled => "취소",
        _ => s.ToString()
    };

    private void ShowAlert(string message, string cssClass)
    {
        alertMessage = message;
        alertClass = cssClass;
        _ = InvokeAsync(async () =>
        {
            await Task.Delay(3000);
            alertMessage = "";
            StateHasChanged();
        });
    }
}
