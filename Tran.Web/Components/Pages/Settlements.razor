@page "/settlements"
@inject IDbContextFactory<TranDbContext> DbFactory

<PageTitle>정산 관리 - Tran ERP</PageTitle>

<div class="page-header">
    <div>
        <h1 class="page-title">정산 관리</h1>
        <p class="page-description">거래처별 정산 내역을 관리합니다</p>
    </div>
    <button class="btn btn-primary" @onclick="ShowCreateDialog">+ 새 정산</button>
</div>

<div class="card">
    <div class="card-body" style="padding:0;">
        @if (isLoading)
        {
            <div class="loading-spinner"><div class="spinner"></div></div>
        }
        else
        {
            <table class="data-table">
                <thead>
                    <tr>
                        <th>정산ID</th>
                        <th>거래처</th>
                        <th>정산 시작일</th>
                        <th>정산 종료일</th>
                        <th class="text-right">총금액</th>
                        <th>정산일</th>
                        <th>상태</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in settlements)
                    {
                        <tr>
                            <td><strong>@s.SettlementId</strong></td>
                            <td>@GetCompanyName(s.CompanyId)</td>
                            <td>@s.PeriodStart.ToString("yyyy-MM-dd")</td>
                            <td>@s.PeriodEnd.ToString("yyyy-MM-dd")</td>
                            <td class="text-right amount">@s.TotalAmount.ToString("N0")원</td>
                            <td>@(s.SettledAt?.ToString("yyyy-MM-dd") ?? "-")</td>
                            <td><span class="pill @(s.SettledAt.HasValue ? "pill-confirmed" : "pill-pending")">@(s.SettledAt.HasValue ? "정산완료" : "미정산")</span></td>
                        </tr>
                    }
                    @if (!settlements.Any())
                    {
                        <tr><td colspan="7"><div class="empty-state"><div class="empty-state-icon">💰</div><div class="empty-state-text">정산 데이터가 없습니다</div></div></td></tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@if (showCreateModal)
{
    <div class="modal-backdrop" @onclick="() => showCreateModal = false">
        <div class="modal-dialog" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3 class="modal-title">새 정산 등록</h3>
                <button class="modal-close" @onclick="() => showCreateModal = false">&times;</button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label class="form-label">거래처</label>
                    <select class="form-control form-select" @bind="newSettlement.CompanyId">
                        <option value="">거래처 선택</option>
                        @foreach (var c in companies)
                        {
                            <option value="@c.CompanyId">@c.CompanyName</option>
                        }
                    </select>
                </div>
                <div class="grid-2">
                    <div class="form-group">
                        <label class="form-label">시작일</label>
                        <input type="date" class="form-control" @bind="newSettlement.PeriodStart" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">종료일</label>
                        <input type="date" class="form-control" @bind="newSettlement.PeriodEnd" />
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label">총금액</label>
                    <input type="number" class="form-control" @bind="newSettlement.TotalAmount" />
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="() => showCreateModal = false">취소</button>
                <button class="btn btn-primary" @onclick="CreateSettlement">저장</button>
            </div>
        </div>
    </div>
}

@code {
    private bool isLoading = true;
    private List<Settlement> settlements = new();
    private List<Company> companies = new();
    private Dictionary<string, string> companyNames = new();

    private bool showCreateModal;
    private Settlement newSettlement = new();

    protected override async Task OnInitializedAsync()
    {
        using var context = await DbFactory.CreateDbContextAsync();
        companies = await context.Companies.Where(c => c.IsActive).ToListAsync();
        companyNames = companies.ToDictionary(c => c.CompanyId, c => c.CompanyName);
        settlements = await context.Settlements.OrderByDescending(s => s.PeriodEnd).ToListAsync();
        isLoading = false;
    }

    private void ShowCreateDialog()
    {
        newSettlement = new Settlement
        {
            PeriodStart = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1),
            PeriodEnd = DateTime.Today
        };
        showCreateModal = true;
    }

    private async Task CreateSettlement()
    {
        if (string.IsNullOrEmpty(newSettlement.CompanyId)) return;
        using var context = await DbFactory.CreateDbContextAsync();
        newSettlement.SettlementId = $"STL-{DateTime.Now:yyyyMMdd}-{Guid.NewGuid().ToString()[..4].ToUpper()}";
        context.Settlements.Add(newSettlement);
        await context.SaveChangesAsync();
        settlements.Insert(0, newSettlement);
        showCreateModal = false;
    }

    private string GetCompanyName(string id) => companyNames.TryGetValue(id, out var n) ? n : id;
}
